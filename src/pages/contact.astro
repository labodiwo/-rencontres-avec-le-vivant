---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<!doctype html>
<html lang="fr">

  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <link rel="icon" href="/images/logo-rencontres.jpg" type="image/jpeg" />

    <meta
      name="description"
      content="Contactez Rencontres avec le vivant pour obtenir des informations sur les malles pédagogiques, leur fonctionnement, leur utilisation ou leur disponibilité."
    />

    <title>Me contacter · Rencontres avec le vivant</title>
    <link rel="canonical" href="https://labodiwo.com/contact" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rencontres avec le vivant" />
    <meta property="og:title" content="Me contacter · Rencontres avec le vivant" />
    <meta property="og:description" content="Contactez Rencontres avec le vivant pour obtenir des informations sur les malles pédagogiques, leur fonctionnement, leur utilisation ou leur disponibilité." />
    <meta property="og:url" content="https://labodiwo.com/contact" />
    <meta property="og:image" content="https://labodiwo.com/images/hero.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Me contacter · Rencontres avec le vivant" />
    <meta name="twitter:description" content="Contactez Rencontres avec le vivant pour obtenir des informations sur les malles pédagogiques, leur fonctionnement, leur utilisation ou leur disponibilité." />
    <meta name="twitter:image" content="https://labodiwo.com/images/hero.jpg" />
    <script
      src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
      async
      defer
    ></script>
  </head>


  <body>
    <SiteHeader />


    <main>


      <!-- BANDEAU -->
      <section class="contact-hero">

        <div
          class="hero-decoration"
          aria-hidden="true"
        >

          <span class="stem"></span>

          <span class="leaf leaf-one"></span>

          <span class="leaf leaf-two"></span>

          <span class="leaf leaf-three"></span>

        </div>


        <div class="hero-content">

          <p class="eyebrow light">
            Une question sur les malles ?
          </p>

          <h1>
            Parlons des<br />
            malles pédagogiques
          </h1>

          <p>
            Vous souhaitez en savoir plus sur une malle,
            connaître son fonctionnement, sa disponibilité
            ou son utilisation dans votre structure ?
            Vous pouvez me contacter ici.
          </p>

        </div>

      </section>



      <!-- CONTACT -->
      <section class="contact-section">


        <!-- TEXTE -->
        <div class="contact-intro">

          <p class="eyebrow">
            Me contacter
          </p>

          <h2>
            Une question sur une malle ?
          </h2>

          <p>
            Indiquez-moi simplement ce que vous souhaitez savoir :
            la malle qui vous intéresse, votre structure,
            l’âge des enfants concernés ou votre question.
          </p>


          <div class="reply-note">

            <span aria-hidden="true">
              ↗
            </span>

            <p>
              <strong>
                Je vous répondrai dès que possible
              </strong>

              Votre message me permettra de vous répondre
              plus précisément sur les malles et leur utilisation.
            </p>

          </div>

        </div>



        <!-- FORMULAIRE -->
        <div id="contact-success" class="contact-success" hidden>
          <span class="success-icon" aria-hidden="true">✓</span>
          <p class="eyebrow">Message envoyé</p>
          <h2>Votre message a bien été envoyé</h2>
          <p>
            Merci pour votre message. Je vous répondrai prochainement.
          </p>
          <button id="send-another-message" type="button" class="secondary-button">
            Envoyer un autre message
          </button>
        </div>

        <form
          class="contact-form"
          id="contact-form"
        >


          <!-- NOM + EMAIL -->
          <div class="field-row">


            <div class="field">

              <label for="name">
                Votre nom
                <span aria-hidden="true">*</span>
              </label>

              <input
                id="name"
                name="name"
                type="text"
                autocomplete="name"
                required
              />

            </div>


            <div class="field">

              <label for="email">
                Votre adresse e-mail
                <span aria-hidden="true">*</span>
              </label>

              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                required
              />

            </div>

          </div>



          <!-- STRUCTURE -->
          <div class="field">

            <label for="organisation">
              Votre structure

              <span class="optional">
                (facultatif)
              </span>
            </label>

            <input
              id="organisation"
              name="organisation"
              type="text"
              autocomplete="organization"
            />

          </div>



          <!-- ÂGE -->
          <div class="field">

            <label for="age">
              Âge des enfants concernés

              <span class="optional">
                (facultatif)
              </span>
            </label>

            <input
              id="age"
              name="age"
              type="text"
              placeholder="Par exemple : 3–5 ans"
            />

          </div>



          <!-- SUJET -->
          <div class="field">

            <label for="subject">
              Votre demande concerne
            </label>

            <select
              id="subject"
              name="subject"
            >

              <option value="Malle Les oiseaux">
                La malle « Les oiseaux »
              </option>

              <option value="Découvrir les malles">
                Découvrir les malles pédagogiques
              </option>

              <option value="Disponibilité et location">
                La disponibilité ou la location d’une malle
              </option>

              <option value="Fonctionnement">
                Le fonctionnement ou le contenu d’une malle
              </option>

              <option value="Utilisation en structure">
                L’utilisation d’une malle dans ma structure
              </option>

              <option value="Autre">
                Une autre question
              </option>

            </select>

          </div>



          <!-- MESSAGE -->
          <div class="field">

            <label for="message">
              Votre message
              <span aria-hidden="true">*</span>
            </label>

            <textarea
              id="message"
              name="message"
              rows="7"
              placeholder="Votre question, vos besoins ou quelques informations sur votre contexte…"
              required
            ></textarea>

          </div>



          <div class="hp-field" aria-hidden="true">
            <label for="website">Site internet</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="captcha-block">
            <div id="turnstile-container"></div>
            <p class="captcha-help">Vérification anti-robot sécurisée par Cloudflare Turnstile.</p>
          </div>

          <!-- CONSENTEMENT -->
          <label class="consent">

            <input
              type="checkbox"
              name="consent"
              required
            />

            <span>
              J’ai pris connaissance de la
              <a href="/politique-confidentialite" target="_blank" rel="noopener">
                politique de confidentialité
              </a>
              concernant le traitement de ma demande.
            </span>

          </label>



          <!-- ENVOI -->
          <div class="form-bottom">

            <button type="submit">

              Envoyer mon message

              <span aria-hidden="true">
                →
              </span>

            </button>


            <p class="required-note">
              * Champs obligatoires
            </p>

          </div>

          <p id="contact-status" class="contact-status" role="status"></p>

        </form>

      </section>

    </main>




    <script is:inline>
      const contactForm = document.getElementById("contact-form");
      const contactStatus = document.getElementById("contact-status");
      const contactSuccess = document.getElementById("contact-success");
      const sendAnotherMessage = document.getElementById("send-another-message");
      let turnstileToken = "";
      let turnstileWidgetId = null;

      const initTurnstile = async () => {
        try {
          const response = await fetch("/api/turnstile-config");
          const config = await response.json();

          if (!response.ok || !config.ok || !config.siteKey) {
            throw new Error("Captcha non configuré.");
          }

          await new Promise((resolve) => {
            const check = () => {
              if (window.turnstile) resolve();
              else setTimeout(check, 100);
            };
            check();
          });

          turnstileWidgetId = window.turnstile.render(
            "#turnstile-container",
            {
              sitekey: config.siteKey,
              theme: "light",
              callback: (token) => { turnstileToken = token; },
              "expired-callback": () => { turnstileToken = ""; },
              "error-callback": () => { turnstileToken = ""; },
            }
          );
        } catch (error) {
          contactStatus.textContent =
            "La vérification anti-robot n’est pas disponible. Merci de réessayer un peu plus tard.";
        }
      };

      initTurnstile();

      sendAnotherMessage.addEventListener("click", () => {
        contactSuccess.hidden = true;
        contactForm.hidden = false;
        contactStatus.textContent = "";
        contactForm.scrollIntoView({ behavior: "smooth", block: "start" });
      });

      contactForm.addEventListener("submit", async (event) => {
        event.preventDefault();

        if (!turnstileToken) {
          contactStatus.textContent = "Merci de valider la vérification anti-robot.";
          return;
        }

        const submitButton = contactForm.querySelector('button[type="submit"]');
        const formData = new FormData(contactForm);

        const payload = {
          name: formData.get("name"),
          email: formData.get("email"),
          organisation: formData.get("organisation"),
          age: formData.get("age"),
          subject: formData.get("subject"),
          message: formData.get("message"),
          website: formData.get("website"),
          turnstileToken,
        };

        submitButton.disabled = true;
        contactStatus.textContent = "Envoi en cours…";

        try {
          const response = await fetch("/api/contact", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify(payload),
          });

          const result = await response.json();

          if (!response.ok || !result.ok) {
            throw new Error(result.error || "Le message n’a pas pu être envoyé.");
          }

          contactForm.reset();
          contactStatus.textContent = "";
          contactForm.hidden = true;
          contactSuccess.hidden = false;
          turnstileToken = "";

          if (window.turnstile && turnstileWidgetId !== null) {
            window.turnstile.reset(turnstileWidgetId);
          }

          contactSuccess.scrollIntoView({
            behavior: "smooth",
            block: "center",
          });
        } catch (error) {
          contactStatus.textContent =
            error.message || "Le message n’a pas pu être envoyé. Merci de réessayer.";
        } finally {
          submitButton.disabled = false;
        }
      });
    </script>

    <!-- PIED DE PAGE -->
    <SiteFooter />



    <style>


      /* =========================
         BASE
      ========================= */

      :global(*) {
        box-sizing: border-box;
      }


      :global(html) {
        scroll-behavior: smooth;
      }


      :global(body) {
        margin: 0;

        background: #f9f7f2;

        color: #292b23;

        font-family:
          Georgia,
          "Times New Roman",
          serif;
      }



      /* =========================
         HEADER
      ========================= */

      .site-header {
        min-height: 94px;

        padding: 15px 5.5%;

        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 40px;

        background: #f9f7f2;
      }


      .brand {
        display: flex;

        align-items: center;

        color: #29271f;

        text-decoration: none;
      }


      .brand-decoration {
        margin-right: 10px;

        font-size: 2.7rem;

        line-height: 1;

        color: #747b51;

        transform: rotate(-15deg);
      }


      .brand-text {
        display: flex;

        flex-direction: column;

        font-size: 1.55rem;

        line-height: 1.05;
      }


      nav {
        display: flex;

        align-items: center;

        gap: clamp(
          24px,
          3.7vw,
          55px
        );
      }


      nav a {
        color: #161713;

        text-decoration: none;

        font-size: 1rem;

        font-weight: 600;

        white-space: nowrap;
      }


      nav a:hover,
      nav a[aria-current="page"] {
        color: #687347;
      }



      /* =========================
         BANDEAU
      ========================= */

      .contact-hero {
        position: relative;

        min-height: 360px;

        padding: 60px 8%;

        display: flex;

        align-items: center;

        overflow: hidden;

        background: #596243;

        color: #fffdf8;
      }


      .hero-content {
        position: relative;

        z-index: 1;

        max-width: 720px;
      }


      .eyebrow {
        margin: 0 0 10px;

        color: #74785e;

        font-family:
          Arial,
          Helvetica,
          sans-serif;

        font-size: 0.73rem;

        line-height: 1.3;

        letter-spacing: 0.12em;

        text-transform: uppercase;
      }


      .eyebrow.light {
        color: rgba(
          255,
          255,
          255,
          0.72
        );
      }


      h1 {
        margin: 0 0 22px;

        font-size: clamp(
          3.1rem,
          6vw,
          5.5rem
        );

        font-weight: 500;

        line-height: 0.96;
      }


      .hero-content > p:last-child {
        max-width: 590px;

        margin: 0;

        font-size: 1.08rem;

        line-height: 1.65;
      }



      /* =========================
         DÉCOR BANDEAU
      ========================= */

      .hero-decoration {
        position: absolute;

        right: 4%;

        bottom: -70px;

        width: 330px;

        height: 390px;

        opacity: 0.18;

        transform: rotate(8deg);
      }


      .stem {
        position: absolute;

        left: 50%;

        bottom: 0;

        width: 3px;

        height: 360px;

        background: #fff;

        transform: rotate(13deg);

        border-radius: 50%;
      }


      .leaf {
        position: absolute;

        width: 115px;

        height: 62px;

        border: 3px solid #fff;

        border-radius:
          100%
          0
          100%
          0;
      }


      .leaf-one {
        top: 62px;

        left: 69px;

        transform: rotate(22deg);
      }


      .leaf-two {
        top: 145px;

        right: 28px;

        transform:
          scaleX(-1)
          rotate(17deg);
      }


      .leaf-three {
        top: 225px;

        left: 42px;

        transform: rotate(17deg);
      }



      /* =========================
         SECTION CONTACT
      ========================= */

      .contact-section {
        width: min(
          1180px,
          89%
        );

        margin: 0 auto;

        padding: 75px 0 90px;

        display: grid;

        grid-template-columns:
          0.85fr
          1.25fr;

        gap: clamp(
          55px,
          8vw,
          120px
        );

        align-items: start;
      }



      /* =========================
         INTRODUCTION
      ========================= */

      .contact-intro h2 {
        margin: 0 0 22px;

        font-size: clamp(
          2.2rem,
          3.6vw,
          3.3rem
        );

        font-weight: 500;

        line-height: 1.04;
      }


      .contact-intro > p:not(.eyebrow) {
        margin: 0;

        color: #5d5e52;

        line-height: 1.7;
      }



      /* =========================
         PETIT ENCADRÉ
      ========================= */

      .reply-note {
        margin-top: 38px;

        padding-top: 26px;

        display: flex;

        gap: 16px;

        border-top:
          1px
          solid
          #d8d5cc;
      }


      .reply-note > span {
        display: grid;

        flex: 0 0 42px;

        height: 42px;

        place-items: center;

        border-radius: 50%;

        background: #e5e8da;

        color: #596243;

        font-size: 1.35rem;
      }


      .reply-note p {
        margin: 1px 0 0;

        color: #67685d;

        font-family:
          Arial,
          Helvetica,
          sans-serif;

        font-size: 0.9rem;

        line-height: 1.5;
      }


      .reply-note strong {
        display: block;

        margin-bottom: 5px;

        color: #292b23;

        font-family:
          Georgia,
          "Times New Roman",
          serif;

        font-size: 1.05rem;
      }



      /* =========================
         FORMULAIRE
      ========================= */

      .contact-form {
        padding: clamp(
          30px,
          4vw,
          48px
        );

        background: #efede6;

        border-radius: 6px;

        box-shadow:
          0
          16px
          45px
          rgba(
            53,
            58,
            42,
            0.06
          );
      }


      .field-row {
        display: grid;

        grid-template-columns:
          1fr
          1fr;

        gap: 20px;
      }


      .field {
        margin-bottom: 22px;
      }


      label {
        display: block;

        margin-bottom: 8px;

        font-family:
          Arial,
          Helvetica,
          sans-serif;

        font-size: 0.84rem;

        font-weight: 600;

        color: #383a31;
      }


      label span:not(.optional) {
        color: #7d8957;
      }


      .optional {
        color: #85867d;

        font-size: 0.76rem;

        font-weight: 400;
      }



      /* CHAMPS */

      input:not([type="checkbox"]),
      select,
      textarea {
        width: 100%;

        padding: 13px 14px;

        border:
          1px
          solid
          #cac7bd;

        border-radius: 3px;

        background: #fffefa;

        color: #292b23;

        font:
          1rem
          Arial,
          Helvetica,
          sans-serif;

        outline: none;

        transition:
          border-color 0.2s,
          box-shadow 0.2s;
      }


      textarea {
        min-height: 155px;

        resize: vertical;

        line-height: 1.5;
      }


      input::placeholder,
      textarea::placeholder {
        color: #99988f;

        opacity: 1;
      }


      input:focus,
      select:focus,
      textarea:focus {
        border-color: #7d8957;

        box-shadow:
          0
          0
          0
          3px
          rgba(
            125,
            137,
            87,
            0.14
          );
      }



      .contact-success {
        padding: clamp(34px, 5vw, 54px);
        background: #eef0e3;
        border: 1px solid #cfd7b8;
        border-radius: 8px;
        text-align: center;
        box-shadow: 0 16px 45px rgba(53, 58, 42, 0.06);
      }

      .contact-success .success-icon {
        width: 54px;
        height: 54px;
        margin: 0 auto 18px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: #7d8957;
        color: #fff;
        font: 700 1.55rem Arial, Helvetica, sans-serif;
      }

      .contact-success h2 {
        margin: 0 0 14px;
        font-size: clamp(2rem, 3vw, 2.8rem);
        font-weight: 500;
      }

      .contact-success > p:last-of-type {
        margin: 0 auto 24px;
        max-width: 520px;
        color: #5d5e52;
        line-height: 1.65;
      }

      .secondary-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 11px 16px;
        border: 1px solid #7d8957;
        border-radius: 4px;
        background: transparent;
        color: #596243;
        cursor: pointer;
        font: 600 0.9rem Arial, Helvetica, sans-serif;
      }

      .secondary-button:hover {
        background: #e1e6d3;
        transform: none;
      }

      .hp-field {
        position: absolute !important;
        left: -9999px !important;
        width: 1px !important;
        height: 1px !important;
        overflow: hidden !important;
      }

      .captcha-block {
        margin: 0 0 22px;
      }

      .captcha-help {
        margin: 7px 0 0;
        color: #85867d;
        font: 0.72rem/1.45 Arial, Helvetica, sans-serif;
      }

      .contact-status {
        min-height: 22px;
        margin: 16px 0 0;
        color: #596243;
        font: 0.86rem/1.5 Arial, Helvetica, sans-serif;
      }

      /* CONSENTEMENT */

      .consent {
        display: flex;

        align-items: flex-start;

        gap: 10px;

        margin:
          2px
          0
          25px;

        font-size: 0.78rem;

        font-weight: 400;

        line-height: 1.45;
      }


      .consent a {
        color: #596243;
        font-weight: 700;
      }

      .consent input {
        width: 17px;

        height: 17px;

        margin: 1px 0 0;

        flex: 0 0 auto;

        accent-color: #69754a;
      }



      /* BAS DU FORMULAIRE */

      .form-bottom {
        display: flex;

        align-items: center;

        flex-wrap: wrap;

        gap: 14px;
      }


      button {
        display: inline-flex;

        align-items: center;

        gap: 16px;

        padding:
          13px
          19px;

        border: 0;

        border-radius: 4px;

        background: #7d8957;

        color: white;

        cursor: pointer;

        font:
          600
          0.95rem
          Georgia,
          "Times New Roman",
          serif;

        transition:
          background 0.2s,
          transform 0.2s;
      }


      button:hover {
        background: #69754a;

        transform: translateY(-1px);
      }


      button span {
        font-size: 1.4rem;

        line-height: 0.8;
      }


      .required-note {
        margin: 0;

        color: #85867d;

        font:
          0.72rem
          Arial,
          Helvetica,
          sans-serif;
      }



      /* =========================
         FOOTER
      ========================= */

      footer {
        padding: 46px 5.5%;

        background: #303428;

        color: #f5f2e9;

        text-align: center;
      }


      .footer-brand {
        color: inherit;

        text-decoration: none;

        font-size: 1.35rem;
      }


      footer p {
        margin:
          10px
          0
          22px;

        color:
          rgba(
            255,
            255,
            255,
            0.7
          );

        font-size: 0.9rem;
      }


      footer small {
        color:
          rgba(
            255,
            255,
            255,
            0.5
          );

        font:
          0.7rem
          Arial,
          Helvetica,
          sans-serif;
      }



      /* =========================
         TABLETTE
      ========================= */

      @media (max-width: 900px) {

        .site-header {
          flex-direction: column;

          gap: 20px;

          padding-block: 20px;
        }


        nav {
          flex-wrap: wrap;

          justify-content: center;

          row-gap: 12px;
        }


        .contact-section {
          grid-template-columns: 1fr;

          gap: 48px;
        }


        .contact-intro {
          max-width: 650px;
        }

      }



      /* =========================
         MOBILE
      ========================= */

      @media (max-width: 620px) {

        nav {
          gap:
            10px
            20px;
        }


        nav a {
          font-size: 0.88rem;
        }


        .contact-hero {
          min-height: 330px;

          padding:
            50px
            6%;
        }


        .hero-decoration {
          right: -140px;
        }


        .contact-section {
          width: 88%;

          padding:
            55px
            0
            70px;
        }


        .field-row {
          grid-template-columns: 1fr;

          gap: 0;
        }


        .contact-form {
          padding:
            26px
            20px;
        }


        .form-bottom {
          align-items: flex-start;

          flex-direction: column;
        }

      }

    </style>

  </body>

</html>
