---
const nav = [
  { label: "Les malles", href: "/les-malles" },
  { label: "Comment ça fonctionne ?", href: "/#fonctionnement" },
  { label: "Pour qui ?", href: "/#pour-qui" },
  { label: "Le blog", href: "/blog" },
  { label: "Me contacter", href: "/contact" },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta
      name="description"
      content="Contactez Rencontres avec le vivant pour échanger autour des malles pédagogiques, de votre structure ou de votre projet."
    />

    <title>Me contacter · Rencontres avec le vivant</title>
  </head>

  <body>

    <!-- EN-TÊTE -->
    <header class="site-header">

      <a class="brand" href="/" aria-label="Accueil">
        <span class="brand-decoration" aria-hidden="true">⌇</span>

        <span class="brand-text">
          <span>Rencontres</span>
          <span>avec le vivant</span>
        </span>
      </a>

      <nav aria-label="Navigation principale">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={item.href === "/contact" ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

    </header>


    <main>

      <!-- BANDEAU -->
      <section class="contact-hero">

        <div class="hero-decoration" aria-hidden="true">
          <span class="stem"></span>
          <span class="leaf leaf-one"></span>
          <span class="leaf leaf-two"></span>
          <span class="leaf leaf-three"></span>
        </div>

        <div class="hero-content">

          <p class="eyebrow light">
Une question sur les malles ?
          </p>

          <h1>
            Parlons<br />
            des malles pédagogiques
          </h1>

          <p>
Vous souhaitez en savoir plus sur une malle,
  connaître son fonctionnement, sa disponibilité
  ou son utilisation dans votre structure ?
  Vous pouvez me contacter ici.
          </p>

        </div>

      </section>


      <!-- CONTACT -->
      <section class="contact-section">

        <div class="contact-intro">

          <p class="eyebrow">
            Prendre contact
          </p>

          <h2>
            Parlez-moi de votre projet
          </h2>

          <p>
            Quelques lignes suffisent pour commencer.
            Indiquez-moi votre contexte, l’âge des enfants concernés
            et ce que vous imaginez : nous pourrons ensuite
            en discuter ensemble.
          </p>

          <div class="reply-note">

            <span aria-hidden="true">↗</span>

            <p>
              <strong>Une réponse personnalisée</strong>
              Je prendrai le temps de revenir vers vous dès que possible.
            </p>

          </div>

        </div>


        <!-- FORMULAIRE -->
        <form
          class="contact-form"
          name="contact"
          method="POST"
          data-netlify="true"
        >

          <input
            type="hidden"
            name="form-name"
            value="contact"
          />


          <div class="field-row">

            <div class="field">
              <label for="name">
                Votre nom
                <span aria-hidden="true">*</span>
              </label>

              <input
                id="name"
                name="name"
                type="text"
                autocomplete="name"
                required
              />
            </div>


            <div class="field">
              <label for="email">
                Votre adresse e-mail
                <span aria-hidden="true">*</span>
              </label>

              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                required
              />
            </div>

          </div>


          <div class="field">

            <label for="organisation">
              Votre structure
              <span class="optional">(facultatif)</span>
            </label>

            <input
              id="organisation"
              name="organisation"
              type="text"
              autocomplete="organization"
            />

          </div>


          <div class="field">

            <label for="subject">
              Quel est le sujet de votre message ?
            </label>

            <select
              id="subject"
              name="subject"
            >
              <option value="Découvrir les malles">
                Découvrir les malles
              </option>

              <option value="Projet pédagogique">
                Imaginer un projet pédagogique
              </option>

              <option value="Partenariat">
                Proposer un partenariat
              </option>

              <option value="Autre">
                Une autre demande
              </option>
            </select>

          </div>


          <div class="field">

            <label for="message">
              Votre message
              <span aria-hidden="true">*</span>
            </label>

            <textarea
              id="message"
              name="message"
              rows="7"
              required
            ></textarea>

          </div>


          <label class="consent">

            <input
              type="checkbox"
              name="consent"
              required
            />

            <span>
              J’accepte que mes informations soient utilisées
              pour répondre à ma demande.
            </span>

          </label>


          <button type="submit">
            Envoyer mon message
            <span aria-hidden="true">→</span>
          </button>


          <p class="required-note">
            * Champs obligatoires
          </p>

        </form>

      </section>

    </main>


    <footer>

      <a class="footer-brand" href="/">
        Rencontres avec le vivant
      </a>

      <p>
        Des outils pour prendre le temps de rencontrer le vivant.
      </p>

      <small>
        © Rencontres avec le vivant
      </small>

    </footer>


    <style>

      /* BASE */

      :global(*) {
        box-sizing: border-box;
      }

      :global(body) {
        margin: 0;

        background: #f9f7f2;
        color: #292b23;

        font-family: Georgia, "Times New Roman", serif;
      }


      /* HEADER */

      .site-header {
        min-height: 94px;

        padding: 15px 5.5%;

        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 40px;

        background: #f9f7f2;
      }

      .brand {
        display: flex;
        align-items: center;

        color: #29271f;

        text-decoration: none;
      }

      .brand-decoration {
        margin-right: 10px;

        font-size: 2.7rem;
        line-height: 1;

        color: #747b51;

        transform: rotate(-15deg);
      }

      .brand-text {
        display: flex;
        flex-direction: column;

        font-size: 1.55rem;
        line-height: 1.05;
      }

      nav {
        display: flex;
        align-items: center;

        gap: clamp(24px, 3.7vw, 55px);
      }

      nav a {
        color: #161713;

        text-decoration: none;

        font-size: 1rem;
        font-weight: 600;

        white-space: nowrap;
      }

      nav a:hover,
      nav a[aria-current="page"] {
        color: #687347;
      }


      /* BANDEAU */

      .contact-hero {
        position: relative;

        min-height: 395px;

        padding: 70px 8%;

        display: flex;
        align-items: center;

        overflow: hidden;

        background: #596243;
        color: #fffdf8;
      }

      .hero-content {
        position: relative;
        z-index: 1;

        max-width: 720px;
      }

      .eyebrow {
        margin: 0 0 10px;

        color: #74785e;

        font-family: Arial, Helvetica, sans-serif;

        font-size: 0.73rem;
        line-height: 1.3;

        letter-spacing: 0.12em;

        text-transform: uppercase;
      }

      .eyebrow.light {
        color: rgba(255, 255, 255, 0.72);
      }

      h1 {
        margin: 0 0 22px;

        font-size: clamp(3.2rem, 6vw, 5.7rem);
        font-weight: 500;
        line-height: 0.95;
      }

      .hero-content > p:last-child {
        max-width: 590px;

        margin: 0;

        font-size: 1.08rem;
        line-height: 1.65;
      }


      /* DÉCOR DU BANDEAU */

      .hero-decoration {
        position: absolute;

        right: 4%;
        bottom: -70px;

        width: 330px;
        height: 390px;

        opacity: 0.18;

        transform: rotate(8deg);
      }

      .stem {
        position: absolute;

        left: 50%;
        bottom: 0;

        width: 3px;
        height: 360px;

        background: #fff;

        transform: rotate(13deg);

        border-radius: 50%;
      }

      .leaf {
        position: absolute;

        width: 115px;
        height: 62px;

        border: 3px solid #fff;

        border-radius: 100% 0 100% 0;
      }

      .leaf-one {
        top: 62px;
        left: 69px;

        transform: rotate(22deg);
      }

      .leaf-two {
        top: 145px;
        right: 28px;

        transform: scaleX(-1) rotate(17deg);
      }

      .leaf-three {
        top: 225px;
        left: 42px;

        transform: rotate(17deg);
      }


      /* SECTION CONTACT */

      .contact-section {
        width: min(1180px, 89%);

        margin: 0 auto;

        padding: 88px 0 100px;

        display: grid;
        grid-template-columns: 0.85fr 1.25fr;

        gap: clamp(55px, 8vw, 120px);

        align-items: start;
      }


      /* TEXTE */

      .contact-intro h2 {
        margin: 0 0 22px;

        font-size: clamp(2.25rem, 3.6vw, 3.4rem);
        font-weight: 500;
        line-height: 1.04;
      }

      .contact-intro > p:not(.eyebrow) {
        margin: 0;

        color: #5d5e52;

        line-height: 1.7;
      }

      .reply-note {
        margin-top: 38px;

        padding-top: 26px;

        display: flex;

        gap: 16px;

        border-top: 1px solid #d8d5cc;
      }

      .reply-note > span {
        display: grid;

        flex: 0 0 42px;

        height: 42px;

        place-items: center;

        border-radius: 50%;

        background: #e5e8da;
        color: #596243;

        font-size: 1.35rem;
      }

      .reply-note p {
        margin: 1px 0 0;

        color: #67685d;

        font-family: Arial, Helvetica, sans-serif;

        font-size: 0.9rem;
        line-height: 1.5;
      }

      .reply-note strong {
        display: block;

        margin-bottom: 3px;

        color: #292b23;

        font-family: Georgia, "Times New Roman", serif;

        font-size: 1.05rem;
      }


      /* FORMULAIRE */

      .contact-form {
        padding: clamp(30px, 4vw, 48px);

        background: #efede6;

        border-radius: 5px;

        box-shadow: 0 16px 45px rgba(53, 58, 42, 0.06);
      }

      .field-row {
        display: grid;

        grid-template-columns: 1fr 1fr;

        gap: 20px;
      }

      .field {
        margin-bottom: 22px;
      }

      label {
        display: block;

        margin-bottom: 8px;

        font-family: Arial, Helvetica, sans-serif;

        font-size: 0.84rem;
        font-weight: 600;

        color: #383a31;
      }

      label span:not(.optional) {
        color: #7d8957;
      }

      .optional {
        color: #85867d;

        font-size: 0.76rem;
        font-weight: 400;
      }

      input:not([type="checkbox"]),
      select,
      textarea {
        width: 100%;

        padding: 13px 14px;

        border: 1px solid #cac7bd;
        border-radius: 3px;

        background: #fffefa;
        color: #292b23;

        font: 1rem Arial, Helvetica, sans-serif;

        outline: none;

        transition:
          border-color 0.2s,
          box-shadow 0.2s;
      }

      textarea {
        min-height: 150px;

        resize: vertical;
      }

      input:focus,
      select:focus,
      textarea:focus {
        border-color: #7d8957;

        box-shadow:
          0 0 0 3px rgba(125, 137, 87, 0.14);
      }

      .consent {
        display: flex;
        align-items: flex-start;

        gap: 10px;

        margin: 2px 0 25px;

        font-size: 0.78rem;
        font-weight: 400;
        line-height: 1.45;
      }

      .consent input {
        width: 17px;
        height: 17px;

        margin: 1px 0 0;

        accent-color: #69754a;
      }

      button {
        display: inline-flex;
        align-items: center;

        gap: 16px;

        padding: 13px 19px;

        border: 0;
        border-radius: 4px;

        background: #7d8957;
        color: white;

        cursor: pointer;

        font: 600 0.95rem Georgia, "Times New Roman", serif;
      }

      button:hover {
        background: #69754a;

        transform: translateY(-1px);
      }

      button span {
        font-size: 1.4rem;
        line-height: 0.8;
      }

      .required-note {
        display: inline-block;

        margin: 0 0 0 14px;

        color: #85867d;

        font: 0.72rem Arial, Helvetica, sans-serif;
      }


      /* FOOTER */

      footer {
        padding: 46px 5.5%;

        background: #303428;
        color: #f5f2e9;

        text-align: center;
      }

      .footer-brand {
        color: inherit;

        text-decoration: none;

        font-size: 1.35rem;
      }

      footer p {
        margin: 10px 0 22px;

        color: rgba(255, 255, 255, 0.7);

        font-size: 0.9rem;
      }

      footer small {
        color: rgba(255, 255, 255, 0.5);

        font: 0.7rem Arial, Helvetica, sans-serif;
      }


      /* TABLETTE */

      @media (max-width: 900px) {

        .site-header {
          flex-direction: column;

          gap: 20px;

          padding-block: 20px;
        }

        nav {
          flex-wrap: wrap;

          justify-content: center;

          row-gap: 12px;
        }

        .contact-section {
          grid-template-columns: 1fr;

          gap: 48px;
        }

        .contact-intro {
          max-width: 650px;
        }

      }


      /* MOBILE */

      @media (max-width: 620px) {

        nav {
          gap: 10px 20px;
        }

        nav a {
          font-size: 0.88rem;
        }

        .contact-hero {
          min-height: 360px;

          padding: 58px 6%;
        }

        .hero-decoration {
          right: -140px;
        }

        .contact-section {
          width: 88%;

          padding: 60px 0 70px;
        }

        .field-row {
          grid-template-columns: 1fr;

          gap: 0;
        }

        .contact-form {
          padding: 26px 20px;
        }

        .required-note {
          display: block;

          margin: 12px 0 0;
        }

      }

    </style>

  </body>
</html>
