---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/images/logo-rencontres.jpg" type="image/jpeg" />

    <meta
      name="description"
      content="Rencontres avec le vivant — des malles pédagogiques pour observer, écouter, expérimenter et s’émerveiller."
    />

    <title>Malles pédagogiques nature · Rencontres avec le vivant</title>
    <link rel="canonical" href="https://labodiwo.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rencontres avec le vivant" />
    <meta property="og:title" content="Rencontres avec le vivant" />
    <meta property="og:description" content="Rencontres avec le vivant — des malles pédagogiques pour observer, écouter, expérimenter et s’émerveiller." />
    <meta property="og:url" content="https://labodiwo.com/" />
    <meta property="og:image" content="https://labodiwo.com/images/hero.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Rencontres avec le vivant" />
    <meta name="twitter:description" content="Rencontres avec le vivant — des malles pédagogiques pour observer, écouter, expérimenter et s’émerveiller." />
    <meta name="twitter:image" content="https://labodiwo.com/images/hero.jpg" />
  </head>

  <body>
    <SiteHeader />


    <main>

      <!-- GRANDE IMAGE D'ACCUEIL -->
      <section class="hero">

        <img
          class="hero-image"
          src="/images/hero.jpg"
          alt="Enfant observant la nature en forêt"
        />

        <div class="hero-overlay"></div>

        <div class="hero-content">

          <h1>
            Des outils<br />
            pour prendre le temps<br />
            de <span class="hero-highlight">rencontrer le vivant</span>
          </h1>

          <p>
            Des malles pédagogiques pensées pour éveiller la curiosité,
            l’attention et l’émerveillement des enfants.
          </p>

          <a class="button" href="#fonctionnement">
            En savoir plus
            <span aria-hidden="true">→</span>
          </a>

        </div>

      </section>

      <div class="hero-credit">
        <span>Photo : Bulat Khamitov</span>
      </div>


      <!-- COMMENT ÇA FONCTIONNE -->
      <section class="approach" id="fonctionnement">

        <div class="section-heading">

          <h2>
            Observer <span>–</span>
            Écouter <span>–</span>
            S’émerveiller
          </h2>

          <p>
            Des malles pédagogiques qui invitent les enfants à vivre des
            expériences sensibles et ludiques pour découvrir le vivant par
            l’observation, la manipulation, l’écoute et le jeu.
          </p>

        </div>


        <div class="steps">

          <article class="step">

            <img
              src="/images/je-decouvre.png"
              alt=""
              class="step-icon"
            />

            <h3>Je découvre</h3>

            <p>
              Des histoires, des images et des éléments pour s’émerveiller.
            </p>

          </article>


          <article class="step">

            <img
              src="/images/j-experimente.png"
              alt=""
              class="step-icon"
            />

            <h3>J’expérimente</h3>

            <p>
              Manipuler, jouer, écouter, comparer, toucher, créer…
            </p>

          </article>


          <article class="step">

            <img
              src="/images/je-poursuis-dehors.png"
              alt=""
              class="step-icon"
            />

            <h3>Je poursuis dehors</h3>

            <p>
              Prolonger l’expérience dans la nature, au fil des saisons.
            </p>

          </article>

        </div>

      </section>


      <!-- MALLE OISEAUX -->
      <section class="malle" id="malles">

        <div class="malle-image">

          <img
            src="/images/P1110650.JPG"
            alt="Oiseau du mini-monde de la malle pédagogique Les oiseaux"
          />

        </div>


        <div class="malle-content">

          <p class="eyebrow">
            Rencontres avec le vivant · Malle 01
          </p>

          <h2>Les oiseaux</h2>

          <p class="lead">
            Une malle pour partir à la rencontre du monde des oiseaux
            avec les enfants de 3 à 5 ans.
          </p>

          <p>
            À l’intérieur, des histoires, un mini-monde à manipuler,
            des expériences autour des chants, des œufs, des traces
            et du mouvement… puis des invitations à poursuivre
            les découvertes dehors.
          </p>

          <p class="details">
            Matériel inclus · Fiches d’animation · Utilisable en intérieur et dehors
          </p>

          <a class="button" href="/malle-les-oiseaux">
            Découvrir la malle
            <span aria-hidden="true">→</span>
          </a>

        </div>

      </section>


      <!-- POUR QUI -->
      <section class="audience" id="pour-qui">

        <div class="audience-inner">

          <p class="eyebrow">
            Des outils pensés pour être utilisés facilement
          </p>

          <h2>Pour qui ?</h2>

          <p>
            Les malles s’adressent aux structures qui accompagnent
            les jeunes enfants : accueils de loisirs, maisons de quartier,
            médiathèques, écoles et autres lieux éducatifs.
          </p>

        </div>

      </section>

    </main>


    <SiteFooter />


    <style>

      /* ------------------------------
         BASE
      ------------------------------ */

      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        scroll-behavior: smooth;
      }

      :global(body) {
        margin: 0;
        background: #f9f7f6;
        color: #25271f;
        font-family: Georgia, "Times New Roman", serif;
      }

      :global(img) {
        max-width: 100%;
      }


      /* ------------------------------
         HEADER
      ------------------------------ */

      .site-header {
        min-height: 94px;
        padding: 15px 5.5%;

        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 40px;

        background: #f9f7f6;
      }


      .brand {
        display: flex;
        align-items: center;

        color: #29271f;
        text-decoration: none;
      }


      .brand-logo {
        width: 66px;
        height: 66px;
        flex: 0 0 auto;
        margin-right: 11px;
        overflow: visible;
      }

      .brand-circle {
        fill: none;
        stroke: #5a4a3f;
        stroke-width: 3.2;
        stroke-linecap: round;
      }

      .brand-dot {
        fill: #d69b3e;
      }

      .brand-leaf-large {
        fill: #7a8f6b;
      }

      .brand-leaf {
        fill: #657954;
      }

      .brand-stem {
        fill: none;
        stroke: #4f5f42;
        stroke-width: 2.4;
        stroke-linecap: round;
      }

      .brand-vein {
        fill: none;
        stroke: rgba(249, 247, 246, 0.72);
        stroke-width: 1.6;
        stroke-linecap: round;
      }


      .brand-text {
        display: flex;
        flex-direction: column;

        color: #5a4a3f;
        font-size: 1.55rem;
        line-height: 1.05;
      }

      .brand-text span:last-child {
        margin-top: 4px;
        color: #657954;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 0.72rem;
        letter-spacing: 0.16em;
      }


      nav {
        display: flex;
        align-items: center;

        gap: clamp(24px, 3.7vw, 55px);
      }


      nav a {
        color: #161713;
        text-decoration: none;

        font-size: 1rem;
        font-weight: 600;

        white-space: nowrap;

        transition: opacity 0.2s ease;
      }


      nav a:hover {
        opacity: 0.55;
      }


      /* ------------------------------
         HERO
      ------------------------------ */

      .hero {
        position: relative;

        min-height: 380px;

        display: flex;
        align-items: center;

        overflow: hidden;
      }


      .hero-image {
        position: absolute;
        inset: 0;

        width: 100%;
        height: 100%;

        object-fit: cover;
        object-position: center 75%;
      }


      .hero-overlay {
        position: absolute;
        inset: 0;

        background:
          linear-gradient(
            90deg,
            rgba(16, 21, 13, 0.80) 0%,
            rgba(16, 21, 13, 0.60) 30%,
            rgba(16, 21, 13, 0.18) 62%,
            rgba(16, 21, 13, 0.03) 100%
          );
      }


      .hero-content {
        position: relative;
        z-index: 2;

        width: min(520px, 87%);

        margin-left: 5.5%;

        padding: 40px 0;

        color: #fffdf8;
      }


      .hero h1 {
        margin: 0 0 20px;

        font-size: clamp(2.2rem, 3.7vw, 3.8rem);

        line-height: 1.02;

        font-weight: 500;
      }


      .hero p {
        max-width: 400px;

        margin: 0 0 26px;

        font-size: 1.05rem;
        line-height: 1.45;
      }


      .hero-credit {
        padding: 9px 5.5% 8px;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        background: #f9f7f6;
        color: #85867d;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 0.72rem;
      }

      .hero-highlight {
        color: #aebd7f;
      }


      /* ------------------------------
         BOUTONS
      ------------------------------ */

      .button {
        display: inline-flex;
        align-items: center;

        gap: 14px;

        padding: 11px 17px;

        background: #7d8957;
        color: white;

        border-radius: 4px;

        text-decoration: none;

        font-weight: 600;

        transition:
          transform 0.15s ease,
          background 0.15s ease;
      }


      .button:hover {
        background: #6f7b4d;

        transform: translateY(-1px);
      }


      .button span {
        font-size: 1.45rem;
        line-height: 1;
      }


      /* ------------------------------
         DÉMARCHE
      ------------------------------ */

      .approach {
        padding: 32px 5.5% 42px;

        background: #f9f7f6;

        text-align: center;
      }


      .section-heading {
        max-width: 820px;

        margin: 0 auto 30px;
      }


      .section-heading h2 {
        margin: 0 0 10px;

        font-size: clamp(1.8rem, 2.8vw, 2.75rem);

        font-weight: 500;
      }


      .section-heading h2 span {
        color: #73785b;
      }


      .section-heading p {
        margin: 0;

        color: #686654;

        line-height: 1.5;

        font-size: 1rem;
      }


      .steps {
        max-width: 900px;

        margin: 0 auto;

        display: grid;
        grid-template-columns: repeat(3, 1fr);

        gap: 55px;
      }


      .step {
        text-align: center;
      }


      .step-icon {
        display: block;

        width: 112px;
        height: 112px;

        margin: 0 auto 13px;

        object-fit: contain;
      }


      .step h3 {
        margin: 0 0 12px;

        font-size: 1.18rem;

        font-weight: 600;
      }


      .step p {
        max-width: 250px;

        margin: 0 auto;

        font-family: Arial, Helvetica, sans-serif;

        font-size: 0.86rem;

        line-height: 1.5;

        color: #33342d;
      }


      /* ------------------------------
         MALLE OISEAUX
      ------------------------------ */

      .malle {
        display: grid;

        grid-template-columns:
          minmax(0, 1fr)
          minmax(0, 1.1fr);

        min-height: 365px;

        background: #f1eee8;
      }


      .malle-image {
        width: min(100%, 360px);
        aspect-ratio: 1 / 1;
        align-self: center;
        justify-self: center;
        overflow: hidden;
      }


      .malle-image img {
        display: block;

        width: 100%;
        height: 100%;

        height: 100%;

        object-fit: cover;
        object-position: center;
      }


      .malle-content {
        align-self: center;

        padding:
          40px
          clamp(34px, 6vw, 78px);
      }


      .eyebrow {
        margin: 0 0 8px;

        font-family: Arial, Helvetica, sans-serif;

        font-size: 0.73rem;

        line-height: 1.3;

        letter-spacing: 0.09em;

        text-transform: uppercase;

        color: #74785e;
      }


      .malle h2 {
        margin: 0 0 18px;

        font-size: clamp(2rem, 3.3vw, 3rem);

        font-weight: 500;
      }


      .malle p {
        max-width: 620px;

        line-height: 1.45;
      }


      .malle .lead {
        font-size: 1.12rem;
      }


      .details {
        margin: 20px 0;

        font-size: 0.88rem;

        font-weight: 600;
      }


      /* ------------------------------
         POUR QUI
      ------------------------------ */

      .audience {
        padding: 80px 24px;

        background: #f9f7f6;

        text-align: center;
      }


      .audience-inner {
        max-width: 700px;

        margin: 0 auto;
      }


      .audience h2 {
        margin: 8px 0 18px;

        font-size: clamp(2rem, 3vw, 2.8rem);

        font-weight: 500;
      }


      .audience p {
        line-height: 1.6;
      }


      /* ------------------------------
         FOOTER
      ------------------------------ */

      footer {
        padding: 30px 5.5%;

        background: #ece9e1;

        text-align: center;

        font-family: Arial, Helvetica, sans-serif;

        font-size: 0.78rem;

        color: #656559;
      }


      /* ------------------------------
         TABLETTE
      ------------------------------ */

      @media (max-width: 900px) {

        .site-header {
          align-items: flex-start;

          flex-direction: column;

          gap: 14px;
        }


        nav {
          width: 100%;

          overflow-x: auto;

          gap: 24px;

          padding-bottom: 5px;
        }


        nav a {
          font-size: 0.93rem;
        }


        .hero {
          min-height: 420px;
        }


        .hero-content {
          padding: 45px 0;
        }


        .steps {
          gap: 25px;
        }

      }


      /* ------------------------------
         MOBILE
      ------------------------------ */

      @media (max-width: 700px) {

        .site-header {
          padding: 16px 22px;
        }


        .brand-text {
          font-size: 1.25rem;
        }


        .brand-logo {
          width: 56px;
          height: 56px;
          margin-right: 9px;
        }


        .hero {
          min-height: 460px;
        }


        .hero-image {
          object-position: center 60%;
        }


        .hero-overlay {
          background:
            linear-gradient(
              90deg,
              rgba(15, 21, 13, 0.68),
              rgba(15, 21, 13, 0.38)
            );
        }


        .hero-content {
          width: auto;

          margin: 0;

          padding: 45px 24px;
        }


        .hero h1 {
          font-size: clamp(2rem, 9vw, 3rem);

          margin-bottom: 18px;
        }


        .hero p {
          margin-bottom: 24px;
        }

        .hero-credit {
          padding: 9px 22px 8px;
          justify-content: flex-start;
          flex-wrap: wrap;
        }


        .steps {
          grid-template-columns: 1fr;

          max-width: 420px;

          gap: 42px;
        }


        .step-icon {
          width: 105px;
          height: 105px;
        }


        .malle {
          grid-template-columns: 1fr;
        }


        .malle-image {
          min-height: 300px;
        }


        .malle-image img {
          min-height: 300px;

          max-height: 430px;
        }


        .malle-content {
          padding: 38px 24px 45px;
        }

      }

    </style>

  </body>
</html>
