<style>

  /* ------------------------------
     BASE
  ------------------------------ */

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f9f7f6;
    color: #25271f;
    font-family: Georgia, "Times New Roman", serif;
  }

  :global(img) {
    max-width: 100%;
  }


  /* ------------------------------
     HEADER
  ------------------------------ */

  .site-header {
    min-height: 94px;
    padding: 15px 5.5%;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 40px;

    background: #f9f7f6;
  }


  .brand {
    display: flex;
    align-items: center;

    color: #29271f;
    text-decoration: none;
  }


  .brand-decoration {
    margin-right: 10px;

    font-size: 2.7rem;
    line-height: 1;

    color: #747b51;

    transform: rotate(-15deg);
  }


  .brand-text {
    display: flex;
    flex-direction: column;

    font-size: 1.55rem;
    line-height: 1.05;
  }


  nav {
    display: flex;
    align-items: center;

    gap: clamp(24px, 3.7vw, 55px);
  }


  nav a {
    color: #161713;
    text-decoration: none;

    font-size: 1rem;
    font-weight: 600;

    white-space: nowrap;

    transition: opacity 0.2s ease;
  }


  nav a:hover {
    opacity: 0.55;
  }


  /* ------------------------------
     HERO
  ------------------------------ */

  .hero {
    position: relative;

    min-height: 380px;

    display: flex;
    align-items: center;

    overflow: hidden;
  }


  .hero-image {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center 60%;
  }


  .hero-overlay {
    position: absolute;
    inset: 0;

    background:
      linear-gradient(
        90deg,
        rgba(16, 21, 13, 0.80) 0%,
        rgba(16, 21, 13, 0.60) 30%,
        rgba(16, 21, 13, 0.18) 62%,
        rgba(16, 21, 13, 0.03) 100%
      );
  }


  .hero-content {
    position: relative;
    z-index: 2;

    width: min(520px, 87%);

    margin-left: 5.5%;

    padding: 40px 0;

    color: #fffdf8;
  }


  .hero h1 {
    margin: 0 0 20px;

    font-size: clamp(2.2rem, 3.7vw, 3.8rem);

    line-height: 1.02;

    font-weight: 500;
  }


  .hero p {
    max-width: 400px;

    margin: 0 0 26px;

    font-size: 1.05rem;
    line-height: 1.45;
  }


  /* ------------------------------
     BOUTONS
  ------------------------------ */

  .button {
    display: inline-flex;
    align-items: center;

    gap: 14px;

    padding: 11px 17px;

    background: #7d8957;
    color: white;

    border-radius: 4px;

    text-decoration: none;

    font-weight: 600;

    transition:
      transform 0.15s ease,
      background 0.15s ease;
  }


  .button:hover {
    background: #6f7b4d;

    transform: translateY(-1px);
  }


  .button span {
    font-size: 1.45rem;
    line-height: 1;
  }


  /* ------------------------------
     DÉMARCHE
  ------------------------------ */

  .approach {
    padding: 32px 5.5% 42px;

    background: #f9f7f6;

    text-align: center;
  }


  .section-heading {
    max-width: 820px;

    margin: 0 auto 30px;
  }


  .section-heading h2 {
    margin: 0 0 10px;

    font-size: clamp(1.8rem, 2.8vw, 2.75rem);

    font-weight: 500;
  }


  .section-heading h2 span {
    color: #73785b;
  }


  .section-heading p {
    margin: 0;

    color: #686654;

    line-height: 1.5;

    font-size: 1rem;
  }


  .steps {
    max-width: 900px;

    margin: 0 auto;

    display: grid;
    grid-template-columns: repeat(3, 1fr);

    gap: 55px;
  }


  .step {
    text-align: center;
  }


  .step-icon {
    display: block;

    width: 112px;
    height: 112px;

    margin: 0 auto 13px;

    object-fit: contain;
  }


  .step h3 {
    margin: 0 0 12px;

    font-size: 1.18rem;

    font-weight: 600;
  }


  .step p {
    max-width: 250px;

    margin: 0 auto;

    font-family: Arial, Helvetica, sans-serif;

    font-size: 0.86rem;

    line-height: 1.5;

    color: #33342d;
  }


  /* ------------------------------
     MALLE OISEAUX
  ------------------------------ */

  .malle {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, 1.1fr);

    min-height: 365px;

    background: #f1eee8;
  }


  .malle-image {
    min-height: 365px;
  }


  .malle-image img {
    display: block;

    width: 100%;
    height: 100%;

    min-height: 365px;

    object-fit: cover;
    object-position: center;
  }


  .malle-content {
    align-self: center;

    padding:
      40px
      clamp(34px, 6vw, 78px);
  }


  .eyebrow {
    margin: 0 0 8px;

    font-family: Arial, Helvetica, sans-serif;

    font-size: 0.73rem;

    line-height: 1.3;

    letter-spacing: 0.09em;

    text-transform: uppercase;

    color: #74785e;
  }


  .malle h2 {
    margin: 0 0 18px;

    font-size: clamp(2rem, 3.3vw, 3rem);

    font-weight: 500;
  }


  .malle p {
    max-width: 620px;

    line-height: 1.45;
  }


  .malle .lead {
    font-size: 1.12rem;
  }


  .details {
    margin: 20px 0;

    font-size: 0.88rem;

    font-weight: 600;
  }


  /* ------------------------------
     POUR QUI
  ------------------------------ */

  .audience {
    padding: 80px 24px;

    background: #f9f7f6;

    text-align: center;
  }


  .audience-inner {
    max-width: 700px;

    margin: 0 auto;
  }


  .audience h2 {
    margin: 8px 0 18px;

    font-size: clamp(2rem, 3vw, 2.8rem);

    font-weight: 500;
  }


  .audience p {
    line-height: 1.6;
  }


  /* ------------------------------
     FOOTER
  ------------------------------ */

  footer {
    padding: 30px 5.5%;

    background: #ece9e1;

    text-align: center;

    font-family: Arial, Helvetica, sans-serif;

    font-size: 0.78rem;

    color: #656559;
  }


  /* ------------------------------
     TABLETTE
  ------------------------------ */

  @media (max-width: 900px) {

    .site-header {
      align-items: flex-start;

      flex-direction: column;

      gap: 14px;
    }


    nav {
      width: 100%;

      overflow-x: auto;

      gap: 24px;

      padding-bottom: 5px;
    }


    nav a {
      font-size: 0.93rem;
    }


    .hero {
      min-height: 420px;
    }


    .hero-content {
      padding: 45px 0;
    }


    .steps {
      gap: 25px;
    }

  }


  /* ------------------------------
     MOBILE
  ------------------------------ */

  @media (max-width: 700px) {

    .site-header {
      padding: 16px 22px;
    }


    .brand-text {
      font-size: 1.25rem;
    }


    .brand-decoration {
      font-size: 2.2rem;
    }


    .hero {
      min-height: 460px;
    }


    .hero-image {
      object-position: center 60%;
    }


    .hero-overlay {
      background:
        linear-gradient(
          90deg,
          rgba(15, 21, 13, 0.68),
          rgba(15, 21, 13, 0.38)
        );
    }


    .hero-content {
      width: auto;

      margin: 0;

      padding: 45px 24px;
    }


    .hero h1 {
      font-size: clamp(2rem, 9vw, 3rem);

      margin-bottom: 18px;
    }


    .hero p {
      margin-bottom: 24px;
    }


    .steps {
      grid-template-columns: 1fr;

      max-width: 420px;

      gap: 42px;
    }


    .step-icon {
      width: 105px;
      height: 105px;
    }


    .malle {
      grid-template-columns: 1fr;
    }


    .malle-image {
      min-height: 300px;
    }


    .malle-image img {
      min-height: 300px;

      max-height: 430px;
    }


    .malle-content {
      padding: 38px 24px 45px;
    }

  }

</style>
