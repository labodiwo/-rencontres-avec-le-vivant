---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

const propositions = [
  { titre: "Dans le monde des oiseaux", theme: "Mini-monde · Jeu libre", description: "Entrer dans l’univers des oiseaux par le jeu et l’imaginaire : manipuler, aménager les refuges et inventer des histoires.", preparation: "Prévoir quelques éléments naturels et choisir une entrée : album ou histoire de la naissance du mini-monde.", temps: "Je découvre · J’explore · Je poursuis dehors" },
  { titre: "À l’écoute des oiseaux… et du monde qui nous entoure", theme: "Écoute · Sons · Espace", description: "Prendre le temps d’écouter, repérer la direction d’un son et découvrir quelques chants et cris d’oiseaux.", preparation: "Charger les deux enceintes, prévoir un téléphone ou ordinateur et tester les sons à l’avance.", temps: "Je découvre · J’explore · Je poursuis dehors" },
  { titre: "Les oiseaux sont passés par ici…", theme: "Indices · Traces · Matières", description: "Observer les indices laissés par les oiseaux, puis explorer les traces dans l’argile ou avec de la peinture de terre.", preparation: "Préparer la boîte de photographies, un espace protégé pour l’argile et le matériel de peinture.", temps: "Je découvre · J’explore · Je poursuis dehors" },
  { titre: "Comme des oiseaux", theme: "Mouvement · Conte · Création", description: "Observer différentes façons de se déplacer, les expérimenter avec son corps et prolonger le mouvement sur le papier.", preparation: "Prévoir le conte moteur, les cartes de déplacement, du papier grand format et de la peinture.", temps: "Je découvre · J’explore · Je poursuis dehors" },
  { titre: "Balade avec les oiseaux", theme: "Dehors · Observation · Attention", description: "Marcher sans destination imposée : écouter, suivre un oiseau du regard, chercher des indices et garder une trace de la balade.", preparation: "Choisir un parcours court, prévoir des vêtements adaptés, un peu d’eau et éventuellement un support pour créer.", temps: "Une balade à composer librement" }
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Aperçu de l’espace pédagogique de la malle Les oiseaux." />
    <title>Espace pédagogique · Les oiseaux · Rencontres avec le vivant</title>
  </head>
  <body>
    <SiteHeader />
    <main>
      <section class="hero">
        <div class="hero-inner">
          <p class="eyebrow">Rencontres avec le vivant · Malle 01</p>
          <h1>Préparer vos rencontres avec les oiseaux</h1>
          <p>Regarder, écouter, s’émerveiller. Retrouvez les repères pour découvrir la malle, choisir vos animations et préparer vos rencontres avec les oiseaux avant son arrivée.</p>
          <span class="status">Aperçu de l’espace pédagogique · Accès privé à venir</span>
        </div>
      </section>

      <div class="page">
        <section class="welcome" aria-labelledby="welcome-title">
          <div>
            <p class="eyebrow">Bienvenue</p>
            <h2 id="welcome-title">Une malle, plusieurs façons de l’utiliser</h2>
            <p>Vous pouvez laisser les enfants jouer librement avec le mini-monde, choisir une animation, construire un cycle de cinq séances ou composer votre propre proposition. Les durées indiquées dans le livret sont des repères, pas des obligations.</p>
            <p>La malle a été pensée pour un groupe d’environ huit enfants de 3 à 5 ans. Adaptez son utilisation à votre groupe, à l’espace et au nombre d’adultes présents. Prenez le temps : les questions des enfants sont souvent le meilleur point de départ.</p>
          </div>
          <img src="/images/mini-monde-oiseaux.png" alt="Mini-monde pédagogique consacré aux oiseaux" loading="lazy" />
        </section>

        <section class="prepare" aria-labelledby="prepare-title">
          <p class="eyebrow">Avant de recevoir la malle</p>
          <h2 id="prepare-title">Avant l’arrivée de la malle</h2>
          <div class="steps">
            <article><span>01</span><h3>Découvrir</h3><p>Découvrir le contenu de la malle, le mini-monde et les cinq animations.</p></article>
            <article><span>02</span><h3>Choisir</h3><p>Choisir entre jeu libre, animation ponctuelle, cycle ou balade.</p></article>
            <article><span>03</span><h3>Préparer</h3><p>Prévoir les éléments non fournis et tester le matériel sonore si nécessaire.</p></article>
          </div>
        </section>

        <section class="activities" aria-labelledby="activities-title">
          <p class="eyebrow">À explorer à votre rythme</p>
          <h2 id="activities-title">Les propositions de la malle</h2>
          <p class="section-intro">Choisissez une animation pour découvrir le fonctionnement du lecteur. Les pages originales du livret seront ajoutées après la mise en place d’un accès privé sécurisé.</p>
          <div class="cards">
            {propositions.map((p, i) => (
              <article class="activity">
                <span class="number">{String(i + 1).padStart(2, "0")}</span>
                <p class="theme">{p.theme}</p>
                <h3>{p.titre}</h3>
                <p>{p.description}</p><p class="prep"><strong>À prévoir :</strong> {p.preparation}</p><p class="sequence">{p.temps}</p>
                <button class="open-reader" type="button" data-fiche={i} aria-label={`Voir l’aperçu du lecteur pour ${p.titre}`}>Voir dans le lecteur →</button>
              </article>
            ))}
          </div>
        </section>

        <section class="reader-section" id="lecteur" aria-labelledby="reader-title">
          <p class="eyebrow">Démonstration du lecteur</p>
          <h2 id="reader-title">Consulter les fiches</h2>
          <p class="section-intro">Ce lecteur est fonctionnel pour la navigation et le zoom. Les pages originales du livret ne sont pas encore publiées : elles seront affichées ici uniquement après la sécurisation de l’espace réservé aux locataires.</p>
          <div class="reader-shell" oncontextmenu="return false">
            <div class="reader-toolbar">
              <button type="button" id="prev-fiche" aria-label="Animation précédente">← Précédente</button>
              <span id="reader-count" aria-live="polite">Animation 1 / 5</span>
              <button type="button" id="next-fiche" aria-label="Animation suivante">Suivante →</button>
            </div>
            <div class="reader-canvas" id="reader-canvas">
              <div class="reader-paper" id="reader-paper">
                <div class="reader-paper-header">RENCONTRES AVEC LE VIVANT · LES OISEAUX</div>
                <div class="reader-paper-inner">
                  <p class="reader-kicker" id="reader-kicker">ANIMATION 01</p>
                  <h3 id="reader-fiche-title">Dans le monde des oiseaux</h3>
                  <p class="reader-fiche-theme" id="reader-fiche-theme">Mini-monde · Jeu libre</p>
                  <div class="reader-placeholder">
                    <span aria-hidden="true">✦</span>
                    <strong>Emplacement de la fiche originale</strong>
                    <p>La page de ton livret sera affichée ici, sans modification de sa mise en page, une fois l’accès privé activé.</p>
                  </div>
                </div>
                <div class="reader-paper-footer">REGARDER · ÉCOUTER · S’ÉMERVEILLER</div>
              </div>
            </div>
            <div class="reader-toolbar reader-bottom">
              <button type="button" id="zoom-out" aria-label="Réduire le zoom">−</button>
              <output id="zoom-value" aria-live="polite">100 %</output>
              <button type="button" id="zoom-in" aria-label="Agrandir le zoom">+</button>
              <button type="button" id="zoom-reset">Réinitialiser</button>
            </div>
          </div>
          <p class="reader-note">Aucun bouton de téléchargement ou d’impression n’est proposé. La sélection du texte et le clic droit sont désactivés dans le lecteur. Ces mesures ne peuvent toutefois pas empêcher les captures d’écran.</p>
        </section>

        <section class="inventory" aria-labelledby="inventory-title">
          <p class="eyebrow">Préparer le matériel</p>
          <h2 id="inventory-title">Ce que vous trouverez dans la malle</h2>
          <div class="inventory-grid">
            <div><h3>Dans la malle</h3><p>Un mini-monde avec arbre, souche, tronc, figurines d’oiseaux, œufs et bols en bois ; une boîte de photographies d’indices, des cartes de déplacement, des photographies plastifiées, des outils pour la peinture de terre, cinq albums jeunesse, cinq fiches d’animation plastifiées et deux enceintes.</p></div>
            <div><h3>À prévoir de votre côté</h3><p>Argile marron, peinture, pinceaux, papier ou rouleau de papier, téléphone ou ordinateur pour les sons et, si possible, un appareil photo.</p><p>Vérifiez la liste définitive avec la fiche d’inventaire papier fournie avec la malle.</p></div>
          </div>
        </section>
        <section class="resources" aria-labelledby="resources-title">
          <p class="eyebrow">Des outils à piocher</p>
          <h2 id="resources-title">Pour enrichir les animations</h2>
          <div class="resource-grid">
            <article><h3>Le mini-monde</h3><p>Un univers volontairement ouvert, à aménager et transformer au fil des histoires et des saisons.</p></article>
            <article><h3>L’œuf, l’oiseau et son nid</h3><p>Un jeu d’association pour observer et comparer des œufs et des lieux de nidification.</p></article>
            <article><h3>La boîte des indices</h3><p>Des photographies pour regarder les traces laissées par les oiseaux.</p></article>
            <article><h3>Les cartes de déplacement</h3><p>Des supports pour inventer des jeux de mouvement ou adapter des jeux connus.</p></article>
            <article><h3>L’exposition à compléter</h3><p>Des photographies à enrichir avec les observations et les créations du groupe.</p></article>
            <article><h3>Les ressentis et les questions</h3><p>Plusieurs façons de terminer une activité, sans imposer de prise de parole.</p></article>
          </div>
        </section>
        <section class="outside">
          <div>
            <p class="eyebrow">Et après ?</p>
            <h2>Observer au fil des saisons</h2>
            <p>La malle se découvre toute l’année. Les chants, les déplacements et les indices changent avec les saisons. Un même lieu observé au printemps, en été, en automne ou en hiver peut devenir une nouvelle expérience. Pas besoin d’aller loin : une cour, un jardin ou un arbre visible depuis une fenêtre peuvent suffire.</p>
          </div>
        </section>

        <section class="ethics"><p class="eyebrow">Observer sans déranger</p><h2>Respecter le vivant</h2><p>Observer les oiseaux à distance, leur laisser de la tranquillité et privilégier les photographies ou les dessins plutôt que les prélèvements. Le mini-monde est fait pour être touché et déplacé ; dehors, les oiseaux, leurs nids et leurs œufs doivent être respectés.</p><p><strong>Le réflexe de la malle :</strong> J’observe · J’écoute · Je garde une trace · Je laisse sur place.</p></section>
        <section class="notice" aria-labelledby="notice-title">
          <h2 id="notice-title">À propos de cet espace</h2>
          <p>Cette page est une maquette de l’espace pédagogique. Elle ne contient pas encore le livret complet et <strong>n’est pas un espace privé sécurisé</strong>. Les fiches détaillées ne seront ajoutées qu’une fois l’accès réservé aux locataires mis en place.</p>
          <p>À terme, l’accès pourra être ouvert dès la confirmation de la réservation, pour préparer les animations avant la livraison de la malle.</p>
        </section>
      </div>
    </main>
    <SiteFooter />
    <style>
      :global(*){box-sizing:border-box}
      :global(body){margin:0;background:#f9f7f2;color:#292b23;font-family:Georgia,"Times New Roman",serif}
      .hero{background:#596243;color:#fffdf8;padding:76px 5.5% 68px}
      .hero-inner{width:min(1050px,100%);margin:auto}
      .eyebrow{font:700 .75rem Arial,Helvetica,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#7a835c;margin:0 0 14px}
      .hero .eyebrow{color:#dce4cb}
      h1{font-size:clamp(2.7rem,5vw,4.6rem);line-height:1.05;font-weight:400;max-width:760px;margin:0 0 22px}
      .hero p:not(.eyebrow){max-width:700px;font-size:1.1rem;line-height:1.7}
      .status{display:inline-block;margin-top:14px;padding:10px 14px;border:1px solid #b6c2a3;border-radius:5px;font:600 .82rem Arial,Helvetica,sans-serif}
      .page{width:min(1100px,89%);margin:auto}
      h2{font-size:clamp(1.9rem,3vw,2.8rem);line-height:1.15;font-weight:400;margin:0 0 20px}
      h3{font-size:1.35rem;font-weight:400;margin:0 0 12px}
      p{line-height:1.7}
      .welcome{display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:55px;padding:76px 0}
      .welcome p:not(.eyebrow){color:#56594d}
      .welcome img{width:100%;height:auto;max-height:410px;object-fit:contain;background:#ece9e0;border-radius:8px}
      .prepare{padding:54px 0 72px;border-top:1px solid #deded5}
      .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:30px}
      .steps article{background:#e5e8d9;padding:28px;border-radius:7px}
      .steps span{color:#73825b;font-size:1.8rem}
      .steps h3{margin-top:16px}
      .steps p{color:#53584d;margin-bottom:0;font-size:.95rem}
      .activities{padding:66px 0 80px;border-top:1px solid #deded5}
      .section-intro{max-width:740px;color:#56594d;margin-bottom:32px}
      .cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
      .activity{background:#f0eee7;padding:28px;border-radius:8px;display:flex;flex-direction:column;min-height:270px}
      .number{color:#84916a;font-size:1.55rem}
      .theme{font:700 .72rem Arial,Helvetica,sans-serif;letter-spacing:.06em;text-transform:uppercase;color:#717d58;margin:20px 0 8px}
      .activity p:not(.theme){color:#585b50;font-size:.93rem;margin:0 0 14px}.activity .prep{font-size:.84rem!important}.activity .sequence{color:#65754e!important;font-size:.78rem!important;font-weight:700}
      .soon{font:600 .78rem Arial,Helvetica,sans-serif;color:#6d7759;margin-top:auto;border-top:1px solid #d6d7ca;padding-top:14px}
      .open-reader{margin-top:auto;cursor:pointer;text-align:left;background:none;border:0;border-top:1px solid #d6d7ca;padding:14px 0 0;color:#566844;font:700 .85rem Arial,Helvetica,sans-serif}
      .open-reader:hover,.open-reader:focus-visible{text-decoration:underline}
      .reader-section{padding:58px 0 72px;border-top:1px solid #deded5}
      .reader-shell{border:1px solid #d7ddce;border-radius:10px;overflow:hidden;background:#e7e8df;user-select:none;-webkit-user-select:none}
      .reader-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px;background:#e4e9dc;font:600 .85rem Arial,Helvetica,sans-serif}
      .reader-toolbar button{background:#fffdf8;color:#405038;border:1px solid #bbc8b2;border-radius:6px;padding:10px 13px;cursor:pointer;font:inherit}
      .reader-toolbar button:disabled{opacity:.45;cursor:default}
      .reader-canvas{overflow:auto;max-height:650px;padding:24px;display:flex;align-items:flex-start;justify-content:center}
      .reader-paper{width:440px;min-width:440px;min-height:570px;transform-origin:top center;background:#fffdf8;box-shadow:0 8px 24px #34402d25;display:flex;flex-direction:column;pointer-events:none}
      .reader-paper-header,.reader-paper-footer{background:#677554;color:#fff;padding:16px 25px;font:700 .66rem Arial,Helvetica,sans-serif;letter-spacing:.11em}
      .reader-paper-inner{flex:1;padding:45px 38px}
      .reader-kicker{color:#7c8d60;font:700 .7rem Arial,Helvetica,sans-serif;letter-spacing:.1em}
      .reader-paper h3{font-size:2rem;line-height:1.15;margin:20px 0}
      .reader-fiche-theme{color:#677554;font-size:.95rem}
      .reader-placeholder{border:2px dashed #b9c7ac;border-radius:7px;margin-top:36px;padding:28px 20px;text-align:center;color:#56614d}
      .reader-placeholder span{font-size:2rem;display:block;margin-bottom:12px}
      .reader-placeholder strong{font:700 .92rem Arial,Helvetica,sans-serif}
      .reader-placeholder p{font-size:.88rem;line-height:1.6}
      .reader-bottom{justify-content:center}
      .reader-note{font-size:.86rem;color:#5b6154;max-width:760px}
      .inventory,.resources{padding:50px 0 70px;border-top:1px solid #deded5}.inventory-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.inventory-grid>div{background:#f0eee7;padding:26px;border-radius:8px}.inventory-grid p,.resource-grid p{color:#56594d;font-size:.93rem}.resource-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.resource-grid article{border:1px solid #d9dece;padding:24px;border-radius:8px}.ethics{padding:35px;margin:0 0 50px;border-left:4px solid #7d8957;background:#f0eee7}.ethics p{max-width:850px;color:#4f5748}.outside{background:#dfe4d1;border-radius:8px;padding:38px 42px;margin-bottom:52px}
      .outside>div{max-width:730px}
      .outside p:last-child{color:#4f5748;margin-bottom:0}
      .notice{border-left:4px solid #7d8957;background:#f0eee7;padding:25px 30px;margin-bottom:80px;border-radius:4px}
      .notice h2{font-size:1.5rem}
      .notice p{font-size:.93rem;color:#55594e}
      @media(max-width:850px){.welcome{grid-template-columns:1fr;gap:26px}.cards,.resource-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
      @media(max-width:600px){.hero{padding:55px 6%}.page{width:88%}.welcome{padding:48px 0}.steps,.cards,.resource-grid,.inventory-grid{grid-template-columns:1fr}.prepare,.activities{padding:45px 0}.outside{padding:28px}.notice{padding:22px;margin-bottom:50px}}
    </style>
    <script>
      const fiches = [
        { titre: "Dans le monde des oiseaux", theme: "Mini-monde · Jeu libre" },
        { titre: "À l’écoute des oiseaux… et du monde qui nous entoure", theme: "Écoute · Sons · Espace" },
        { titre: "Les oiseaux sont passés par ici…", theme: "Indices · Traces · Matières" },
        { titre: "Comme des oiseaux", theme: "Mouvement · Conte · Création" },
        { titre: "Balade avec les oiseaux", theme: "Dehors · Observation · Attention" }
      ];
      let index = 0;
      let zoom = 100;
      const byId = (id: string) => document.getElementById(id);
      const updateReader = () => {
        if (!byId("reader-fiche-title")) return;
        byId("reader-fiche-title")!.textContent = fiches[index].titre;
        byId("reader-fiche-theme")!.textContent = fiches[index].theme;
        byId("reader-kicker")!.textContent = "ANIMATION " + String(index + 1).padStart(2, "0");
        byId("reader-count")!.textContent = "Animation " + (index + 1) + " / " + fiches.length;
        (byId("prev-fiche") as HTMLButtonElement).disabled = index === 0;
        (byId("next-fiche") as HTMLButtonElement).disabled = index === fiches.length - 1;
        byId("zoom-value")!.textContent = zoom + " %";
        byId("reader-paper")!.style.zoom = String(zoom / 100);
      };
      byId("prev-fiche")?.addEventListener("click", () => { index = Math.max(0,index-1); updateReader(); });
      byId("next-fiche")?.addEventListener("click", () => { index = Math.min(fiches.length-1,index+1); updateReader(); });
      byId("zoom-out")?.addEventListener("click", () => { zoom = Math.max(60,zoom-20); updateReader(); });
      byId("zoom-in")?.addEventListener("click", () => { zoom = Math.min(200,zoom+20); updateReader(); });
      byId("zoom-reset")?.addEventListener("click", () => { zoom = 100; updateReader(); });
      document.querySelectorAll<HTMLButtonElement>(".open-reader").forEach(button => {
        button.addEventListener("click", () => {
          index = Number(button.dataset.fiche) || 0;
          zoom = 100;
          updateReader();
          byId("lecteur")?.scrollIntoView({behavior:"smooth",block:"start"});
        });
      });
      byId("reader-canvas")?.addEventListener("dragstart", e => e.preventDefault());
      updateReader();
    </script>
  </body>
</html>