---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Consultez les disponibilités et préparez une demande de réservation pour une malle pédagogique Rencontres avec le vivant."
    />
    <title>Réserver une malle · Rencontres avec le vivant</title>
    <script
      src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
      async
      defer
    ></script>
  </head>

  <body>
    <SiteHeader />

    <main>
      <section class="booking-hero">
        <div class="hero-inner">
          <p class="eyebrow light">Demande de réservation</p>
          <h1>Réserver une malle</h1>
          <p>
            Choisissez la durée, les dates et la formule souhaitées,
            puis transmettez les informations utiles pour préparer votre demande.
          </p>
        </div>
      </section>

      <section class="booking-intro">
        <div class="booking-intro-inner">
          <p class="eyebrow">Avant de réserver</p>
          <h2>Choisissez la durée de votre location</h2>
          <p>
            Vous pouvez louer la malle pendant <strong>1 semaine, 2 semaines
            ou 4 semaines consécutives</strong>. Pour une semaine, la location
            se déroule du lundi au vendredi. Pour 2 ou 4 semaines, la malle
            reste dans votre structure pendant les week-ends intermédiaires,
            jusqu’au vendredi de la dernière semaine. Elle est remise le
            vendredi précédant le début de la location.
          </p>
          <p>
            Après confirmation et paiement de la réservation, le livret
            pédagogique imprimé vous est envoyé par la poste afin que votre
            équipe puisse préparer les animations à l’avance. Les frais
            d’envoi du livret sont inclus.
          </p>

          <div class="service-area-note">
            <strong>Zone desservie actuellement :</strong>
            Pays de la Loire.
          </div>
        </div>
      </section>

      <section class="calendar-section">
        <div class="section-heading">
          <p class="eyebrow">Disponibilités</p>
          <h2 id="calendar-heading">Choisissez votre semaine de location</h2>
          <p id="calendar-help">
            Sélectionnez la semaine souhaitée dans le calendrier.
          </p>
        </div>

        <div class="duration-choice" aria-label="Durée de location">
          <button type="button" class="duration-option selected" data-duration="1" data-price="200">
            <span>1 semaine</span>
            <strong>200 €</strong>
          </button>
          <button type="button" class="duration-option" data-duration="2" data-price="370">
            <span>2 semaines</span>
            <strong>370 €</strong>
          </button>
          <button type="button" class="duration-option" data-duration="4" data-price="640">
            <span>4 semaines</span>
            <strong>640 €</strong>
          </button>
        </div>

        <div class="calendar-box">
          <div class="calendar-toolbar">
            <button
              type="button"
              id="previous-month"
              class="month-button"
              aria-label="Voir le mois précédent"
            >
              ←
            </button>

            <div class="month-title">
              <span>Mois affiché</span>
              <strong id="current-month"></strong>
            </div>

            <button
              type="button"
              id="next-month"
              class="month-button"
              aria-label="Voir le mois suivant"
            >
              →
            </button>
          </div>

          <div class="legend" aria-label="Légende du calendrier">
            <span><i class="dot available"></i> Disponible</span>
            <span><i class="dot pending"></i> Demande en cours</span>
            <span><i class="dot booked"></i> Réservée</span>
            <span><i class="dot school-holiday"></i> Vacances scolaires · Académie de Nantes</span>
          </div>

          <div id="weeks-grid" class="weeks-grid" aria-live="polite"></div>
        </div>

        <div id="selection-summary" class="selection-summary" hidden>
          <span class="selection-kicker">Votre période</span>
          <strong id="selection-period"></strong>
          <span id="selection-duration"></span>
          <button id="clear-selection" type="button" class="clear-selection">
            Effacer ma sélection
          </button>
        </div>

        <p class="calendar-note">
          Les vacances scolaires sont indiquées uniquement comme repère
          et n’empêchent pas la réservation.
        </p>
      </section>

      <section class="request-section" id="demande">
        <div class="request-intro">
          <p class="eyebrow">Votre demande</p>
          <h2>Préparer une réservation</h2>
          <p>
            Cette demande ne vaut pas réservation définitive.
            Je vérifie ensuite la disponibilité et la formule choisie
            avant de vous confirmer la location.
          </p>

          <div class="process-note">
            <strong>Après validation de votre demande</strong>
            <p>
              Vous recevez les informations nécessaires au règlement.
              Une fois le paiement reçu, le livret pédagogique imprimé vous
              est envoyé par la poste afin de préparer les animations.
              Il fait partie de la location et devra être restitué avec la malle.
            </p>
          </div>
        </div>

        <form class="booking-form" id="booking-form">
          <div class="field">
            <label for="kit">Malle souhaitée</label>
            <select id="kit" name="kit" required>
              <option value="Les oiseaux">Les oiseaux · 3–5 ans</option>
            </select>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="duration">Durée <span aria-hidden="true">*</span></label>
              <select id="duration" name="duration" required>
                <option value="1">1 semaine · 200 €</option>
                <option value="2">2 semaines · 370 €</option>
                <option value="4">4 semaines · 640 €</option>
              </select>
            </div>

            <div class="field">
              <label for="price-summary">Tarif estimé</label>
              <input
                id="price-summary"
                name="price-summary"
                type="text"
                value="200 € · formule autonome"
                readonly
              />
            </div>
          </div>

          <div class="field">
            <label for="week">Période souhaitée <span aria-hidden="true">*</span></label>
            <input
              id="week"
              name="week"
              type="text"
              placeholder="Sélectionnez votre période dans le calendrier"
              readonly
              required
            />
          </div>

          <div class="field">
            <label for="formula">Formule souhaitée <span aria-hidden="true">*</span></label>
            <select id="formula" name="formula" required>
              <option value="">Choisir une formule</option>
              <option value="Autonome">Formule autonome · inclus</option>
              <option value="Accompagnement">Avec accompagnement d’équipe (1 h 30) · + 140 €</option>
            </select>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="name">Votre nom <span aria-hidden="true">*</span></label>
              <input id="name" name="name" type="text" autocomplete="name" required />
            </div>

            <div class="field">
              <label for="email">Votre e-mail <span aria-hidden="true">*</span></label>
              <input id="email" name="email" type="email" autocomplete="email" required />
            </div>
          </div>

          <div class="field">
            <label for="organisation">Votre structure <span aria-hidden="true">*</span></label>
            <input
              id="organisation"
              name="organisation"
              type="text"
              autocomplete="organization"
              required
            />
          </div>

          <div class="field-row">
            <div class="field">
              <label for="children-age">Âge des enfants</label>
              <input
                id="children-age"
                name="children-age"
                type="text"
                placeholder="Par exemple : 3–5 ans"
              />
            </div>

            <div class="field">
              <label for="children-number">Nombre d’enfants</label>
              <input
                id="children-number"
                name="children-number"
                type="number"
                min="1"
                inputmode="numeric"
              />
            </div>
          </div>

          <div class="field">
            <label for="message">Précisions <span class="optional">(facultatif)</span></label>
            <textarea
              id="message"
              name="message"
              rows="5"
              placeholder="Horaires envisagés, contexte de la structure, question particulière…"
            ></textarea>
          </div>

          <div class="hp-field" aria-hidden="true">
            <label for="website">Site internet</label>
            <input
              id="website"
              name="website"
              type="text"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <div class="captcha-block">
            <div id="turnstile-container"></div>
            <p class="captcha-help">
              Vérification anti-robot sécurisée par Cloudflare Turnstile.
            </p>
          </div>

          <label class="consent">
            <input type="checkbox" required />
            <span>
              J’accepte que les informations renseignées soient utilisées
              pour traiter ma demande de réservation.
            </span>
          </label>

          <label class="consent rental-consent">
            <input type="checkbox" name="accept-conditions" required />
            <span>
              J’ai lu et j’accepte les
              <a href="/conditions-location" target="_blank" rel="noopener">
                conditions de location
              </a>.
            </span>
          </label>

          <button type="submit">
            Envoyer ma demande de réservation
            <span aria-hidden="true">→</span>
          </button>

          <p id="form-status" class="form-status" role="status"></p>
        </form>
      </section>
    </main>

    <SiteFooter />

    <script is:inline>
      let availability = {};
      let availabilityReady = false;

      const statusLabels = {
        available: "Disponible",
        pending: "Demande en cours",
        booked: "Réservée",
      };

      const schoolHolidays = [
        {
          name: "Vacances de la Toussaint",
          start: "2026-10-17",
          end: "2026-11-02",
        },
        {
          name: "Vacances de Noël",
          start: "2026-12-19",
          end: "2027-01-04",
        },
        {
          name: "Vacances d’hiver",
          start: "2027-02-20",
          end: "2027-03-08",
        },
        {
          name: "Vacances de printemps",
          start: "2027-04-17",
          end: "2027-05-03",
        },
        {
          name: "Vacances d’été",
          start: "2027-07-03",
          end: "2027-09-02",
        },
      ];

      const grid = document.getElementById("weeks-grid");
      const weekInput = document.getElementById("week");
      const durationSelect = document.getElementById("duration");
      const formulaSelect = document.getElementById("formula");
      const priceSummaryInput = document.getElementById("price-summary");
      const durationButtons = document.querySelectorAll(".duration-option");
      const bookingForm = document.getElementById("booking-form");
      const formStatus = document.getElementById("form-status");
      const currentMonthLabel = document.getElementById("current-month");
      const calendarHeading = document.getElementById("calendar-heading");
      const calendarHelp = document.getElementById("calendar-help");
      const selectionSummary = document.getElementById("selection-summary");
      const selectionPeriod = document.getElementById("selection-period");
      const selectionDuration = document.getElementById("selection-duration");
      const clearSelectionButton = document.getElementById("clear-selection");
      const previousMonthButton = document.getElementById("previous-month");
      const nextMonthButton = document.getElementById("next-month");
      let turnstileToken = "";
      let turnstileWidgetId = null;
      let selectedWeekIso = "";
      let selectedDuration = 1;

      const basePrices = {
        1: 200,
        2: 370,
        4: 640,
      };

      const formulaSupplements = {
        "": 0,
        Autonome: 0,
        Accompagnement: 140,
      };

      const today = new Date();
      today.setHours(12, 0, 0, 0);

      let displayedMonth = new Date(
        today.getFullYear(),
        today.getMonth(),
        1,
        12
      );

      const firstAllowedMonth = new Date(
        today.getFullYear(),
        today.getMonth(),
        1,
        12
      );

      const lastAllowedMonth = new Date(
        today.getFullYear(),
        today.getMonth() + 11,
        1,
        12
      );

      const initTurnstile = async () => {
        try {
          const response = await fetch("/api/turnstile-config");
          const config = await response.json();

          if (!response.ok || !config.ok || !config.siteKey) {
            throw new Error("Captcha non configuré.");
          }

          const waitForTurnstile = () =>
            new Promise((resolve) => {
              const check = () => {
                if (window.turnstile) {
                  resolve();
                } else {
                  setTimeout(check, 100);
                }
              };
              check();
            });

          await waitForTurnstile();

          turnstileWidgetId = window.turnstile.render(
            "#turnstile-container",
            {
              sitekey: config.siteKey,
              theme: "light",
              callback: (token) => {
                turnstileToken = token;
              },
              "expired-callback": () => {
                turnstileToken = "";
              },
              "error-callback": () => {
                turnstileToken = "";
              },
            }
          );
        } catch (error) {
          formStatus.textContent =
            "Le captcha n’est pas encore disponible. Merci de réessayer un peu plus tard.";
        }
      };

      initTurnstile();

      const formatIsoDate = (date) => {
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, "0");
        const day = String(date.getDate()).padStart(2, "0");
        return `${year}-${month}-${day}`;
      };

      const formatWeekLabel = (monday, friday) =>
        `Du lundi ${new Intl.DateTimeFormat("fr-FR", {
          day: "numeric",
          month: "long",
        }).format(monday)} au vendredi ${new Intl.DateTimeFormat("fr-FR", {
          day: "numeric",
          month: "long",
        }).format(friday)}`;

      const getMonday = (date) => {
        const result = new Date(date);
        result.setHours(12, 0, 0, 0);
        const day = result.getDay();
        const offset = day === 0 ? -6 : 1 - day;
        result.setDate(result.getDate() + offset);
        return result;
      };

      const isPastWeek = (monday) => {
        const friday = new Date(monday);
        friday.setDate(monday.getDate() + 4);
        friday.setHours(23, 59, 59, 999);
        return friday < today;
      };

      const parseLocalDate = (value) => {
        const [year, month, day] = value.split("-").map(Number);
        return new Date(year, month - 1, day, 12);
      };

      const getSchoolHolidayForWeek = (monday) => {
        const friday = new Date(monday);
        friday.setDate(monday.getDate() + 4);
        friday.setHours(12, 0, 0, 0);

        return schoolHolidays.find((holiday) => {
          const start = parseLocalDate(holiday.start);
          const end = parseLocalDate(holiday.end);

          return monday < end && friday >= start;
        });
      };

      const getRentalWeeks = (startMonday, duration = selectedDuration) => {
        const weeks = [];

        for (let index = 0; index < duration; index += 1) {
          const monday = new Date(startMonday);
          monday.setDate(startMonday.getDate() + index * 7);
          monday.setHours(12, 0, 0, 0);
          weeks.push(monday);
        }

        return weeks;
      };

      const getWeekStatus = (monday) => {
        if (isPastWeek(monday)) return "booked";
        return availability[formatIsoDate(monday)] || "available";
      };

      const isRangeAvailable = (startMonday) =>
        getRentalWeeks(startMonday).every(
          (monday) => getWeekStatus(monday) === "available",
        );

      const formatRentalPeriod = (startMonday) => {
        const weeks = getRentalWeeks(startMonday);
        const firstMonday = weeks[0];
        const lastFriday = new Date(weeks[weeks.length - 1]);
        lastFriday.setDate(lastFriday.getDate() + 4);

        if (weeks.length === 1) {
          return formatWeekLabel(firstMonday, lastFriday);
        }

        return `Du lundi ${new Intl.DateTimeFormat("fr-FR", {
          day: "numeric",
          month: "long",
        }).format(firstMonday)} au vendredi ${new Intl.DateTimeFormat("fr-FR", {
          day: "numeric",
          month: "long",
          year: "numeric",
        }).format(lastFriday)} · ${weeks.length} semaines`;
      };

      const selectedWeekIsos = () => {
        if (!selectedWeekIso) return [];

        const [year, month, day] = selectedWeekIso.split("-").map(Number);
        const monday = new Date(year, month - 1, day, 12);

        return getRentalWeeks(monday).map(formatIsoDate);
      };

      const updateDurationInterface = () => {
        if (selectedDuration === 1) {
          calendarHeading.textContent = "Choisissez votre semaine de location";
          calendarHelp.textContent =
            "Sélectionnez la semaine souhaitée dans le calendrier.";
        } else if (selectedDuration === 2) {
          calendarHeading.textContent = "Choisissez le début de vos 2 semaines";
          calendarHelp.textContent =
            "Cliquez sur la première semaine : la suivante sera incluse automatiquement si elle est disponible.";
        } else {
          calendarHeading.textContent = "Choisissez le début de vos 4 semaines";
          calendarHelp.textContent =
            "Cliquez sur la première semaine : les 3 semaines suivantes seront incluses automatiquement si elles sont disponibles.";
        }

        if (!selectedWeekIso) {
          selectionSummary.hidden = true;
        }
      };

      const updatePriceSummary = () => {
        const duration = Number(durationSelect.value || selectedDuration || 1);
        const formula = formulaSelect.value;
        const base = basePrices[duration] || 0;
        const supplement = formulaSupplements[formula] || 0;
        const total = base + supplement;

        const formulaLabel =
          formula === "Accompagnement"
            ? "avec accompagnement d’équipe"
            : "formule autonome";

        priceSummaryInput.value = `${total} € · ${formulaLabel}`;
      };

      const setDuration = (duration) => {
        selectedDuration = Number(duration);
        durationSelect.value = String(selectedDuration);

        durationButtons.forEach((button) => {
          button.classList.toggle(
            "selected",
            Number(button.dataset.duration) === selectedDuration,
          );
        });

        selectedWeekIso = "";
        weekInput.value = "";
        selectionPeriod.textContent = "";
        selectionDuration.textContent = "";
        selectionSummary.hidden = true;
        formStatus.textContent = "";

        updateDurationInterface();
        updatePriceSummary();
        renderCalendar();
      };

      clearSelectionButton.addEventListener("click", () => {
        selectedWeekIso = "";
        weekInput.value = "";
        selectionPeriod.textContent = "";
        selectionDuration.textContent = "";
        selectionSummary.hidden = true;
        formStatus.textContent = "";
        renderCalendar();

        document
          .querySelector(".calendar-section")
          .scrollIntoView({ behavior: "smooth", block: "start" });
      });

      const renderCalendar = () => {
        grid.innerHTML = "";

        currentMonthLabel.textContent =
          new Intl.DateTimeFormat("fr-FR", {
            month: "long",
            year: "numeric",
          }).format(displayedMonth);

        previousMonthButton.disabled =
          displayedMonth.getTime() <= firstAllowedMonth.getTime();

        nextMonthButton.disabled =
          displayedMonth.getTime() >= lastAllowedMonth.getTime();

        const firstDayOfMonth = new Date(
          displayedMonth.getFullYear(),
          displayedMonth.getMonth(),
          1,
          12
        );

        const monday = getMonday(firstDayOfMonth);

        for (let row = 0; row < 6; row += 1) {
          const weekMonday = new Date(monday);
          weekMonday.setDate(monday.getDate() + row * 7);

          if (weekMonday.getMonth() !== displayedMonth.getMonth()) {
            continue;
          }
          const friday = new Date(weekMonday);
          friday.setDate(weekMonday.getDate() + 4);

          const iso = formatIsoDate(weekMonday);
          let status = getWeekStatus(weekMonday);

          const week = document.createElement("div");
          week.className = `calendar-week ${status}`;

          if (selectedWeekIsos().includes(iso)) {
            week.classList.add("selected");
          }

          const rangeAvailable =
            availabilityReady &&
            status === "available" &&
            isRangeAvailable(weekMonday);

          const statusText =
            !availabilityReady
              ? "Disponibilités indisponibles"
              : isPastWeek(weekMonday)
                ? "Passée"
                : status === "available" && !rangeAvailable
                  ? "Période indisponible"
                  : statusLabels[status];

          const schoolHoliday = getSchoolHolidayForWeek(weekMonday);

          week.innerHTML = `
            <div class="week-topline">
              <div>
                <strong>${formatWeekLabel(weekMonday, friday)}</strong>
                <span class="week-status">${statusText}</span>
                ${schoolHoliday ? `
                  <span class="school-holiday-label">
                    ${schoolHoliday.name} · Académie de Nantes
                  </span>
                ` : ""}
              </div>
              <button
                type="button"
                class="select-week"
                ${!rangeAvailable ? "disabled" : ""}
              >
                ${selectedWeekIsos().includes(iso)
                  ? "Sélectionnée"
                  : selectedDuration === 1
                    ? "Choisir"
                    : selectedDuration === 2
                      ? "Choisir 2 sem."
                      : "Choisir 4 sem."}
              </button>
            </div>
          `;

          if (rangeAvailable) {
            const selectButton = week.querySelector(".select-week");

            selectButton.addEventListener("click", () => {
              selectedWeekIso = iso;
              const rentalPeriod = formatRentalPeriod(weekMonday);
              weekInput.value = rentalPeriod;

              selectionPeriod.textContent = rentalPeriod;
              selectionDuration.textContent =
                selectedDuration === 1
                  ? "1 semaine · 200 € avant éventuel accompagnement"
                  : selectedDuration === 2
                    ? "2 semaines consécutives · 370 € avant éventuel accompagnement"
                    : "4 semaines consécutives · 640 € avant éventuel accompagnement";
              selectionSummary.hidden = false;

              renderCalendar();

              document
                .getElementById("demande")
                .scrollIntoView({ behavior: "smooth", block: "start" });
            });
          }

          grid.appendChild(week);
        }
      };

      durationButtons.forEach((button) => {
        button.addEventListener("click", () => {
          setDuration(Number(button.dataset.duration));
        });
      });

      durationSelect.addEventListener("change", () => {
        setDuration(Number(durationSelect.value));
      });

      formulaSelect.addEventListener("change", updatePriceSummary);

      const durationFromUrl = Number(
        new URLSearchParams(window.location.search).get("duration")
      );

      if ([1, 2, 4].includes(durationFromUrl)) {
        selectedDuration = durationFromUrl;
        durationSelect.value = String(durationFromUrl);
        durationButtons.forEach((button) => {
          button.classList.toggle(
            "selected",
            Number(button.dataset.duration) === durationFromUrl,
          );
        });
      }

      updateDurationInterface();
      updatePriceSummary();

      previousMonthButton.addEventListener("click", () => {
        displayedMonth = new Date(
          displayedMonth.getFullYear(),
          displayedMonth.getMonth() - 1,
          1,
          12
        );
        renderCalendar();
      });

      nextMonthButton.addEventListener("click", () => {
        displayedMonth = new Date(
          displayedMonth.getFullYear(),
          displayedMonth.getMonth() + 1,
          1,
          12
        );
        renderCalendar();
      });

      const loadAvailability = async () => {
        try {
          const response = await fetch("/api/availability");
          const result = await response.json();

          if (response.ok && result.ok) {
            availability = result.availability || {};
            availabilityReady = true;
            formStatus.textContent = "";
          } else {
            availabilityReady = false;
            formStatus.textContent =
              "Les disponibilités sont momentanément indisponibles. Merci de réessayer dans quelques instants.";
          }
        } catch (error) {
          availabilityReady = false;
          console.error("Disponibilités indisponibles", error);
          formStatus.textContent =
            "Les disponibilités sont momentanément indisponibles. Merci de réessayer dans quelques instants.";
        } finally {
          renderCalendar();
        }
      };

      loadAvailability();

      bookingForm.addEventListener("submit", async (event) => {
        event.preventDefault();

        if (!weekInput.value) {
          formStatus.textContent =
            "Choisissez d’abord une période disponible dans le calendrier.";
          return;
        }

        if (!turnstileToken) {
          formStatus.textContent =
            "Merci de valider la vérification anti-robot.";
          return;
        }

        const submitButton = bookingForm.querySelector('button[type="submit"]');
        const formData = new FormData(bookingForm);

        const payload = {
          kit: formData.get("kit"),
          week: formData.get("week"),
          weekIso: selectedWeekIso,
          duration: formData.get("duration"),
          formula: formData.get("formula"),
          priceSummary: formData.get("price-summary"),
          name: formData.get("name"),
          email: formData.get("email"),
          organisation: formData.get("organisation"),
          childrenAge: formData.get("children-age"),
          childrenNumber: formData.get("children-number"),
          message: formData.get("message"),
          website: formData.get("website"),
          turnstileToken,
        };

        submitButton.disabled = true;
        submitButton.textContent = "Envoi en cours…";
        formStatus.textContent = "";

        try {
          const response = await fetch("/api/reservation", {
            method: "POST",
            headers: {
              "content-type": "application/json",
            },
            body: JSON.stringify(payload),
          });

          const result = await response.json();

          if (!response.ok || !result.ok) {
            throw new Error(
              result.error ||
                "La demande n’a pas pu être envoyée."
            );
          }

          formStatus.textContent =
            "Votre demande a bien été envoyée. Je reviendrai vers vous pour confirmer la disponibilité et la réservation.";

          bookingForm.reset();
          turnstileToken = "";
          selectedWeekIso = "";
          selectionSummary.hidden = true;
          selectedDuration = 1;
          durationSelect.value = "1";
          durationButtons.forEach((button) => {
            button.classList.toggle(
              "selected",
              Number(button.dataset.duration) === 1,
            );
          });
          updatePriceSummary();
          renderCalendar();

          if (
            window.turnstile &&
            turnstileWidgetId !== null
          ) {
            window.turnstile.reset(turnstileWidgetId);
          }

          document
            .querySelectorAll(".week-card.selected")
            .forEach((element) => element.classList.remove("selected"));
        } catch (error) {
          formStatus.textContent =
            error.message ||
            "La demande n’a pas pu être envoyée. Merci de réessayer.";
        } finally {
          submitButton.disabled = false;
          submitButton.innerHTML =
            'Envoyer ma demande de réservation <span aria-hidden="true">→</span>';
        }
      });
    </script>

