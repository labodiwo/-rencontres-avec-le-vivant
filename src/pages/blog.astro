---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Le blog de Rencontres avec le vivant : pédagogie, coulisses des malles et éducation au vivant." />
    <title>Le blog · Rencontres avec le vivant</title>
  </head>
  <body>
    <SiteHeader />

    <main>
      <section class="hero">
        <div>
          <p class="eyebrow light">Réflexions, pédagogie et coulisses</p>
          <h1>Le blog</h1>
          <p>Des articles pour partager les recherches, les choix pédagogiques et les coulisses de Rencontres avec le vivant.</p>
        </div>
      </section>

      <section class="intro">
        <p class="eyebrow">Prendre le temps de réfléchir</p>
        <h2>Derrière les malles, une démarche</h2>
        <p>Ce blog est un espace pour parler de pédagogie, de posture d’animateur, d’éducation à l’environnement, mais aussi des recherches et des essais qui accompagnent la création des malles.</p>
      </section>

      <section class="articles-section">
        <div class="heading">
          <p class="eyebrow">À lire</p>
          <h2>Les derniers articles</h2>
        </div>
        <div id="blog-status" class="loading">Chargement des articles…</div>
        <div id="articles-grid" class="articles-grid" hidden></div>
      </section>
    </main>

    <SiteFooter />

    <script is:inline>
      const grid = document.getElementById("articles-grid");
      const status = document.getElementById("blog-status");

      const escapeHtml = (value) =>
        String(value ?? "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");

      const formatDate = (value) => {
        if (!value) return "";
        const date = new Date(value + "T12:00:00");
        return new Intl.DateTimeFormat("fr-FR", {
          day: "numeric",
          month: "long",
          year: "numeric",
        }).format(date);
      };

      const loadPosts = async () => {
        try {
          const response = await fetch("/api/blog");
          const result = await response.json();

          if (!response.ok || !result.ok) {
            throw new Error("Impossible de charger les articles.");
          }

          const posts = result.posts || [];

          if (!posts.length) {
            status.textContent = "Les premiers articles seront bientôt publiés.";
            return;
          }

          status.hidden = true;
          grid.hidden = false;
          grid.innerHTML = posts.map((post) => `
            <article class="article-card">
              ${post.coverImageId ? `
                <img
                  class="article-image"
                  src="/api/blog-image/${encodeURIComponent(post.coverImageId)}"
                  alt=""
                  loading="lazy"
                />
              ` : ""}
              <div class="article-card-content">
              <div class="article-meta">
                <span>${escapeHtml(post.category || "Article")}</span>
                <time>${escapeHtml(formatDate(post.date))}</time>
              </div>
              <h3>${escapeHtml(post.title)}</h3>
              <p>${escapeHtml(post.excerpt)}</p>
              <a href="/blog/${encodeURIComponent(post.slug)}">Lire l’article →</a>
              </div>
            </article>
          `).join("");
        } catch (error) {
          status.textContent = "Les articles ne sont pas disponibles pour le moment.";
        }
      };

      loadPosts();
    </script>

    <style>
      :global(*){box-sizing:border-box}:global(body){margin:0;background:#f9f7f2;color:#292b23;font-family:Georgia,"Times New Roman",serif}.site-header{min-height:94px;padding:15px 5.5%;display:flex;align-items:center;justify-content:space-between;gap:32px}.brand{display:flex;align-items:center;color:#29271f;text-decoration:none}.brand-decoration{margin-right:10px;font-size:2.7rem;color:#747b51;transform:rotate(-15deg)}.brand-text{display:flex;flex-direction:column;font-size:1.55rem;line-height:1.05}nav{display:flex;align-items:center;gap:clamp(16px,2.2vw,34px);flex-wrap:wrap}nav a{color:#161713;text-decoration:none;font:600 .93rem Arial,Helvetica,sans-serif;white-space:nowrap}nav a:hover,nav a[aria-current="page"]{color:#687347}
      .hero{min-height:320px;padding:55px 5.5%;display:flex;align-items:center;justify-content:center;background:#596243;color:#fffdf8;text-align:center}.hero>div{max-width:760px}.hero h1{margin:4px 0 18px;font-size:clamp(3.4rem,6vw,5.7rem);font-weight:500;line-height:.96}.hero p:last-child{max-width:620px;margin:0 auto;line-height:1.6}.eyebrow{margin:0 0 10px;color:#74785e;font:700 .73rem Arial,Helvetica,sans-serif;letter-spacing:.11em;text-transform:uppercase}.eyebrow.light{color:rgba(255,255,255,.72)}
      .intro{padding:60px 5.5%;max-width:850px}.intro h2{margin:0 0 18px;font-size:clamp(2.2rem,3.5vw,3.1rem);font-weight:500}.intro p:last-child{color:#55574d;line-height:1.7;font-size:1.04rem}
      .articles-section{padding:70px 5.5% 85px;background:#f1eee8}.heading{text-align:center;margin-bottom:35px}.heading h2{margin:0;font-size:clamp(2.2rem,3.5vw,3.1rem);font-weight:500}.loading{text-align:center;color:#6f7167;font: .9rem Arial,Helvetica,sans-serif}.articles-grid{max-width:1120px;margin:0 auto;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}
      :global(.article-card){background:#fffefa;border-radius:8px;display:flex;flex-direction:column;overflow:hidden}:global(.article-image){display:block;width:100%;height:220px;object-fit:cover}:global(.article-card-content){padding:30px;display:flex;flex-direction:column;flex:1}:global(.article-meta){display:flex;justify-content:space-between;gap:15px;margin-bottom:18px;color:#737958;font:700 .72rem Arial,Helvetica,sans-serif;text-transform:uppercase;letter-spacing:.06em}:global(.article-card h3){margin:0 0 16px;font-size:1.55rem;font-weight:500;line-height:1.18}:global(.article-card p){margin:0 0 24px;color:#5b5c52;font: .92rem/1.65 Arial,Helvetica,sans-serif}:global(.article-card a){margin-top:auto;color:#596243;text-decoration:none;font-weight:700}
      footer{padding:46px 5.5%;background:#303428;color:#f5f2e9;text-align:center}.footer-brand{color:inherit;text-decoration:none;font-size:1.35rem}footer p{color:rgba(255,255,255,.7)}footer small{color:rgba(255,255,255,.5);font-family:Arial,Helvetica,sans-serif}@media(max-width:900px){.site-header{flex-direction:column;align-items:flex-start}.articles-grid{grid-template-columns:1fr}}@media(max-width:650px){.site-header{padding:16px 22px}.hero{min-height:280px;padding:45px 24px}.intro{padding:45px 24px}.articles-section{padding:55px 24px}}
    </style>
  </body>
</html>
