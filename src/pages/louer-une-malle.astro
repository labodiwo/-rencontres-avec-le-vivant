---
const nav = [
  { label: "Les malles", href: "/les-malles" },
  { label: "Louer une malle", href: "/louer-une-malle" },
  { label: "Le blog", href: "/blog" },
  { label: "Me contacter", href: "/contact" },
];

const steps = [
  {
    number: "01",
    title: "Choisir une malle",
    text: "Découvrez son contenu, l’âge conseillé et les expériences proposées.",
  },
  {
    number: "02",
    title: "Faire une demande",
    text: "Indiquez la malle souhaitée, votre structure et la semaine qui vous intéresse.",
  },
  {
    number: "03",
    title: "Confirmer la réservation",
    text: "Je vérifie la disponibilité, nous choisissons ensemble la formule adaptée et la réservation est confirmée.",
  },
  {
    number: "04",
    title: "Recevoir le livret",
    text: "Dès la confirmation, vous recevez le livret pédagogique en version numérique pour préparer les animations à l’avance.",
  },
  {
    number: "05",
    title: "Recevoir la malle",
    text: "La malle physique est remise le vendredi précédant votre semaine de location, prête à être utilisée dès le début de la semaine.",
  },
  {
    number: "06",
    title: "Utiliser puis restituer",
    text: "Vous utilisez la malle selon la formule choisie, puis elle est restituée complète à la fin de la période prévue.",
  },
];

const formulas = [
  {
    title: "Formule autonome",
    subtitle: "La malle, sans intervention sur place",
    text: "Vous recevez le livret dès la confirmation de la réservation, puis la malle le vendredi précédent. Votre équipe prépare et mène les animations en toute autonomie.",
  },
  {
    title: "Formule avec présentation",
    subtitle: "Une prise en main accompagnée",
    text: "En plus de la location, je présente la malle à l’équipe : contenu, logique pédagogique, possibilités d’utilisation et questions pratiques. L’équipe poursuit ensuite en autonomie.",
  },
  {
    title: "Formule avec animation",
    subtitle: "Une animation menée auprès des enfants",
    text: "La malle est louée à la structure et j’interviens également pour animer une proposition auprès des enfants. L’équipe peut ensuite poursuivre les autres expériences pendant la semaine.",
  },
];
---

<!doctype html>

<html lang="fr">

  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content="Découvrez comment louer une malle pédagogique Rencontres avec le vivant : demande de réservation, disponibilité, paiement, retrait et restitution."
    />

    <title>
      Louer une malle · Rencontres avec le vivant
    </title>

  </head>


  <body>


    <!-- HEADER -->
    <header class="site-header">

      <a
        class="brand"
        href="/"
        aria-label="Accueil"
      >

        <span
          class="brand-decoration"
          aria-hidden="true"
        >
          ⌇
        </span>

        <span class="brand-text">
          <span>Rencontres</span>
          <span>avec le vivant</span>
        </span>

      </a>


      <nav aria-label="Navigation principale">

        {
          nav.map((item) => (

            <a
              href={item.href}
              aria-current={
                item.href === "/louer-une-malle"
                  ? "page"
                  : undefined
              }
            >
              {item.label}
            </a>

          ))
        }

      </nav>

    </header>



    <main>


      <!-- HERO -->
      <section class="rental-hero">

        <div class="hero-inner">

          <p class="eyebrow light">
            Location des malles
          </p>

          <h1>
            Louer une malle
          </h1>

          <p>
            Quelques étapes suffisent pour accueillir
            une malle pédagogique dans votre structure.
          </p>

        </div>

      </section>



      <!-- INTRO -->
      <section class="intro">

        <div class="intro-inner">

          <p class="eyebrow">
            Comment ça marche ?
          </p>

          <h2>
            Une location simple,
            de la demande à la restitution
          </h2>

          <p class="lead">
            Les malles sont conçues pour pouvoir circuler
            entre différentes structures tout en restant
            complètes, faciles à prendre en main
            et prêtes à être utilisées.
          </p>

          <p>
            Dès que la réservation est confirmée, le livret pédagogique
            vous est envoyé en version numérique. Vous pouvez ainsi
            découvrir les activités, choisir celles que vous souhaitez
            proposer et préparer votre semaine avant l’arrivée de la malle.
          </p>

          <p>
            La malle physique est ensuite remise le vendredi précédant
            la semaine de location.
          </p>

        </div>

      </section>



      <!-- ÉTAPES -->
      <section class="steps-section">

        <div class="section-heading">

          <p class="eyebrow">
            Étape par étape
          </p>

          <h2>
            Comment louer une malle ?
          </h2>

        </div>


        <div class="steps-grid">

          {
            steps.map((step) => (

              <article class="step-card">

                <span class="step-number">
                  {step.number}
                </span>

                <h3>
                  {step.title}
                </h3>

                <p>
                  {step.text}
                </p>

              </article>

            ))
          }

        </div>

      </section>



      <!-- FORMULES -->
      <section class="formulas-section">

        <div class="section-heading">

          <p class="eyebrow">
            Choisir son accompagnement
          </p>

          <h2>
            Trois façons de louer une malle
          </h2>

          <p class="section-intro">
            Toutes les formules comprennent l’accès au livret pédagogique
            dès la confirmation de la réservation et la mise à disposition
            de la malle pour la période convenue.
          </p>

        </div>

        <div class="formulas-grid">

          {
            formulas.map((formula, index) => (

              <article class="formula-card">

                <span class="formula-number">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <h3>
                  {formula.title}
                </h3>

                <p class="formula-subtitle">
                  {formula.subtitle}
                </p>

                <p>
                  {formula.text}
                </p>

              </article>

            ))
          }

        </div>

      </section>


      <!-- MALLE DISPONIBLE -->
      <section class="available">

        <div class="available-inner">


          <div class="available-text">

            <p class="eyebrow">
              Première malle disponible
            </p>

            <h2>
              Les oiseaux
            </h2>

            <p class="age">
              Pour les enfants de 3 à 5 ans
            </p>

            <p>
              Une malle pour écouter, observer,
              manipuler et découvrir les oiseaux
              à travers des histoires, des jeux,
              un mini-monde et différentes expériences.
            </p>

            <a
              class="text-link"
              href="/malle-les-oiseaux"
            >
              Découvrir le contenu de la malle
              <span aria-hidden="true">→</span>
            </a>

          </div>


          <div class="rental-card">

            <p class="small-title">
              Location
            </p>

            <h3>
              Malle « Les oiseaux »
            </h3>


            <div class="rental-information">

              <div>
                <span>Public</span>
                <strong>3–5 ans</strong>
              </div>

              <div>
                <span>Préparation</span>
                <strong>Livret envoyé dès confirmation</strong>
              </div>

              <div>
                <span>Remise de la malle</span>
                <strong>Le vendredi précédent</strong>
              </div>

              <div>
                <span>Formule</span>
                <strong>Autonome ou accompagnée</strong>
              </div>

              <div>
                <span>Disponibilité</span>
                <strong>Sur demande</strong>
              </div>

            </div>


            <a
              class="primary-button"
              href="/reserver-une-malle"
            >
              Faire une demande de location
              <span aria-hidden="true">→</span>
            </a>

          </div>

        </div>

      </section>



      <!-- CE QUI EST COMPRIS -->
      <section class="included">

        <div class="included-inner">

          <div>

            <p class="eyebrow">
              Pendant la location
            </p>

            <h2>
              Tout est réuni
              dans la malle
            </h2>

          </div>


          <div class="included-list">

            <div class="included-item">

              <span>01</span>

              <p>
                <strong>Le matériel pédagogique</strong>
                Les éléments nécessaires aux différentes
                expériences sont regroupés dans la malle.
              </p>

            </div>


            <div class="included-item">

              <span>02</span>

              <p>
                <strong>Le livret pédagogique en amont</strong>
                Il est envoyé en version numérique dès la confirmation
                de la réservation pour vous permettre de préparer
                les animations avant l’arrivée de la malle.
              </p>

            </div>


            <div class="included-item">

              <span>03</span>

              <p>
                <strong>Les supports</strong>
                Livres, éléments visuels, matériel sensoriel
                et supports nécessaires aux activités.
              </p>

            </div>


            <div class="included-item">

              <span>04</span>

              <p>
                <strong>Des prolongements dehors</strong>
                Des invitations pour poursuivre les découvertes
                dans l’environnement réel.
              </p>

            </div>

          </div>

        </div>

      </section>



      <!-- PAIEMENT -->
      <section class="payment-section">

        <div class="payment-inner">

          <div class="payment-text">

            <p class="eyebrow">
              Réservation et règlement
            </p>

            <h2>
              Le paiement intervient
              après confirmation
            </h2>

            <p>
              Avant tout règlement, je vérifie avec vous
              la disponibilité de la malle, la semaine souhaitée
              et la formule choisie.
            </p>

            <p>
              Une fois la réservation confirmée,
              vous recevrez le lien permettant
              d’effectuer le paiement en ligne.
            </p>

          </div>


          <div class="payment-card">

            <span class="payment-icon">
              €
            </span>

            <h3>
              Paiement sécurisé en ligne
            </h3>

            <p>
              Le module de paiement sera disponible
              une fois votre demande de location validée.
            </p>

            <button
              type="button"
              disabled
            >
              Paiement après confirmation
            </button>

            <small>
              Aucun paiement n’est demandé
              avant la validation des dates.
            </small>

          </div>

        </div>

      </section>



      <!-- RESTITUTION -->
      <section class="return-section">

        <div class="return-inner">

          <p class="eyebrow">
            Après l’utilisation
          </p>

          <h2>
            Une malle faite pour circuler
          </h2>

          <p>
            Chaque utilisateur contribue à préserver
            le matériel pour les groupes suivants.
            Avant la restitution, il suffit de replacer
            les différents éléments dans la malle
            et de signaler si un objet a été perdu
            ou endommagé.
          </p>

        </div>

      </section>



      <!-- APPEL À L'ACTION -->
      <section class="cta">

        <div class="cta-inner">

          <p class="eyebrow light">
            Vous êtes intéressé ?
          </p>

          <h2>
            Une malle pourrait rejoindre
            votre structure
          </h2>

          <p>
            Envoyez simplement votre demande
            avec les dates envisagées.
          </p>

          <a
            class="cta-button"
            href="/reserver-une-malle"
          >
            Demander une location
            <span aria-hidden="true">→</span>
          </a>

        </div>

      </section>


    </main>



    <!-- FOOTER -->
    <footer>

      <a
        class="footer-brand"
        href="/"
      >
        Rencontres avec le vivant
      </a>

      <p>
        Des outils pour prendre le temps
        de rencontrer le vivant.
      </p>

      <small>
        © Rencontres avec le vivant
      </small>

    </footer>



    <style>


      /* BASE */

      :global(*) {
        box-sizing: border-box;
      }


      :global(html) {
        scroll-behavior: smooth;
      }


      :global(body) {
        margin: 0;

        background: #f9f7f2;
        color: #292b23;

        font-family:
          Georgia,
          "Times New Roman",
          serif;
      }



      /* HEADER */

      .site-header {
        min-height: 94px;

        padding: 15px 5.5%;

        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 40px;

        background: #f9f7f2;
      }


      .brand {
        display: flex;
        align-items: center;

        color: #29271f;

        text-decoration: none;
      }


      .brand-decoration {
        margin-right: 10px;

        font-size: 2.7rem;

        line-height: 1;

        color: #747b51;

        transform: rotate(-15deg);
      }


      .brand-text {
        display: flex;

        flex-direction: column;

        font-size: 1.55rem;

        line-height: 1.05;
      }


      nav {
        display: flex;

        align-items: center;

        gap: clamp(20px, 3vw, 45px);
      }


      nav a {
        color: #161713;

        text-decoration: none;

        font-size: 0.96rem;

        font-weight: 600;

        white-space: nowrap;
      }


      nav a:hover,
      nav a[aria-current="page"] {
        color: #687347;
      }



      /* COMMUN */

      .eyebrow {
        margin: 0 0 10px;

        color: #74785e;

        font-family:
          Arial,
          Helvetica,
          sans-serif;

        font-size: 0.73rem;

        line-height: 1.3;

        letter-spacing: 0.11em;

        text-transform: uppercase;
      }


      .eyebrow.light {
        color: rgba(255, 255, 255, 0.72);
      }



      /* HERO */

      .rental-hero {
        min-height: 320px;

        padding: 55px 5.5%;

        display: flex;

        align-items: center;

        justify-content: center;

        background: #596243;

        color: #fffdf8;

        text-align: center;
      }


      .hero-inner {
        max-width: 760px;

        margin: 0 auto;
      }


      .rental-hero h1 {
        margin: 4px 0 18px;

        font-size: clamp(3.4rem, 6vw, 5.7rem);

        line-height: 0.96;

        font-weight: 500;
      }


      .rental-hero p:last-child {
        max-width: 620px;

        margin: 0 auto;

        font-size: 1.1rem;

        line-height: 1.6;
      }



      /* INTRO */

      .intro {
        padding: 55px 5.5%;
      }


      .intro-inner {
        max-width: 760px;
      }


      .intro h2 {
        margin: 0 0 20px;

        max-width: 700px;

        font-size: clamp(2.2rem, 3.5vw, 3.1rem);

        line-height: 1.05;

        font-weight: 500;
      }


      .intro p {
        max-width: 720px;

        line-height: 1.7;
      }


      .intro .lead {
        font-size: 1.1rem;
      }



      /* ÉTAPES */

      .steps-section {
        padding: 70px 5.5%;

        background: #f1eee8;
      }


      .section-heading {
        max-width: 760px;

        margin: 0 auto 45px;

        text-align: center;
      }


      .section-heading h2 {
        margin: 0;

        font-size: clamp(2.2rem, 3.5vw, 3.1rem);

        font-weight: 500;
      }


      .steps-grid {
        max-width: 1120px;

        margin: 0 auto;

        display: grid;

        grid-template-columns:
          repeat(3, minmax(0, 1fr));

        gap: 22px;
      }


      .step-card {
        padding: 30px;

        background: #f9f7f2;

        border-radius: 7px;
      }


      .step-number {
        display: block;

        margin-bottom: 24px;

        color: #88906b;

        font-size: 1.9rem;
      }


      .step-card h3 {
        margin: 0 0 12px;

        font-size: 1.3rem;

        font-weight: 500;
      }


      .step-card p {
        margin: 0;

        color: #606157;

        font-family:
          Arial,
          Helvetica,
          sans-serif;

        font-size: 0.9rem;

        line-height: 1.6;
      }



      /* FORMULES */

      .formulas-section {
        padding: 70px 5.5%;
        background: #f9f7f2;
      }

      .section-intro {
        max-width: 700px;
        margin: 16px auto 0;
        color: #5d5e54;
        line-height: 1.65;
      }

      .formulas-grid {
        max-width: 1120px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 22px;
      }

      .formula-card {
        padding: 32px;
        background: #dfe3cf;
        border-radius: 8px;
      }

      .formula-number {
        display: block;
        margin-bottom: 22px;
        color: #7c8560;
        font-size: 1.7rem;
      }

      .formula-card h3 {
        margin: 0 0 8px;
        font-size: 1.45rem;
        font-weight: 500;
      }

      .formula-subtitle {
        margin: 0 0 16px;
        color: #596243;
        font-weight: 600;
      }

      .formula-card p:last-child {
        margin: 0;
        color: #56584d;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 0.9rem;
        line-height: 1.6;
      }


      /* MALLE */

      .available {
        padding: 75px 5.5%;
      }


      .available-inner {
        max-width: 1100px;

        margin: 0 auto;

        display: grid;

        grid-template-columns:
          1fr
          0.8fr;

        gap: clamp(50px, 8vw, 100px);

        align-items: center;
      }


      .available-text h2 {
        margin: 0 0 12px;

        font-size: clamp(2.4rem, 4vw, 3.6rem);

        font-weight: 500;
      }


      .age {
        color: #6f7750;

        font-weight: 600;
      }


      .available-text p {
        max-width: 600px;

        line-height: 1.65;
      }


      .text-link {
        display: inline-flex;

        gap: 12px;

        margin-top: 10px;

        color: #596243;

        font-weight: 600;

        text-decoration: none;
      }


      .rental-card {
        padding: 38px;

        background: #dfe3cf;

        border-radius: 8px;
      }


      .small-title {
        margin: 0 0 8px;

        color: #6b7353;

        font-family:
          Arial,
          Helvetica,
          sans-serif;

        font-size: 0.72rem;

        letter-spacing: 0.1em;

        text-transform: uppercase;
      }


      .rental-card h3 {
        margin: 0 0 28px;

        font-size: 1.8rem;

        font-weight: 500;
      }


      .rental-information {
        margin-bottom: 28px;
      }


      .rental-information div {
        padding: 14px 0;

        display: flex;

        justify-content: space-between;

        gap: 20px;

        border-bottom:
          1px solid
          rgba(89, 98, 67, 0.18);
      }


      .rental-information span {
        font-family:
          Arial,
          Helvetica,
          sans-serif;

        font-size: 0.82rem;

        color: #606654;
      }


      .rental-information strong {
        font-weight: 500;

        text-align: right;
      }



      /* BOUTON */

      .primary-button,
      .cta-button {
        display: inline-flex;

        align-items: center;

        gap: 14px;

        padding: 12px 18px;

        border-radius: 4px;

        background: #7d8957;

        color: #fff;

        text-decoration: none;

        font-weight: 600;
      }


      .primary-button:hover,
      .cta-button:hover {
        background: #69754a;
      }



      /* CE QUI EST COMPRIS */

      .included {
        padding: 75px 5.5%;

        background: #ece9e1;
      }


      .included-inner {
        max-width: 1050px;

        margin: 0 auto;

        display: grid;

        grid-template-columns:
          0.85fr
          1.15fr;

        gap: 70px;
      }


      .included h2 {
        margin: 0;

        font-size: clamp(2.2rem, 3.5vw, 3rem);

        line-height: 1.05;

        font-weight: 500;
      }


      .included-item {
        padding: 20px 0;

        display: grid;

        grid-template-columns:
          45px
          1fr;

        gap: 18px;

        border-bottom:
          1px solid
          #d1cec5;
      }


      .included-item > span {
        color: #88906b;
      }


      .included-item p {
        margin: 0;

        color: #5d5e54;

        line-height: 1.6;
      }


      .included-item strong {
        display: block;

        margin-bottom: 4px;

        color: #292b23;
      }



      /* PAIEMENT */

      .payment-section {
        padding: 75px 5.5%;
      }


      .payment-inner {
        max-width: 1050px;

        margin: 0 auto;

        display: grid;

        grid-template-columns:
          1fr
          0.8fr;

        gap: 70px;

        align-items: center;
      }


      .payment-text h2 {
        margin: 0 0 20px;

        font-size: clamp(2.2rem, 3.5vw, 3rem);

        line-height: 1.05;

        font-weight: 500;
      }


      .payment-text p {
        max-width: 600px;

        line-height: 1.65;
      }


      .payment-card {
        padding: 36px;

        background: #f1eee8;

        border-radius: 8px;

        text-align: center;
      }


      .payment-icon {
        display: grid;

        width: 58px;

        height: 58px;

        margin: 0 auto 20px;

        place-items: center;

        border-radius: 50%;

        background: #dfe3cf;

        color: #596243;

        font-size: 1.5rem;
      }


      .payment-card h3 {
        margin: 0 0 14px;

        font-size: 1.45rem;

        font-weight: 500;
      }


      .payment-card p {
        line-height: 1.55;
      }


      .payment-card button {
        width: 100%;

        margin: 12px 0 15px;

        padding: 13px 17px;

        border: 0;

        border-radius: 4px;

        background: #b5b7aa;

        color: #fff;

        cursor: not-allowed;

        font-weight: 600;
      }


      .payment-card small {
        display: block;

        color: #77786f;

        font-family:
          Arial,
          Helvetica,
          sans-serif;

        font-size: 0.75rem;

        line-height: 1.5;
      }



      /* RESTITUTION */

      .return-section {
        padding: 65px 24px;

        background: #dfe3cf;

        text-align: center;
      }


      .return-inner {
        max-width: 720px;

        margin: 0 auto;
      }


      .return-inner h2 {
        margin: 0 0 18px;

        font-size: clamp(2.1rem, 3.5vw, 3rem);

        font-weight: 500;
      }


      .return-inner p:last-child {
        margin: 0;

        line-height: 1.7;
      }



      /* CTA */

      .cta {
        padding: 75px 24px;

        background: #596243;

