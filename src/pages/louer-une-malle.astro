---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

const steps = [
  {
    number: "01",
    title: "Choisir une malle",
    text: "Découvrez son contenu, l’âge conseillé et les expériences proposées.",
  },
  {
    number: "02",
    title: "Faire une demande",
    text: "Indiquez la malle souhaitée, votre structure et la durée de location qui vous intéresse : 1 semaine, 2 semaines ou 4 semaines consécutives.",
  },
  {
    number: "03",
    title: "Confirmer la réservation",
    text: "Je vérifie la disponibilité, nous choisissons ensemble la formule adaptée et la réservation est confirmée.",
  },
  {
    number: "04",
    title: "Recevoir le livret",
    text: "Après confirmation et paiement, le livret pédagogique imprimé vous est envoyé par la poste pour préparer les animations à l’avance. Les frais d’envoi sont inclus. Le livret fait partie de la location et doit être restitué avec la malle.",
  },
  {
    number: "05",
    title: "Recevoir la malle",
    text: "La malle physique est remise le vendredi précédant le début de la location, afin qu’elle soit prête à être utilisée dès le lundi.",
  },
  {
    number: "06",
    title: "Utiliser puis restituer",
    text: "Vous utilisez la malle selon la formule choisie, puis elle est restituée complète à la fin de la période prévue.",
  },
];

const formulas = [
  {
    title: "Formule autonome",
    subtitle: "La malle, à faire vivre par votre équipe",
    text: "Après confirmation et paiement, vous recevez le livret imprimé par la poste, puis la malle le vendredi précédent. Votre équipe prépare et mène les propositions en toute autonomie.",
    price: "Inclus dans le tarif de location",
    features: [
      "Livret imprimé envoyé en amont, à restituer avec la malle",
      "Malle disponible pendant toute la période choisie",
      "Liberté d’adapter les propositions à votre groupe",
    ],
  },
  {
    title: "Avec accompagnement d’équipe",
    subtitle: "1 h 30 pour s’approprier la malle",
    text: "Un temps d’échange pour découvrir le matériel, comprendre les intentions pédagogiques et réfléchir ensemble aux adaptations possibles selon votre public.",
    price: "+ 140 €",
    features: [
      "Découverte et manipulation du matériel",
      "Échange autour des usages et adaptations possibles",
      "Temps de questions avec l’équipe",
    ],
  },
];
---

<!doctype html>

<html lang="fr">

  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <link rel="icon" href="/images/logo-rencontres.jpg" type="image/jpeg" />

    <meta
      name="description"
      content="Découvrez comment louer une malle pédagogique Rencontres avec le vivant : demande de réservation, disponibilité, paiement, retrait et restitution."
    />

    <title>
      Louer une malle · Rencontres avec le vivant
    </title>
    <link rel="canonical" href="https://labodiwo.com/louer-une-malle" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rencontres avec le vivant" />
    <meta property="og:title" content="Louer une malle · Rencontres avec le vivant" />
    <meta property="og:description" content="Découvrez comment louer une malle pédagogique Rencontres avec le vivant : demande de réservation, disponibilité, paiement, retrait et restitution." />
    <meta property="og:url" content="https://labodiwo.com/louer-une-malle" />
    <meta property="og:image" content="https://labodiwo.com/images/malle-oiseaux.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Louer une malle · Rencontres avec le vivant" />
    <meta name="twitter:description" content="Découvrez comment louer une malle pédagogique Rencontres avec le vivant : demande de réservation, disponibilité, paiement, retrait et restitution." />
    <meta name="twitter:image" content="https://labodiwo.com/images/malle-oiseaux.jpg" />

  </head>


  <body>


    <!-- HEADER -->
    <SiteHeader />



    <main>


      <!-- HERO -->
      <section class="rental-hero">

        <div class="hero-inner">

          <p class="eyebrow light">
            Location des malles
          </p>

          <h1>
            Louer une malle
          </h1>

          <p>
            Quelques étapes suffisent pour accueillir
            une malle pédagogique dans votre structure.
          </p>

        </div>

      </section>



      <!-- INTRO -->
      <section class="intro">

        <div class="intro-inner">

          <p class="eyebrow">
            Comment ça marche ?
          </p>

          <h2>
            Une location simple,
            de la demande à la restitution
          </h2>

          <p class="lead">
            Les malles sont conçues pour pouvoir circuler
            entre différentes structures tout en restant
            complètes, faciles à prendre en main
            et prêtes à être utilisées.
          </p>

          <p>
            Après confirmation et paiement, le livret pédagogique imprimé
            vous est envoyé par la poste. Vous pouvez ainsi découvrir les
            propositions, choisir celles que vous souhaitez faire vivre et
            préparer votre période de location avant l’arrivée de la malle.
          </p>

          <p>
            Trois durées sont proposées : <strong>1 semaine, 2 semaines
            ou 4 semaines consécutives</strong>. Une location d’une semaine
            se déroule du lundi au vendredi. Pour 2 ou 4 semaines, la malle
            reste dans la structure pendant les week-ends intermédiaires,
            jusqu’au vendredi de la dernière semaine. La malle physique est
            remise le vendredi précédant le début de la location.
          </p>

        </div>

      </section>


      <!-- TARIFS -->
      <section class="pricing-section">

        <div class="pricing-heading">

          <p class="eyebrow">
            Tarifs de location
          </p>

          <h2>
            Choisir la durée qui convient à votre structure
          </h2>

          <p>
            Le tarif comprend la malle complète et l’envoi postal du livret
            pédagogique imprimé après confirmation et paiement. Les frais
            d’envoi du livret sont inclus.
          </p>
          <p class="service-area">
            <strong>Zone desservie pour le moment :</strong> Pays de la Loire.
          </p>

        </div>


        <div class="duration-grid">

          <button type="button" class="duration-card selected" data-duration="1" aria-pressed="true">

            <p class="duration-label">
              1 semaine
            </p>

            <p class="duration-price">
              200 €
            </p>

            <p>
              Pour découvrir la malle et construire une semaine
              d’animations autour du thème.
            </p>

          </button>


          <button type="button" class="duration-card" data-duration="2" aria-pressed="false">

            <p class="duration-label">
              2 semaines consécutives
            </p>

            <p class="duration-price">
              370 €
            </p>

            <p>
              Pour prendre davantage de temps et faire vivre
              plusieurs propositions au même groupe.
            </p>

          </button>


          <button type="button" class="duration-card" data-duration="4" aria-pressed="false">

            <p class="duration-label">
              4 semaines consécutives
            </p>

            <p class="duration-price">
              640 €
            </p>

            <p>
              Idéal pour construire un cycle dans la durée,
              par exemple une séance chaque mercredi,
              ou pour l’utiliser avec plusieurs groupes.
            </p>

          </button>

        </div>


        <div class="intervention-prices">

          <div>
            <span>Formule autonome</span>
            <strong>Inclus</strong>
          </div>

          <div>
            <span>Accompagnement d’équipe · 1 h 30</span>
            <strong>+ 140 €</strong>
          </div>

        </div>


        <div class="pricing-cta">

          <p>
            Choisissez ensuite vos dates et la formule souhaitée
            dans le calendrier de réservation.
          </p>

          <a
            id="pricing-reservation-link"
            class="primary-button"
            href="/reserver-une-malle?duration=1"
          >
            Voir les disponibilités et réserver
            <span aria-hidden="true">→</span>
          </a>

        </div>

      </section>



      <!-- ÉTAPES -->
      <section class="steps-section">

        <div class="section-heading">

          <p class="eyebrow">
            Étape par étape
          </p>

          <h2>
            Comment louer une malle ?
          </h2>

        </div>


        <div class="steps-grid">

          {
            steps.map((step) => (

              <article class="step-card">

                <span class="step-number">
                  {step.number}
                </span>

                <h3>
                  {step.title}
                </h3>

                <p>
                  {step.text}
                </p>

              </article>

            ))
          }

        </div>

      </section>



      <!-- FORMULES -->
      <section class="formulas-section">

        <div class="section-heading">

          <p class="eyebrow">
            Choisir son accompagnement
          </p>

          <h2>
            Deux façons de louer une malle
          </h2>

          <p class="section-intro">
            Les deux formules comprennent l’envoi postal du livret imprimé
            après confirmation et paiement, puis la mise à disposition de
            la malle pour la période convenue.
          </p>

        </div>

        <div class="formulas-grid">

          {
            formulas.map((formula, index) => (

              <article class="formula-card">

                <span class="formula-number">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <h3>
                  {formula.title}
                </h3>

                <p class="formula-subtitle">
                  {formula.subtitle}
                </p>

                <p class="formula-price">
                  {formula.price}
                </p>

                <p class="formula-text">
                  {formula.text}
                </p>

                <ul class="formula-features">
                  {formula.features.map((feature) => (
                    <li>{feature}</li>
                  ))}
                </ul>

              </article>

            ))
          }

        </div>

      </section>


      <!-- MALLE DISPONIBLE -->
      <section class="available">

        <div class="available-inner">


          <div class="available-text">

            <p class="eyebrow">
              Première malle disponible
            </p>

            <h2>
              Les oiseaux
            </h2>

            <p class="age">
              Pour les enfants de 3 à 5 ans
            </p>

            <p>
              Une malle pour écouter, observer,
              manipuler et découvrir les oiseaux
              à travers des histoires, des jeux,
              un mini-monde et différentes expériences.
            </p>

            <a
              class="text-link"
              href="/malle-les-oiseaux"
            >
              Découvrir le contenu de la malle
              <span aria-hidden="true">→</span>
            </a>

          </div>


          <div class="rental-card">

            <p class="small-title">
              Location
            </p>

            <h3>
              Malle « Les oiseaux »
            </h3>


            <div class="rental-information">

              <div>
                <span>Public</span>
                <strong>3–5 ans</strong>
              </div>

              <div>
                <span>Préparation</span>
                <strong>Livret imprimé envoyé après paiement</strong>
              </div>

              <div>
                <span>Durées proposées</span>
                <strong>1, 2 ou 4 semaines consécutives</strong>
              </div>

              <div>
                <span>Remise de la malle</span>
                <strong>Le vendredi précédent</strong>
              </div>

              <div>
                <span>Tarif</span>
                <strong>À partir de 200 €</strong>
              </div>

              <div>
                <span>Formule</span>
                <strong>Autonome ou avec accompagnement d’équipe</strong>
              </div>

              <div>
                <span>Zone desservie</span>
                <strong>Pays de la Loire</strong>
              </div>

              <div>
                <span>Disponibilité</span>
                <strong>Sur demande</strong>
              </div>

            </div>


            <a
              class="primary-button"
              href="/reserver-une-malle"
            >
              Faire une demande de location
              <span aria-hidden="true">→</span>
            </a>

          </div>

        </div>

      </section>



      <!-- CE QUI EST COMPRIS -->
      <section class="included">

        <div class="included-inner">

          <div>

            <p class="eyebrow">
              Pendant la location
            </p>

            <h2>
              Tout est réuni
              dans la malle
            </h2>

          </div>


          <div class="included-list">

            <div class="included-item">

              <span>01</span>

              <p>
                <strong>Le matériel pédagogique</strong>
                Les éléments nécessaires aux différentes
                expériences sont regroupés dans la malle.
              </p>

            </div>


            <div class="included-item">

              <span>02</span>

              <p>
                <strong>Le livret pédagogique en amont</strong>
                Il est envoyé imprimé par la poste après confirmation
                et paiement, pour vous permettre de préparer les animations
                avant l’arrivée de la malle. Les frais d’envoi sont inclus.
                <strong>Le livret reste un élément de la location et doit être
                remis dans la malle lors de la restitution.</strong>
              </p>

            </div>


            <div class="included-item">

              <span>03</span>

              <p>
                <strong>Les supports</strong>
                Livres, éléments visuels, matériel sensoriel
                et supports nécessaires aux activités.
              </p>

            </div>


            <div class="included-item">

              <span>04</span>

              <p>
                <strong>Des prolongements dehors</strong>
                Des invitations pour poursuivre les découvertes
                dans l’environnement réel.
              </p>

            </div>

          </div>

        </div>

      </section>



      <!-- PAIEMENT -->
      <section class="payment-section">

        <div class="payment-inner">

          <div class="payment-text">

            <p class="eyebrow">
              Réservation et règlement
            </p>

            <h2>
              Le paiement intervient
              après confirmation
            </h2>

            <p>
              Avant tout règlement, je vérifie avec vous
              la disponibilité de la malle, la semaine souhaitée
              et la formule choisie.
            </p>

            <p>
              Une fois la réservation confirmée,
              vous recevrez le lien permettant
              d’effectuer le paiement en ligne. Le livret imprimé
              sera ensuite envoyé par la poste.
            </p>

          </div>


          <div class="payment-card">

            <span class="payment-icon">
              €
            </span>

            <h3>
              Paiement sécurisé en ligne
            </h3>

            <p>
              Le module de paiement sera disponible
              une fois votre demande de location validée.
            </p>

            <button
              type="button"
              disabled
            >
              Paiement après confirmation
            </button>

            <small>
              Aucun paiement n’est demandé
              avant la validation des dates.
            </small>

          </div>

        </div>

      </section>



      <!-- RESTITUTION -->
      <section class="return-section">

        <div class="return-inner">

          <p class="eyebrow">
            Après l’utilisation
          </p>

          <h2>
            Une malle faite pour circuler
          </h2>

          <p>
            Chaque utilisateur contribue à préserver
            le matériel pour les groupes suivants.
            Avant la restitution, il suffit de replacer
            les différents éléments dans la malle
            et de signaler si un objet a été perdu
            ou endommagé.
          </p>

        </div>

      </section>



      <!-- CONDITIONS -->
      <section class="conditions-teaser">
        <div class="conditions-teaser-inner">
          <div>
            <p class="eyebrow">Avant de réserver</p>
            <h2>Un cadre clair pour la location</h2>
            <p>
              Retrouvez les règles de réservation, d’annulation, de restitution,
              de sécurité et les modalités en cas de perte ou de casse.
            </p>
          </div>
          <a class="text-link conditions-link" href="/conditions-location">
            Lire les conditions de location
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>


      <!-- APPEL À L'ACTION -->
      <section class="cta">

        <div class="cta-inner">

          <p class="eyebrow light">
            Vous êtes intéressé ?
          </p>

          <h2>
            Une malle pourrait rejoindre
            votre structure
          </h2>

          <p>
            Envoyez simplement votre demande
            avec les dates envisagées.
          </p>

          <a
            class="cta-button"
            href="/reserver-une-malle"
          >
            Demander une location
            <span aria-hidden="true">→</span>
          </a>

        </div>

      </section>


    </main>



    <!-- FOOTER -->
    <SiteFooter />



    <script is:inline>
      const durationCards = document.querySelectorAll(".duration-card[data-duration]");
      const pricingReservationLink = document.getElementById("pricing-reservation-link");

      durationCards.forEach((card) => {
        card.addEventListener("click", () => {
          const duration = card.dataset.duration;

          durationCards.forEach((otherCard) => {
            const selected = otherCard === card;
            otherCard.classList.toggle("selected", selected);
            otherCard.setAttribute("aria-pressed", selected ? "true" : "false");
          });

          pricingReservationLink.href =
            "/reserver-une-malle?duration=" + encodeURIComponent(duration);
        });
      });
    </script>

    <style>


      /* BASE */

      :global(*) {
        box-sizing: border-box;
      }


      :global(html) {
        scroll-behavior: smooth;
      }


      :global(body) {
        margin: 0;

        background: #f9f7f2;
        color: #292b23;

        font-family:
          Georgia,
          "Times New Roman",
          serif;
      }



      /* HEADER */

      .site-header {
        min-height: 94px;

        padding: 15px 5.5%;

        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 40px;

        background: #f9f7f2;
      }


      .brand {
        display: flex;
        align-items: center;

        color: #29271f;

        text-decoration: none;
      }


      .brand-decoration {
        margin-right: 10px;

        font-size: 2.7rem;

        line-height: 1;

        color: #747b51;

        transform: rotate(-15deg);
      }


      .brand-text {
        display: flex;

        flex-direction: column;

        font-size: 1.55rem;

        line-height: 1.05;
      }


      nav {
        display: flex;

        align-items: center;

        gap: clamp(20px, 3vw, 45px);
      }


      nav a {
        color: #161713;

        text-decoration: none;

        font-size: 0.96rem;

        font-weight: 600;

        white-space: nowrap;
      }


      nav a:hover,
      nav a[aria-current="page"] {
        color: #687347;
      }



      /* COMMUN */

      .eyebrow {
        margin: 0 0 10px;

        color: #74785e;

        font-family:
          Arial,
          Helvetica,
          sans-serif;

        font-size: 0.73rem;

        line-height: 1.3;

        letter-spacing: 0.11em;

        text-transform: uppercase;
      }


      .eyebrow.light {
        color: rgba(255, 255, 255, 0.72);
      }



      /* HERO */

      .rental-hero {
        min-height: 320px;

        padding: 55px 5.5%;

        display: flex;

        align-items: center;

        justify-content: center;

        background: #596243;

        color: #fffdf8;

        text-align: center;
      }


      .hero-inner {
        max-width: 760px;

        margin: 0 auto;
      }


      .rental-hero h1 {
        margin: 4px 0 18px;

        font-size: clamp(3.4rem, 6vw, 5.7rem);

        line-height: 0.96;

        font-weight: 500;
      }


      .rental-hero p:last-child {
        max-width: 620px;

        margin: 0 auto;

        font-size: 1.1rem;

        line-height: 1.6;
      }



      /* INTRO */

      .intro {
        padding: 55px 5.5%;
      }


      .intro-inner {
        max-width: 760px;
      }


      .intro h2 {
        margin: 0 0 20px;

        max-width: 700px;

        font-size: clamp(2.2rem, 3.5vw, 3.1rem);

        line-height: 1.05;

        font-weight: 500;
      }


      .intro p {
        max-width: 720px;

        line-height: 1.7;
      }


      .intro .lead {
        font-size: 1.1rem;
      }



      /* TARIFS */

      .pricing-section {
        padding: 68px 5.5% 72px;
        background: #dfe3cf;
      }


      .pricing-heading {
        max-width: 780px;
        margin: 0 auto 34px;
        text-align: center;
      }


      .pricing-heading h2 {
        margin: 0 0 14px;
        font-size: clamp(2.2rem, 3.8vw, 3.35rem);
        line-height: 1.05;
        font-weight: 500;
      }


      .pricing-heading > p:last-child {
        max-width: 650px;
        margin: 0 auto;
        color: #55594a;
        line-height: 1.65;
      }

      .service-area {
        margin-top: 14px !important;
        color: #596243 !important;
        font-family: Arial, Helvetica, sans-serif;
        font-size: .9rem;
      }


      .duration-grid {
        max-width: 1080px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
      }


      .duration-card {
        width: 100%;
        padding: 30px;
        background: #f9f7f2;
        border: 1px solid rgba(89, 98, 67, 0.16);
        border-radius: 9px;
        color: inherit;
        text-align: left;
        cursor: pointer;
        font: inherit;
        transition: border-color .15s ease, box-shadow .15s ease, transform .15s ease;
      }

      .duration-card:hover {
        transform: translateY(-2px);
      }

      .duration-card.selected {
        border: 2px solid #7d8957;
        box-shadow: 0 0 0 2px rgba(125, 137, 87, .12);
      }


      .duration-label {
        margin: 0 0 12px;
        color: #596243;
        font: 700 0.8rem Arial, Helvetica, sans-serif;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }


      .duration-price {
        margin: 0 0 16px;
        color: #3f4731;
        font-size: clamp(2.5rem, 4vw, 3.5rem);
        line-height: 1;
        font-weight: 500;
      }


      .duration-card > p:last-child {
        margin: 0;
        color: #606157;
        font: 0.9rem/1.6 Arial, Helvetica, sans-serif;
      }


      .intervention-prices {
        max-width: 860px;
        margin: 26px auto 0;
        padding: 6px 24px;
        background: rgba(249, 247, 242, 0.72);
        border-radius: 8px;
      }


      .intervention-prices div {
        padding: 15px 0;
        display: flex;
        justify-content: space-between;
        gap: 25px;
        border-bottom: 1px solid rgba(89, 98, 67, 0.16);
      }


      .intervention-prices div:last-child {
        border-bottom: 0;
      }


      .intervention-prices span {
        font-family: Arial, Helvetica, sans-serif;
        color: #55594a;
      }


      .intervention-prices strong {
        color: #596243;
        white-space: nowrap;
      }


      .pricing-cta {
        max-width: 760px;
        margin: 28px auto 0;
        text-align: center;
      }


      .pricing-cta p {
        margin: 0 0 18px;
        line-height: 1.6;
      }


      /* ÉTAPES */

      .steps-section {
        padding: 70px 5.5%;

        background: #f1eee8;
      }


      .section-heading {
        max-width: 760px;

        margin: 0 auto 45px;

        text-align: center;
      }


      .section-heading h2 {
        margin: 0;

        font-size: clamp(2.2rem, 3.5vw, 3.1rem);

        font-weight: 500;
      }


      .steps-grid {
        max-width: 1120px;

        margin: 0 auto;

        display: grid;

        grid-template-columns:
          repeat(3, minmax(0, 1fr));

        gap: 22px;
      }


      .step-card {
        padding: 30px;

        background: #f9f7f2;

        border-radius: 7px;
      }


      .step-number {
        display: block;

        margin-bottom: 24px;

        color: #88906b;

        font-size: 1.9rem;
      }


      .step-card h3 {
        margin: 0 0 12px;

        font-size: 1.3rem;

        font-weight: 500;
      }


      .step-card p {
        margin: 0;

        color: #606157;

        font-family:
          Arial,
          Helvetica,
          sans-serif;

        font-size: 0.9rem;

        line-height: 1.6;
      }



      /* FORMULES */

      .formulas-section {
        padding: 70px 5.5%;
        background: #f9f7f2;
      }

      .section-intro {
        max-width: 700px;
        margin: 16px auto 0;
        color: #5d5e54;
        line-height: 1.65;
      }

      .formulas-grid {
        max-width: 900px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 26px;
        align-items: stretch;
      }

      .formula-card {
        min-height: 100%;
        padding: 34px;
        display: flex;
        flex-direction: column;
        background: #dfe3cf;
        border-radius: 8px;
      }

      .formula-number {
        display: block;
        margin-bottom: 22px;
        color: #7c8560;
        font-size: 1.7rem;
      }

      .formula-card h3 {
        margin: 0 0 8px;
        font-size: 1.45rem;
        font-weight: 500;
      }

      .formula-subtitle {
        margin: 0 0 10px;
        color: #596243;
        font-weight: 600;
      }

      .formula-price {
        margin: 0 0 16px;
        color: #3f4731;
        font: 700 1.12rem Arial, Helvetica, sans-serif;
      }

      .formula-text {
        margin: 0 0 18px;
        color: #56584d;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 0.9rem;
        line-height: 1.6;
      }

      .formula-features {
        margin: auto 0 0;
        padding: 18px 0 0 20px;
        border-top: 1px solid rgba(89, 98, 67, 0.18);
        color: #4f5545;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 0.86rem;
        line-height: 1.55;
      }

      .formula-features li + li {
        margin-top: 7px;
      }


      /* MALLE */

      .available {
        padding: 75px 5.5%;
      }


      .available-inner {
        max-width: 1100px;

        margin: 0 auto;

        display: grid;

        grid-template-columns:
          1fr
          0.8fr;

        gap: clamp(50px, 8vw, 100px);

        align-items: center;
      }


      .available-text h2 {
        margin: 0 0 12px;

        font-size: clamp(2.4rem, 4vw, 3.6rem);

        font-weight: 500;
      }


      .age {
        color: #6f7750;

        font-weight: 600;
      }


      .available-text p {
        max-width: 600px;

        line-height: 1.65;
      }


      .text-link {
        display: inline-flex;

        gap: 12px;

        margin-top: 10px;

        color: #596243;

        font-weight: 600;

        text-decoration: none;
      }


      .rental-card {
        padding: 38px;

        background: #dfe3cf;

        border-radius: 8px;
      }


      .small-title {
        margin: 0 0 8px;

        color: #6b7353;

        font-family:
          Arial,
          Helvetica,
          sans-serif;

        font-size: 0.72rem;

        letter-spacing: 0.1em;

        text-transform: uppercase;
      }


      .rental-card h3 {
        margin: 0 0 28px;

        font-size: 1.8rem;

        font-weight: 500;
      }


      .rental-information {
        margin-bottom: 28px;
      }


      .rental-information div {
        padding: 14px 0;

        display: flex;

        justify-content: space-between;

        gap: 20px;

        border-bottom:
          1px solid
          rgba(89, 98, 67, 0.18);
      }


      .rental-information span {
        font-family:
          Arial,
          Helvetica,
          sans-serif;

        font-size: 0.82rem;

        color: #606654;
      }


      .rental-information strong {
        font-weight: 500;

        text-align: right;
      }



      /* BOUTON */

      .primary-button,
      .cta-button {
        display: inline-flex;

        align-items: center;

        gap: 14px;

        padding: 12px 18px;

        border-radius: 4px;

        background: #7d8957;

        color: #fff;

        text-decoration: none;

        font-weight: 600;
      }


      .primary-button:hover,
      .cta-button:hover {
        background: #69754a;
      }



      /* CE QUI EST COMPRIS */

      .included {
        padding: 75px 5.5%;

        background: #ece9e1;
      }


      .included-inner {
        max-width: 1050px;

        margin: 0 auto;

        display: grid;

        grid-template-columns:
          0.85fr
          1.15fr;

        gap: 70px;
      }


      .included h2 {
        margin: 0;

        font-size: clamp(2.2rem, 3.5vw, 3rem);

        line-height: 1.05;

        font-weight: 500;
      }


      .included-item {
        padding: 20px 0;

        display: grid;

        grid-template-columns:
          45px
          1fr;

        gap: 18px;

        border-bottom:
          1px solid
          #d1cec5;
      }


      .included-item > span {
        color: #88906b;
      }


      .included-item p {
        margin: 0;

        color: #5d5e54;

        line-height: 1.6;
      }


      .included-item strong {
        display: block;

        margin-bottom: 4px;

        color: #292b23;
      }



      /* PAIEMENT */

      .payment-section {
        padding: 75px 5.5%;
      }


      .payment-inner {
        max-width: 1050px;

        margin: 0 auto;

        display: grid;

        grid-template-columns:
          1fr
          0.8fr;

        gap: 70px;

        align-items: center;
      }


      .payment-text h2 {
        margin: 0 0 20px;

        font-size: clamp(2.2rem, 3.5vw, 3rem);

        line-height: 1.05;

        font-weight: 500;
      }


      .payment-text p {
        max-width: 600px;

        line-height: 1.65;
      }


      .payment-card {
        padding: 36px;

        background: #f1eee8;

        border-radius: 8px;

        text-align: center;
      }


      .payment-icon {
        display: grid;

        width: 58px;

        height: 58px;

        margin: 0 auto 20px;

        place-items: center;

        border-radius: 50%;

        background: #dfe3cf;

        color: #596243;

        font-size: 1.5rem;
      }


      .payment-card h3 {
        margin: 0 0 14px;

        font-size: 1.45rem;

        font-weight: 500;
      }


      .payment-card p {
        line-height: 1.55;
      }


      .payment-card button {
        width: 100%;

        margin: 12px 0 15px;

        padding: 13px 17px;

        border: 0;

        border-radius: 4px;

        background: #b5b7aa;

        color: #fff;

        cursor: not-allowed;

        font-weight: 600;
      }


      .payment-card small {
        display: block;

        color: #77786f;

        font-family:
          Arial,
          Helvetica,
          sans-serif;

        font-size: 0.75rem;

        line-height: 1.5;
      }



      /* RESTITUTION */

      .return-section {
        padding: 65px 24px;

        background: #dfe3cf;

        text-align: center;
      }


      .return-inner {
        max-width: 720px;

        margin: 0 auto;
      }


      .return-inner h2 {
        margin: 0 0 18px;

        font-size: clamp(2.1rem, 3.5vw, 3rem);

        font-weight: 500;
      }


      .return-inner p:last-child {
        margin: 0;

        line-height: 1.7;
      }



      /* CONDITIONS */

      .conditions-teaser {
        padding: 55px 5.5%;
        background: #f3f0e9;
      }

      .conditions-teaser-inner {
        max-width: 1000px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 35px;
      }

      .conditions-teaser h2 {
        margin: 0 0 12px;
        font-size: clamp(1.9rem, 3vw, 2.5rem);
        font-weight: 500;
      }

      .conditions-teaser p:not(.eyebrow) {
        max-width: 650px;
        margin: 0;
        line-height: 1.6;
      }

      .conditions-link {
        flex: 0 0 auto;
      }


      /* CTA */

      .cta {
        padding: 75px 24px;

        background: #596243;

        color: #fffdf8;

        text-align: center;
      }


      .cta-inner {
        max-width: 720px;

        margin: 0 auto;
      }


      .cta h2 {
        margin: 0 0 18px;

        font-size: clamp(2.2rem, 4vw, 3.4rem);

        line-height: 1.05;

        font-weight: 500;
      }


      .cta p:not(.eyebrow) {
        margin: 0 0 25px;

        line-height: 1.6;
      }


      .cta-button {
        background: #f4f0e7;

        color: #4c543a;
      }


      .cta-button:hover {
        background: #fff;
      }



      /* FOOTER */

      footer {
        padding: 46px 5.5%;

        background: #303428;

        color: #f5f2e9;

        text-align: center;
      }


      .footer-brand {
        color: inherit;

        text-decoration: none;

        font-size: 1.35rem;
      }


      footer p {
        margin: 10px 0 22px;

        color:
          rgba(
            255,
            255,
            255,
            0.7
          );

        font-size: 0.9rem;
      }


      footer small {
        color:
          rgba(
            255,
            255,
            255,
            0.5
          );

        font:
          0.7rem
          Arial,
          Helvetica,
          sans-serif;
      }



      /* TABLETTE */

      @media (max-width: 900px) {

        .site-header {
          flex-direction: column;

          gap: 20px;
        }


        nav {
          flex-wrap: wrap;

          justify-content: center;
        }


        .steps-grid {
          grid-template-columns:
            repeat(2, minmax(0, 1fr));
        }

        .formulas-grid,
        .duration-grid {
          grid-template-columns: 1fr;
        }

        .formulas-grid {
          max-width: 620px;
        }


        .available-inner,
        .included-inner,
        .payment-inner {
          grid-template-columns: 1fr;
        }

      }



      /* MOBILE */

      @media (max-width: 650px) {

        .site-header {
          padding: 16px 22px;
        }


        nav {
          gap: 10px 18px;
        }


        nav a {
          font-size: 0.86rem;
        }


        .rental-hero {
          min-height: 275px;

          padding: 45px 24px;
        }


        .intro {
          padding: 45px 24px;
        }


        .steps-section {
          padding: 55px 24px;
        }

        .formulas-section,
        .pricing-section {
          padding: 55px 24px;
        }

        .intervention-prices {
          padding: 5px 18px;
        }

        .intervention-prices div {
          flex-direction: column;
          gap: 5px;
        }


        .steps-grid {
          grid-template-columns: 1fr;
        }


        .available,
        .included,
        .payment-section {
          padding:
            55px
            24px;
        }


        .rental-card,
        .payment-card {
          padding: 28px 23px;
        }


        .rental-information div {
          flex-direction: column;

          gap: 5px;
        }


        .rental-information strong {
          text-align: left;
        }

      }

    </style>


  </body>

</html>
