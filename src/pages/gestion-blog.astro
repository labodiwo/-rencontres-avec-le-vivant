---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Gestion du blog · Rencontres avec le vivant</title>
  </head>

  <body>
    <main>
      <section class="hero">
        <p class="eyebrow">Espace privé</p>
        <h1>Gestion du blog</h1>
        <p>Créez, modifiez et publiez vos articles sans toucher au code du site.</p>
      </section>

      <section class="wrap">
        <div id="login-card" class="login-card">
          <h2>Accéder au blog</h2>
          <p>Entrez votre mot de passe administrateur.</p>
          <form id="login-form">
            <label for="admin-password">Mot de passe</label>
            <input id="admin-password" type="password" autocomplete="current-password" required />
            <button type="submit">Ouvrir la gestion</button>
          </form>
          <p id="login-status" class="status" role="status"></p>
        </div>

        <div id="panel" hidden>
          <div class="topbar">
            <div>
              <p class="eyebrow">Nouvel article</p>
              <h2 id="form-title">Écrire un article</h2>
            </div>
            <button id="new-post" type="button" class="secondary">Nouvel article</button>
          </div>

          <form id="post-form" class="post-form">
            <input id="post-slug" type="hidden" />

            <div class="field">
              <label for="title">Titre *</label>
              <input id="title" type="text" required />
            </div>

            <div class="field-row">
              <div class="field">
                <label for="category">Catégorie</label>
                <input id="category" type="text" placeholder="Pédagogie, Coulisses…" />
              </div>
              <div class="field">
                <label for="date">Date</label>
                <input id="date" type="date" />
              </div>
            </div>

            <div class="field">
              <label for="excerpt">Résumé *</label>
              <textarea id="excerpt" rows="3" maxlength="500" required placeholder="Quelques lignes qui apparaîtront sur la page du blog."></textarea>
            </div>

            <div class="field">
              <label for="content">Contenu de l’article *</label>
              <textarea id="content" rows="16" required placeholder="Écrivez votre article ici. Séparez les paragraphes par une ligne vide."></textarea>
            </div>

            <div class="image-fields">
              <div class="field">
                <label for="cover-image">Photo principale</label>
                <input id="cover-image" type="file" accept="image/jpeg,image/png,image/webp" />
                <small>Elle apparaîtra sur la carte du blog et en haut de l’article.</small>
                <div id="cover-preview" class="image-preview"></div>
                <label class="caption-label" for="cover-caption">Légende de la photo</label>
                <input id="cover-caption" type="text" maxlength="300" placeholder="Ex. Mini-monde de la malle « Les oiseaux »" />
              </div>

              <div class="field">
                <label for="gallery-images">Autres photos</label>
                <input id="gallery-images" type="file" accept="image/jpeg,image/png,image/webp" multiple />
                <small>Jusqu’à 6 photos supplémentaires, affichées à la fin de l’article.</small>
                <div id="gallery-preview" class="gallery-preview"></div>
              </div>
            </div>

            <div class="field">
              <label for="status-select">Statut</label>
              <select id="status-select">
                <option value="draft">Brouillon</option>
                <option value="published">Publié</option>
              </select>
            </div>

            <div class="actions">
              <button type="submit">Enregistrer</button>
              <button id="cancel-edit" type="button" class="secondary" hidden>Annuler la modification</button>
            </div>

            <p id="save-status" class="status" role="status"></p>
          </form>

          <section class="posts-section">
            <div class="posts-heading">
              <p class="eyebrow">Vos contenus</p>
              <h2>Articles enregistrés</h2>
            </div>
            <div id="posts-list" class="posts-list"></div>
          </section>
        </div>
      </section>
    </main>

    <script is:inline>
      const loginCard = document.getElementById("login-card");
      const loginForm = document.getElementById("login-form");
      const passwordInput = document.getElementById("admin-password");
      const loginStatus = document.getElementById("login-status");
      const panel = document.getElementById("panel");
      const form = document.getElementById("post-form");
      const postsList = document.getElementById("posts-list");
      const saveStatus = document.getElementById("save-status");
      const formTitle = document.getElementById("form-title");
      const cancelEdit = document.getElementById("cancel-edit");
      const newPostButton = document.getElementById("new-post");
      const coverImageInput = document.getElementById("cover-image");
      const galleryImagesInput = document.getElementById("gallery-images");
      const coverPreview = document.getElementById("cover-preview");
      const galleryPreview = document.getElementById("gallery-preview");
      const coverCaptionInput = document.getElementById("cover-caption");

      let adminKey = "";
      let posts = [];
      let existingCoverImageId = "";
      let existingCoverCaption = "";
      let existingGalleryImageIds = [];
      let existingGalleryCaptions = [];

      const fields = {
        slug: document.getElementById("post-slug"),
        title: document.getElementById("title"),
        category: document.getElementById("category"),
        date: document.getElementById("date"),
        excerpt: document.getElementById("excerpt"),
        content: document.getElementById("content"),
        status: document.getElementById("status-select"),
      };

      const today = () => {
        const now = new Date();
        const y = now.getFullYear();
        const m = String(now.getMonth() + 1).padStart(2, "0");
        const d = String(now.getDate()).padStart(2, "0");
        return `${y}-${m}-${d}`;
      };

      const resetForm = () => {
        form.reset();
        fields.slug.value = "";
        fields.date.value = today();
        fields.status.value = "draft";
        formTitle.textContent = "Écrire un article";
        cancelEdit.hidden = true;
        saveStatus.textContent = "";
        existingCoverImageId = "";
        existingCoverCaption = "";
        existingGalleryImageIds = [];
        existingGalleryCaptions = [];
        coverCaptionInput.value = "";
        coverPreview.innerHTML = "";
        galleryPreview.innerHTML = "";
      };

      const escapeHtml = (value) =>
        String(value ?? "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");

      const renderPosts = () => {
        if (!posts.length) {
          postsList.innerHTML = '<p class="empty">Aucun article enregistré pour le moment.</p>';
          return;
        }

        postsList.innerHTML = posts.map((post) => `
          <article class="post-card">
            <div>
              <span class="post-status ${post.status}">${post.status === "published" ? "Publié" : "Brouillon"}</span>
              <h3>${escapeHtml(post.title)}</h3>
              <p>${escapeHtml(post.category || "Sans catégorie")} · ${escapeHtml(post.date || "")}</p>
            </div>
            <div class="post-actions">
              <button type="button" data-edit="${escapeHtml(post.slug)}">Modifier</button>
              <button type="button" data-delete="${escapeHtml(post.slug)}" class="danger">Supprimer</button>
            </div>
          </article>
        `).join("");

        postsList.querySelectorAll("[data-edit]").forEach((button) => {
          button.addEventListener("click", () => editPost(button.dataset.edit));
        });

        postsList.querySelectorAll("[data-delete]").forEach((button) => {
          button.addEventListener("click", () => deletePost(button.dataset.delete));
        });
      };

      const loadPosts = async () => {
        const response = await fetch("/api/admin/blog", {
          headers: { "x-admin-key": adminKey },
        });
        const result = await response.json();
        if (!response.ok || !result.ok) throw new Error(result.error || "Accès impossible.");
        posts = result.posts || [];
        renderPosts();
      };

      const editPost = (slug) => {
        const post = posts.find((item) => item.slug === slug);
        if (!post) return;

        fields.slug.value = post.slug;
        fields.title.value = post.title || "";
        fields.category.value = post.category || "";
        fields.date.value = post.date || today();
        fields.excerpt.value = post.excerpt || "";
        fields.content.value = post.content || "";
        fields.status.value = post.status || "draft";
        existingCoverImageId = post.coverImageId || "";
        existingCoverCaption = post.coverCaption || "";
        existingGalleryImageIds = Array.isArray(post.galleryImageIds)
          ? [...post.galleryImageIds]
          : [];
        existingGalleryCaptions = Array.isArray(post.galleryCaptions)
          ? [...post.galleryCaptions]
          : existingGalleryImageIds.map(() => "");
        coverCaptionInput.value = existingCoverCaption;
        renderExistingImages();
        formTitle.textContent = "Modifier l’article";
        cancelEdit.hidden = false;
        form.scrollIntoView({ behavior: "smooth", block: "start" });
      };


      const compressImage = (file) =>
        new Promise((resolve, reject) => {
          const image = new Image();
          const objectUrl = URL.createObjectURL(file);

          image.onload = () => {
            try {
              const maxWidth = 1600;
              const maxHeight = 1600;
              const ratio = Math.min(
                1,
                maxWidth / image.width,
                maxHeight / image.height,
              );

              const width = Math.round(image.width * ratio);
              const height = Math.round(image.height * ratio);
              const canvas = document.createElement("canvas");
              canvas.width = width;
              canvas.height = height;

              const context = canvas.getContext("2d");
              context.drawImage(image, 0, 0, width, height);

              canvas.toBlob(
                (blob) => {
                  URL.revokeObjectURL(objectUrl);
                  if (!blob) {
                    reject(new Error("Impossible de préparer cette photo."));
                    return;
                  }
                  resolve(blob);
                },
                "image/jpeg",
                0.82,
              );
            } catch (error) {
              URL.revokeObjectURL(objectUrl);
              reject(error);
            }
          };

          image.onerror = () => {
            URL.revokeObjectURL(objectUrl);
            reject(new Error("Cette photo ne peut pas être lue."));
          };

          image.src = objectUrl;
        });

      const uploadImage = async (file) => {
        const blob = await compressImage(file);

        if (blob.size > 1600000) {
          throw new Error("Une photo reste trop volumineuse après compression.");
        }

        const response = await fetch("/api/admin/blog-image", {
          method: "POST",
          headers: {
            "content-type": blob.type || "image/jpeg",
            "x-admin-key": adminKey,
          },
          body: blob,
        });

        const result = await response.json();

        if (!response.ok || !result.ok || !result.imageId) {
          throw new Error(result.error || "L’envoi d’une photo a échoué.");
        }

        return result.imageId;
      };

      const renderExistingImages = () => {
        coverPreview.innerHTML = existingCoverImageId
          ? `
            <div class="preview-item">
              <img src="/api/blog-image/${encodeURIComponent(existingCoverImageId)}" alt="" />
              <button type="button" data-remove-cover>Retirer</button>
            </div>
          `
          : "";

        galleryPreview.innerHTML = existingGalleryImageIds
          .map(
            (imageId, index) => `
              <div class="gallery-editor-item">
                <div class="preview-item">
                  <img src="/api/blog-image/${encodeURIComponent(imageId)}" alt="" />
                  <button type="button" data-remove-gallery="${escapeHtml(imageId)}">Retirer</button>
                </div>
                <input
                  type="text"
                  maxlength="300"
                  data-gallery-caption-index="${index}"
                  value="${escapeHtml(existingGalleryCaptions[index] || "")}"
                  placeholder="Légende de la photo"
                />
              </div>
            `,
          )
          .join("");

        const removeCover = coverPreview.querySelector("[data-remove-cover]");
        if (removeCover) {
          removeCover.addEventListener("click", () => {
            existingCoverImageId = "";
            existingCoverCaption = "";
            coverCaptionInput.value = "";
            coverPreview.innerHTML = "";
          });
        }

        galleryPreview
          .querySelectorAll("[data-remove-gallery]")
          .forEach((button) => {
            button.addEventListener("click", () => {
              const index = existingGalleryImageIds.indexOf(
                button.dataset.removeGallery,
              );

              if (index >= 0) {
                existingGalleryImageIds.splice(index, 1);
                existingGalleryCaptions.splice(index, 1);
              }

              renderExistingImages();
            });
          });

        galleryPreview
          .querySelectorAll("[data-gallery-caption-index]")
          .forEach((input) => {
            input.addEventListener("input", () => {
              const index = Number(input.dataset.galleryCaptionIndex);
              existingGalleryCaptions[index] = input.value;
            });
          });
      };

      coverImageInput.addEventListener("change", () => {
        const file = coverImageInput.files?.[0];
        if (!file) return;

        const url = URL.createObjectURL(file);
        coverPreview.innerHTML = `
          <div class="preview-item">
            <img src="${url}" alt="Aperçu de la photo principale" />
            <span>Nouvelle photo</span>
          </div>
        `;
      });

      galleryImagesInput.addEventListener("change", () => {
        const files = Array.from(galleryImagesInput.files || []).slice(
          0,
          Math.max(0, 6 - existingGalleryImageIds.length),
        );

        const existingHtml = galleryPreview.innerHTML;

        const newHtml = files
          .map((file, index) => {
            const url = URL.createObjectURL(file);
            return `
              <div class="gallery-editor-item new-gallery-item" data-new-gallery-index="${index}">
                <div class="preview-item">
                  <img src="${url}" alt="Aperçu d’une photo" />
                  <span>Nouvelle photo</span>
                </div>
                <input
                  type="text"
                  maxlength="300"
                  data-new-gallery-caption="${index}"
                  placeholder="Légende de la photo"
                />
              </div>
            `;
          })
          .join("");

        galleryPreview.innerHTML = existingHtml + newHtml;
      });

      const deletePost = async (slug) => {
        if (!confirm("Supprimer définitivement cet article ?")) return;

        const response = await fetch("/api/admin/blog", {
          method: "DELETE",
          headers: {
            "content-type": "application/json",
            "x-admin-key": adminKey,
          },
          body: JSON.stringify({ slug }),
        });

        const result = await response.json();
        if (!response.ok || !result.ok) {
          saveStatus.textContent = result.error || "Suppression impossible.";
          return;
        }

        posts = result.posts || [];
        resetForm();
        renderPosts();
        saveStatus.textContent = "Article supprimé.";
      };

      loginForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        adminKey = passwordInput.value;
        loginStatus.textContent = "Vérification…";

        try {
          await loadPosts();
          passwordInput.value = "";
          loginCard.hidden = true;
          panel.hidden = false;
          resetForm();
        } catch (error) {
          adminKey = "";
          loginStatus.textContent = error.message || "Mot de passe incorrect.";
        }
      });

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        saveStatus.textContent = "Enregistrement…";

        try {
          let coverImageId = existingCoverImageId;
          let coverCaption = coverCaptionInput.value.trim();
          const coverFile = coverImageInput.files?.[0];

          if (coverFile) {
            saveStatus.textContent = "Envoi de la photo principale…";
            coverImageId = await uploadImage(coverFile);
          }

          let galleryImageIds = [...existingGalleryImageIds];
          let galleryCaptions = [...existingGalleryCaptions];
          const galleryFiles = Array.from(
            galleryImagesInput.files || [],
          ).slice(0, Math.max(0, 6 - galleryImageIds.length));

          for (let index = 0; index < galleryFiles.length; index += 1) {
            saveStatus.textContent =
              `Envoi des photos… ${index + 1}/${galleryFiles.length}`;
            const imageId = await uploadImage(galleryFiles[index]);
            galleryImageIds.push(imageId);

            const captionInput = galleryPreview.querySelector(
              `[data-new-gallery-caption="${index}"]`,
            );
            galleryCaptions.push(captionInput?.value.trim() || "");
          }

          const payload = {
            slug: fields.slug.value,
            title: fields.title.value,
            category: fields.category.value,
            date: fields.date.value,
            excerpt: fields.excerpt.value,
            content: fields.content.value,
            status: fields.status.value,
            coverImageId,
            coverCaption,
            galleryImageIds,
            galleryCaptions,
          };

          saveStatus.textContent = "Enregistrement de l’article…";

          const response = await fetch("/api/admin/blog", {
          method: "POST",
          headers: {
            "content-type": "application/json",
            "x-admin-key": adminKey,
          },
          body: JSON.stringify(payload),
        });

          const result = await response.json();

          if (!response.ok || !result.ok) {
            throw new Error(result.error || "Enregistrement impossible.");
          }

          posts = result.posts || [];
          resetForm();
          renderPosts();
          saveStatus.textContent = "Article enregistré.";
        } catch (error) {
          saveStatus.textContent =
            error.message || "Enregistrement impossible.";
        }
      });

      cancelEdit.addEventListener("click", resetForm);
      newPostButton.addEventListener("click", () => {
        resetForm();
        form.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    </script>

    <style>
      :global(*){box-sizing:border-box}:global(body){margin:0;background:#f9f7f2;color:#292b23;font-family:Georgia,"Times New Roman",serif}.hero{padding:65px 24px 55px;background:#596243;color:#fff;text-align:center}.eyebrow{margin:0 0 10px;color:#74785e;font:700 .73rem Arial,Helvetica,sans-serif;letter-spacing:.11em;text-transform:uppercase}.hero .eyebrow{color:rgba(255,255,255,.72)}.hero h1{margin:0 0 15px;font-size:clamp(2.7rem,6vw,4.8rem);font-weight:500}.hero p:last-child{max-width:650px;margin:0 auto;line-height:1.6}.wrap{width:min(980px,90%);margin:0 auto;padding:55px 0 85px}
      .login-card{max-width:520px;margin:0 auto;padding:32px;background:#fffefa;border:1px solid #dedbd2;border-radius:9px}.login-card h2{margin:0 0 10px;font-size:1.8rem;font-weight:500}.login-card label,.field label{display:block;margin-bottom:8px;font:600 .84rem Arial,Helvetica,sans-serif}.login-card input,.field input,.field textarea,.field select{width:100%;padding:13px 14px;border:1px solid #cac7bd;border-radius:4px;background:#fff;font:1rem Arial,Helvetica,sans-serif}.login-card button,.post-form button,.topbar button,.post-actions button{min-height:44px;padding:10px 16px;border:0;border-radius:4px;background:#7d8957;color:#fff;cursor:pointer;font-weight:700}.login-card button{width:100%;margin-top:14px}
      .topbar{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:24px}.topbar h2,.posts-heading h2{margin:0;font-size:2rem;font-weight:500}.secondary{background:#ece9e1!important;color:#4f5248!important;border:1px solid #cfcac0!important}.post-form{padding:30px;background:#efede6;border-radius:8px}.field{margin-bottom:20px}.field small{display:block;margin-top:7px;color:#77786f;font: .75rem/1.45 Arial,Helvetica,sans-serif}.image-fields{margin:26px 0;padding:22px;background:#f7f5ef;border:1px solid #d9d5ca;border-radius:7px}.image-preview,.gallery-preview{display:flex;flex-wrap:wrap;gap:10px;margin-top:12px}.preview-item{position:relative;width:120px}.preview-item img{display:block;width:120px;height:90px;object-fit:cover;border-radius:5px}.preview-item button{position:absolute;right:5px;bottom:5px;min-height:0!important;padding:5px 7px!important;background:rgba(48,52,40,.9)!important;font-size:.7rem!important}.preview-item span{display:block;margin-top:5px;color:#77786f;font: .68rem Arial,Helvetica,sans-serif}.caption-label{margin-top:12px!important}.gallery-editor-item{width:180px}.gallery-editor-item .preview-item{width:100%}.gallery-editor-item .preview-item img{width:100%;height:110px}.gallery-editor-item input{width:100%;margin-top:8px;padding:9px 10px;border:1px solid #cac7bd;border-radius:4px;background:#fff;font:.82rem Arial,Helvetica,sans-serif}.field-row{display:grid;grid-template-columns:1fr 1fr;gap:18px}.actions{display:flex;gap:10px;flex-wrap:wrap}.status{min-height:22px;margin:14px 0 0;color:#596243}.posts-section{margin-top:55px}.posts-heading{margin-bottom:20px}.posts-list{display:grid;gap:12px}:global(.post-card){display:flex;justify-content:space-between;align-items:center;gap:20px;padding:20px;background:#fffefa;border:1px solid #dedbd2;border-radius:7px}:global(.post-card h3){margin:7px 0 5px;font-size:1.2rem;font-weight:500}:global(.post-card p){margin:0;color:#71736a;font: .78rem Arial,Helvetica,sans-serif}:global(.post-status){font:700 .68rem Arial,Helvetica,sans-serif;text-transform:uppercase;letter-spacing:.05em}:global(.post-status.published){color:#4f6b35}:global(.post-status.draft){color:#9b6a21}:global(.post-actions){display:flex;gap:8px;flex:0 0 auto}:global(.post-actions button){background:#7d8957}:global(.post-actions .danger){background:#8a655b}.empty{color:#71736a}
      @media(max-width:650px){.wrap{width:92%;padding-top:35px}.field-row{grid-template-columns:1fr}.topbar,:global(.post-card){align-items:stretch;flex-direction:column}:global(.post-actions){width:100%}:global(.post-actions button){flex:1}}
    </style>
  </body>
</html>
