        border:1px solid #cdbbb6!important;
      }

      .inline-status {
        color:#596243;
        font:.8rem Arial,Helvetica,sans-serif;
      }

      .toolbar {
        display:grid;
        grid-template-columns:48px 1fr 48px;
        align-items:center;
        gap:16px;
        margin-bottom:18px;
      }

      .toolbar>div { text-align:center; }

      .toolbar span {
        display:block;
        color:#85867d;
        font:.68rem Arial,Helvetica,sans-serif;
        letter-spacing:.08em;
        text-transform:uppercase;
      }

      .toolbar strong {
        display:block;
        margin-top:4px;
        font-size:1.5rem;
        font-weight:500;
        text-transform:capitalize;
      }

      .month-button {
        width:46px;
        height:46px;
        border:1px solid #cac7bd;
        border-radius:50%;
        background:#fff;
        color:#596243;
        cursor:pointer;
        font-size:1.2rem;
      }

      .month-button:disabled { opacity:.35; cursor:not-allowed; }

      .legend {
        display:flex;
        justify-content:center;
        flex-wrap:wrap;
        gap:18px;
        margin-bottom:22px;
        color:#64665c;
        font:.8rem Arial,Helvetica,sans-serif;
      }

      .legend span { display:inline-flex; align-items:center; gap:7px; }
      .dot { width:10px; height:10px; border-radius:50%; }
      .dot.available { background:#5f8a3f; }
      .dot.pending { background:#c59e5d; }
      .dot.booked { background:#9b9b92; }
      .weeks { display:grid; gap:12px; }

      .week-card {
        padding:18px;
        border:1px solid #dedbd2;
        border-radius:8px;
        background:#fffefa;
      }

      .week-card.available { border-color:#a8b88f; background:#e6efdd; }
      .week-card.pending { border-color:#d3bb91; background:#f7efdf; }
      .week-card.booked { background:#f0efeb; }

      .week-info {
        display:flex;
        align-items:baseline;
        justify-content:space-between;
        gap:16px;
        margin-bottom:14px;
      }

      .week-info strong { font-size:1rem; }

      .current-status {
        flex:0 0 auto;
        font:700 .76rem Arial,Helvetica,sans-serif;
        text-transform:uppercase;
      }

      .available .current-status { color:#3f642c; }
      .pending .current-status { color:#9b6a21; }
      .booked .current-status { color:#6f7068; }

      .status-actions {
        display:grid;
        grid-template-columns:repeat(3,minmax(0,1fr));
        gap:8px;
      }

      .status-actions button {
        min-height:44px;
        padding:10px;
        border:1px solid #c9c7bf;
        border-radius:5px;
        background:#fff;
        color:#45473f;
        cursor:pointer;
        font:600 .8rem Arial,Helvetica,sans-serif;
      }

      .status-actions button.active {
        border-color:#596243;
        background:#596243;
        color:#fff;
      }

      .status {
        min-height:22px;
        margin:14px 0 0;
        color:#596243;
        line-height:1.5;
      }

      .save-status { text-align:center; }

      @media (max-width:980px) {
        .admin-wrap { width:94%; }
        .request-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
        .management-grid { grid-template-columns:1fr; }
        .planning-card { grid-template-columns:190px 1fr; }
        .request-head { gap:18px; }
        .request-date { min-width:210px; }
      }

      @media (max-width:760px) {
        .hero { padding:34px 20px 30px; }
        .admin-wrap { width:94%; padding-top:24px; }
        .dashboard-summary { grid-template-columns:1fr; }
        .planning-card { grid-template-columns:1fr; }
        .planning-date { padding:17px 20px; border-right:0; border-bottom:1px solid #dce1ca; }
        .planning-main { padding:20px; }
        .planning-top,
        .request-head { flex-direction:column; }
        .request-date { min-width:0; max-width:none; width:100%; }
        .planning-details,
        .request-grid { grid-template-columns:1fr; }
        .management-grid { grid-template-columns:1fr; }
        .tabs { margin-bottom:18px; }
        .tab { min-width:135px; flex:0 0 auto; }
        .week-info { display:block; }
        .current-status { display:block; margin-top:6px; }
        .status-actions { grid-template-columns:1fr; }
      }


      .editor-note {
        margin: 0 0 24px;
        padding: 15px 17px;
        border-left: 4px solid #7d8957;
        background: #fffefa;
        color: #5e6158;
        font: .86rem/1.55 Arial, Helvetica, sans-serif;
      }

      .pedagogical-fields {
        display: grid;
        gap: 12px;
      }

      .editor-section {
        border: 1px solid #dedbd2;
        border-radius: 9px;
        background: #fffefa;
        overflow: hidden;
      }

      .editor-section > summary {
        padding: 16px 18px;
        cursor: pointer;
        font-weight: 700;
      }

      .editor-section-body {
        display: grid;
        gap: 18px;
        padding: 2px 18px 20px;
      }

      .editor-field-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 7px;
      }

      .editor-field label,
      .resource-edit-card label {
        font: 700 .78rem Arial, Helvetica, sans-serif;
        color: #55584e;
      }

      .editor-field textarea,
      .resource-edit-card input,
      .resource-edit-card textarea,
      .resource-edit-card select {
        width: 100%;
        margin-top: 7px;
        padding: 11px 12px;
        border: 1px solid #cac7bd;
        border-radius: 6px;
        background: #fff;
        color: #292b23;
        line-height: 1.5;
      }

      .restore-field {
        padding: 5px 8px;
        border: 1px solid #d7d1c5;
        border-radius: 5px;
        background: #fff;
        color: #6a6d63;
        cursor: pointer;
        font: 700 .7rem Arial, Helvetica, sans-serif;
      }

      .resources-editor {
        margin-top: 34px;
        padding-top: 28px;
        border-top: 1px solid #ddd8ce;
      }

      .resources-editor-head {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 18px;
      }

      .resources-editor-head h3 {
        margin: 0 0 6px;
        font-size: 1.65rem;
        font-weight: 500;
      }

      .resources-editor-head p:last-child {
        margin: 0;
        color: #686b61;
      }

      .resources-editor-list {
        display: grid;
        gap: 14px;
      }

      .resource-edit-card {
        padding: 18px;
        border: 1px solid #ddd9cf;
        border-radius: 9px;
        background: #fffefa;
      }

      .resource-edit-grid {
        display: grid;
        grid-template-columns: minmax(160px,.7fr) minmax(220px,1fr);
        gap: 14px;
      }

      .resource-edit-grid .wide {
        grid-column: 1 / -1;
      }

      .resource-delete {
        margin-top: 14px;
      }

      .editor-actions {
        position: sticky;
        bottom: 14px;
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 28px;
        padding: 14px;
        border: 1px solid #d7d3c9;
        border-radius: 9px;
        background: rgba(255,254,250,.96);
        box-shadow: 0 8px 25px rgba(35,35,28,.08);
      }

      .editor-actions > button:first-child {
        min-height: 44px;
        padding: 10px 16px;
        border: 0;
        border-radius: 6px;
        background: #7d8957;
        color: #fff;
        cursor: pointer;
        font-weight: 700;
      }

      .secondary-action {
        min-height: 44px;
        padding: 10px 14px;
        border: 1px solid #9a968b;
        border-radius: 6px;
        background: #fff;
        color: #55584e;
        cursor: pointer;
        font-weight: 700;
      }

      @media (max-width: 720px) {
        .resources-editor-head { align-items: stretch; flex-direction: column; }
        .resource-edit-grid { grid-template-columns: 1fr; }
        .resource-edit-grid .wide { grid-column: auto; }
        .editor-actions { position: static; }
      }
      @media (max-width:520px) {
        .admin-session-bar {
          align-items: stretch;
          flex-direction: column;
        }
        .admin-session-actions {
          align-items: stretch;
          flex-direction: column;
        }
        .admin-session-actions button { width:100%; }
        .hero h1 { font-size:clamp(2.15rem,11vw,3rem); }
        .hero p:last-child { font-size:.92rem; }
        .admin-wrap { width:92%; padding-bottom:55px; }
        .login-card { padding:26px 20px; }
        .tabs { margin-left:-4px; margin-right:-4px; }
        .dashboard-summary { gap:9px; margin-bottom:28px; }
        .summary-card { padding:15px 17px; }
        .planning-main,
        .request-card { padding:18px 16px; }
        .planning-top .small-button { width:100%; }
        .filters {
          justify-content:flex-start;
          flex-wrap:nowrap;
          overflow-x:auto;
          padding-bottom:4px;
          -webkit-overflow-scrolling:touch;
        }
        .filter { flex:0 0 auto; }
        .request-actions {
          flex-direction:column;
          align-items:stretch;
        }
        .request-actions button { width:100%; }
        .inline-status { text-align:center; }
        .toolbar {
          grid-template-columns:42px 1fr 42px;
          gap:8px;
        }
        .toolbar strong { font-size:1.2rem; }
        .month-button { width:42px; height:42px; }
        .legend { justify-content:flex-start; gap:10px 14px; }
        .week-card { padding:15px 14px; }
        .status-actions button { min-height:46px; }
      }
    </style>
  </body>
