<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Gestion des réservations · Rencontres avec le vivant</title>
  </head>

  <body>
    <main>
      <section class="hero">
        <p class="eyebrow">Espace privé</p>
        <h1>Gestion des réservations</h1>
        <p>
          Retrouvez votre planning, les demandes reçues et les disponibilités
          de la malle au même endroit.
        </p>
      </section>

      <section class="admin-wrap">
        <div id="login-card" class="login-card">
          <h2>Accéder à la gestion</h2>
          <p>Entrez votre mot de passe administrateur.</p>

          <form id="login-form">
            <label for="admin-password">Mot de passe</label>
            <input
              id="admin-password"
              type="password"
              autocomplete="current-password"
              required
            />
            <button type="submit">Ouvrir la gestion</button>
          </form>

          <p id="login-status" class="status" role="status"></p>
        </div>

        <div id="admin-panel" hidden>
          <div class="admin-session-bar">
            <span>Session administrateur ouverte</span>
            <div class="admin-session-actions">
              <button type="button" id="export-csv-button" class="export-button">Exporter les réservations (.csv)</button>
              <button type="button" id="logout-button" class="logout-button">Se déconnecter</button>
            </div>
          </div>
          <div class="tabs" role="tablist" aria-label="Gestion des réservations">
            <button type="button" class="tab active" data-tab="planning">Planning</button>
            <button type="button" class="tab" data-tab="requests">
              Demandes <span id="new-count" class="count" hidden></span>
            </button>
            <button type="button" class="tab" data-tab="availability">Disponibilités</button>
            <button type="button" class="tab" data-tab="pedagogical">Page pédagogique</button>
            <button type="button" class="tab" data-tab="blog">Blog</button>
          </div>

          <div class="dashboard-summary" aria-label="Résumé des réservations">
            <div class="summary-card">
              <span>À traiter</span>
              <strong id="summary-new">0</strong>
              <small>demande(s) reçue(s)</small>
            </div>
            <div class="summary-card">
              <span>Confirmées</span>
              <strong id="summary-confirmed">0</strong>
              <small>location(s) à venir</small>
            </div>
            <div class="summary-card">
              <span>À venir</span>
              <strong id="summary-upcoming">0</strong>
              <small>dossier(s) actifs</small>
            </div>
          </div>

          <section id="tab-planning" class="tab-panel">
            <div class="section-heading">
              <p class="section-eyebrow">Organisation</p>
              <h2>Planning des locations</h2>
              <p>
                Les demandes et réservations apparaissent ici dans l’ordre des
                prochaines semaines.
              </p>
            </div>
            <div id="planning-list" class="planning-list"></div>
          </section>

          <section id="tab-requests" class="tab-panel" hidden>
            <div class="section-heading">
              <p class="section-eyebrow">Suivi</p>
              <h2>Demandes et réservations</h2>
              <p>
                Modifiez le statut d’une demande, notez vos informations de
                suivi et retrouvez les coordonnées de la structure.
              </p>
            </div>

            <div class="filters">
              <button type="button" class="filter active" data-filter="active">À traiter</button>
              <button type="button" class="filter" data-filter="all">Toutes</button>
              <button type="button" class="filter" data-filter="completed">Terminées</button>
            </div>

            <div id="requests-list" class="requests-list"></div>
          </section>

          <section id="tab-availability" class="tab-panel" hidden>
            <div class="section-heading">
              <p class="section-eyebrow">Calendrier public</p>
              <h2>Disponibilités</h2>
              <p>
                Ces états sont ceux affichés sur le module de réservation.
              </p>
            </div>

            <div class="toolbar">
              <button
                type="button"
                id="previous-month"
                class="month-button"
                aria-label="Mois précédent"
              >
                ←
              </button>

              <div>
                <span>Mois affiché</span>
                <strong id="current-month"></strong>
              </div>

              <button
                type="button"
                id="next-month"
                class="month-button"
                aria-label="Mois suivant"
              >
                →
              </button>
            </div>

            <div class="legend">
              <span><i class="dot available"></i> Disponible</span>
              <span><i class="dot pending"></i> Demande en cours</span>
              <span><i class="dot booked"></i> Réservée</span>
            </div>

            <div id="admin-weeks" class="weeks" aria-live="polite"></div>
            <p id="save-status" class="status save-status" role="status"></p>
          </section>

          <section id="tab-pedagogical" class="tab-panel" hidden>
            <div class="section-heading">
              <p class="section-eyebrow">Contenu de l’espace privé</p>
              <h2>Page pédagogique</h2>
              <p>
                Modifiez les textes affichés dans « Préparer votre rencontre avec les oiseaux ».
                La mise en page et les règles de sécurité restent verrouillées.
              </p>
            </div>

            <div class="editor-note">
              Les textes actuels restent les valeurs par défaut. Le bouton « Restaurer » remet
              simplement le champ à son texte initial.
            </div>

            <div id="pedagogical-fields" class="pedagogical-fields"></div>

            <div class="resources-editor">
              <div class="resources-editor-head">
                <div>
                  <p class="section-eyebrow">Bibliothèque</p>
                  <h3>Ressources</h3>
                  <p>Ajoutez, modifiez ou retirez les articles, podcasts, vidéos et outils proposés dans la colonne de droite.</p>
                </div>
                <button type="button" id="add-resource-button" class="small-button">Ajouter une ressource</button>
              </div>
              <div id="resources-editor-list" class="resources-editor-list"></div>
            </div>

            <div class="editor-actions">
              <button type="button" id="save-pedagogical-button">Enregistrer la page pédagogique</button>
              <button type="button" id="reset-resources-button" class="secondary-action">Restaurer les ressources initiales</button>
              <span id="pedagogical-status" class="inline-status" role="status"></span>
            </div>
          </section>

          <section id="tab-blog" class="tab-panel" hidden>
            <div class="section-heading">
              <p class="section-eyebrow">Contenus du site</p>
              <h2>Blog</h2>
              <p>Créez, modifiez et publiez vos articles depuis le même espace d’administration.</p>
            </div>
            <iframe
              id="blog-admin-frame"
              class="blog-admin-frame"
              src="/gestion-blog?embed=1"
              title="Gestion du blog"
            ></iframe>
          </section>
        </div>
      </section>
    </main>

