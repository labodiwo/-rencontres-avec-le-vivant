      ];

      const resourceCategories = {
        listen:"À écouter",
        read:"À lire",
        explore:"À explorer",
        field:"À utiliser sur le terrain",
        watch:"À regarder",
        children:"Avec les enfants"
      };

      const today = new Date();
      today.setHours(12, 0, 0, 0);

      let displayedMonth = new Date(
        today.getFullYear(),
        today.getMonth(),
        1,
        12
      );

      const firstAllowedMonth = new Date(
        today.getFullYear(),
        today.getMonth(),
        1,
        12
      );

      const lastAllowedMonth = new Date(
        today.getFullYear(),
        today.getMonth() + 11,
        1,
        12
      );

      const statusLabels = {
        new: "Demande reçue",
        confirmed: "Réservation confirmée",
        paid: "Payée",
        completed: "Terminée",
        cancelled: "Annulée",
      };

      const statusDescriptions = {
        new: "À traiter · les dates restent indiquées comme demande en cours.",
        confirmed: "Dates bloquées comme réservées dans le calendrier.",
        paid: "Réservation confirmée et règlement reçu.",
        completed: "Location terminée et dossier clos.",
        cancelled: "Réservation annulée · les dates sont libérées.",
      };

      const escapeHtml = (value) =>
        String(value ?? "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");

      const formatIsoDate = (date) => {
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, "0");
        const day = String(date.getDate()).padStart(2, "0");
        return `${year}-${month}-${day}`;
      };

      const formatWeekLabel = (monday, friday) =>
        `Du lundi ${new Intl.DateTimeFormat("fr-FR", {
          day: "numeric",
          month: "long",
        }).format(monday)} au vendredi ${new Intl.DateTimeFormat("fr-FR", {
          day: "numeric",
          month: "long",
        }).format(friday)}`;

      const getMonday = (date) => {
        const result = new Date(date);
        result.setHours(12, 0, 0, 0);
        const day = result.getDay();
        const offset = day === 0 ? -6 : 1 - day;
        result.setDate(result.getDate() + offset);
        return result;
      };

      const formatDateShort = (iso) => {
        if (!iso) return "Date non renseignée";
        const date = new Date(iso + "T12:00:00");
        if (Number.isNaN(date.getTime())) return iso;
        return new Intl.DateTimeFormat("fr-FR", {
          day: "numeric",
          month: "long",
          year: "numeric",
        }).format(date);
      };

      const deliveryDate = (reservation) => {
        if (!reservation.weekIso) return "";
        const date = new Date(reservation.weekIso + "T12:00:00");
        date.setDate(date.getDate() - 3);
        return formatDateShort(formatIsoDate(date));
      };

      const renderPlanning = () => {
        const upcoming = reservations
          .filter((item) => !["cancelled", "completed"].includes(item.status))
          .filter((item) => {
            if (!item.weekIso) return true;
            const end = new Date(item.weekIso + "T12:00:00");
            end.setDate(end.getDate() + Math.max(1, Number(item.duration) || 1) * 7);
            return end >= today;
          })
          .sort((a, b) =>
            String(a.weekIso || "9999").localeCompare(String(b.weekIso || "9999"))
          );

        if (!upcoming.length) {
          planningList.innerHTML =
            '<div class="empty-card">Aucune location à venir pour le moment.</div>';
          return;
        }

        planningList.innerHTML = upcoming.map((item) => `
          <article class="planning-card">
            <div class="planning-date">
              <span>Début</span>
              <strong>${escapeHtml(formatDateShort(item.weekIso))}</strong>
              ${item.weekIso ? `<small>Remise prévue : vendredi ${escapeHtml(deliveryDate(item))}</small>` : ""}
            </div>

            <div class="planning-main">
              <div class="planning-top">
                <div>
                  <span class="reservation-status status-${escapeHtml(item.status)}">
                    ${escapeHtml(statusLabels[item.status] || item.status)}
                  </span>
                  <h3>${escapeHtml(item.organisation || item.name)}</h3>
                </div>
                <button type="button" class="small-button" data-open-request="${escapeHtml(item.id)}">
                  Voir la fiche
                </button>
              </div>

              <div class="planning-details">
                <span><strong>Malle :</strong> ${escapeHtml(item.kit)}</span>
                <span><strong>Période :</strong> ${escapeHtml(item.week)}</span>
                <span><strong>Formule :</strong> ${escapeHtml(item.formula)}</span>
                <span><strong>Tarif :</strong> ${escapeHtml(item.priceSummary || "—")}</span>
              </div>
            </div>
          </article>
        `).join("");

        planningList.querySelectorAll("[data-open-request]").forEach((button) => {
          button.addEventListener("click", () => {
            showTab("requests");
            currentFilter = "all";
            document.querySelectorAll(".filter").forEach((filter) => {
              filter.classList.toggle("active", filter.dataset.filter === "all");
            });
            renderRequests();
            const card = document.querySelector(
              `[data-request-id="${CSS.escape(button.dataset.openRequest)}"]`
            );
            if (card) card.scrollIntoView({ behavior: "smooth", block: "center" });
          });
        });
      };

      const requestMatchesFilter = (item) => {
        if (currentFilter === "all") return true;
        if (currentFilter === "completed") {
          return ["completed", "cancelled"].includes(item.status);
        }
        return !["completed", "cancelled"].includes(item.status);
      };

      const renderRequests = () => {
        const filtered = reservations.filter(requestMatchesFilter);

        if (!filtered.length) {
          requestsList.innerHTML =
            '<div class="empty-card">Aucune demande dans cette catégorie.</div>';
          return;
        }

        requestsList.innerHTML = filtered.map((item) => `
          <article class="request-card" data-request-id="${escapeHtml(item.id)}">
            <div class="request-head">
              <div>
                <span class="reservation-status status-${escapeHtml(item.status)}">
                  ${escapeHtml(statusLabels[item.status] || item.status)}
                </span>
                <h3>${escapeHtml(item.organisation || "Structure non renseignée")}</h3>
                <p>${escapeHtml(item.name)} · <a href="mailto:${escapeHtml(item.email)}">${escapeHtml(item.email)}</a></p>
                <p>Téléphone : ${item.phone ? `<a href="tel:${escapeHtml(item.phone.replace(/[^+0-9]/g, ""))}">${escapeHtml(item.phone)}</a>` : "Non renseigné"}</p>
              </div>
              <div class="request-date">
                <small>Période souhaitée</small>
                <strong>${escapeHtml(item.week || "—")}</strong>
              </div>
            </div>

            <div class="request-grid">
              <div><span>Malle</span><strong>${escapeHtml(item.kit || "—")}</strong></div>
              <div><span>Durée</span><strong>${escapeHtml(item.duration || "1")} semaine(s)</strong></div>
              <div><span>Formule</span><strong>${escapeHtml(item.formula || "—")}</strong></div>
              <div><span>Tarif</span><strong>${escapeHtml(item.priceSummary || "—")}</strong></div>
              <div><span>Âge des enfants</span><strong>${escapeHtml(item.childrenAge || "—")}</strong></div>
              <div><span>Nombre d’enfants</span><strong>${escapeHtml(item.childrenNumber || "—")}</strong></div>
            </div>

            ${item.message ? `
              <div class="customer-message">
                <span>Message de la structure</span>
                <p>${escapeHtml(item.message)}</p>
              </div>
            ` : ""}

            <div class="reservation-dates">
              <label for="start-${escapeHtml(item.id)}">Début de location (lundi)</label>
              <input type="date" id="start-${escapeHtml(item.id)}" data-start-date="${escapeHtml(item.id)}" value="${escapeHtml(item.weekIso || "")}" />
              <small>Cette date est indispensable pour créer le lien privé. Enregistrez les modifications avant de générer le lien.</small>
            </div>
            <div class="management-grid">
              <div>
                <label for="status-${escapeHtml(item.id)}">Statut</label>
                <select id="status-${escapeHtml(item.id)}" data-status-select="${escapeHtml(item.id)}">
                  ${Object.entries(statusLabels).map(([value, label]) =>
                    `<option value="${value}" ${item.status === value ? "selected" : ""}>${label}</option>`
                  ).join("")}
                </select>
                <p class="status-help" data-status-help="${escapeHtml(item.id)}">
                  ${escapeHtml(statusDescriptions[item.status] || "")}
                </p>
              </div>

              <div class="notes-field">
                <label for="notes-${escapeHtml(item.id)}">Mes notes</label>
                <textarea
                  id="notes-${escapeHtml(item.id)}"
                  rows="3"
                  data-notes="${escapeHtml(item.id)}"
                  placeholder="Ex. paiement à relancer, horaire de remise, contact…"
                >${escapeHtml(item.adminNotes || "")}</textarea>
              </div>
            </div>

            <div class="pedagogical-access">
              <strong>Accès au livret numérique</strong>
              <p>Créez un lien privé après confirmation. Il expire trois jours après la fin de la location. La création d’un nouveau lien invalide le précédent.</p>
              <p>${item.pedagogicalAccess ? "Lien actif jusqu’au " + escapeHtml(formatDateShort(item.pedagogicalAccess.expiresAt?.slice(0,10))) + " (UTC), sauf annulation." : "Aucun lien créé."}</p>
              ${["confirmed","paid"].includes(item.status) ? `<button type="button" data-create-access="${escapeHtml(item.id)}">Créer / renouveler le lien</button>` : ""}
              ${item.pedagogicalAccess ? `<button type="button" class="delete-button" data-revoke-access="${escapeHtml(item.id)}">Désactiver le lien</button>` : ""}
              <div data-access-result="${escapeHtml(item.id)}" class="access-result" role="status"></div>
            </div>
            <div class="request-actions">
              <button type="button" data-save-request="${escapeHtml(item.id)}">
                Enregistrer les modifications
              </button>
              <button type="button" class="delete-button" data-delete-request="${escapeHtml(item.id)}">
                Supprimer
              </button>
              <span class="inline-status" data-inline-status="${escapeHtml(item.id)}"></span>
            </div>
          </article>
        `).join("");

        requestsList.querySelectorAll("[data-status-select]").forEach((select) => {
          select.addEventListener("change", () => {
            const help = document.querySelector(
              '[data-status-help="' + CSS.escape(select.dataset.statusSelect) + '"]'
            );
            if (help) help.textContent = statusDescriptions[select.value] || "";
          });
        });

        requestsList.querySelectorAll("[data-create-access]").forEach(button => {
          button.addEventListener("click", () => manageAccess(button.dataset.createAccess, "create"));
        });
        requestsList.querySelectorAll("[data-revoke-access]").forEach(button => {
          button.addEventListener("click", () => manageAccess(button.dataset.revokeAccess, "revoke"));
        });
        requestsList.querySelectorAll("[data-save-request]").forEach((button) => {
          button.addEventListener("click", () => saveReservation(button.dataset.saveRequest));
        });

        requestsList.querySelectorAll("[data-delete-request]").forEach((button) => {
          button.addEventListener("click", () => deleteReservation(button.dataset.deleteRequest));
        });
      };

      const updateSummary = () => {
        const active = reservations.filter(
          (item) => !["completed", "cancelled"].includes(item.status)
        );
        const confirmed = active.filter(
          (item) => ["confirmed", "paid"].includes(item.status)
        );

        summaryNew.textContent = String(
          reservations.filter((item) => item.status === "new").length
        );
        summaryConfirmed.textContent = String(confirmed.length);
        summaryUpcoming.textContent = String(active.length);
      };

      const updateNewCount = () => {
        const count = reservations.filter((item) => item.status === "new").length;
        newCount.hidden = count === 0;
        newCount.textContent = count ? String(count) : "";
      };

      const loadReservations = async () => {
        const response = await fetch("/api/admin/reservations", {
          headers: { "x-admin-key": adminKey },
        });
        const result = await response.json();

        if (!response.ok || !result.ok) {
          throw new Error(result.error || "Impossible de charger les réservations.");
        }

        reservations = result.reservations || [];

        // Donnée fictive uniquement sur les domaines de Preview Cloudflare,
        // afin de tester l'export CSV sans utiliser de données clients réelles.
        if (
          reservations.length === 0 &&
          window.location.hostname.endsWith(".workers.dev")
        ) {
          reservations = [
            {
              id: "preview-demo",
              status: "new",
              organisation: "Centre social exemple",
              name: "Camille Test",
              email: "camille.test@example.com",
              phone: "06 12 34 56 78",
              kit: "Malle Les oiseaux",
              week: "Du lundi 7 décembre au vendredi 11 décembre 2026",
              weekIso: "2026-12-07",
              duration: "1",
              formula: "Autonome",
              priceSummary: "200 € · formule autonome",
              childrenAge: "3–5 ans",
              childrenNumber: "8",
              message: "Donnée fictive destinée uniquement au test de l’export.",
              adminNotes: "Ne pas utiliser en production.",
              conditionsAccepted: true,
              conditionsVersion: "2026-10",
              createdAt: "2026-11-17T14:00:00.000Z",
              updatedAt: "2026-11-17T14:00:00.000Z",
            },
          ];
        }

        updateNewCount();
        updateSummary();
        renderPlanning();
        renderRequests();
      };

      const manageAccess = async (id, action) => {
        if (action === "revoke" && !confirm("Désactiver immédiatement ce lien privé ?")) return;
        if (action === "create" && reservations.find(r => r.id === id)?.pedagogicalAccess &&
            !confirm("Le lien précédent cessera de fonctionner. Continuer ?")) return;
        const output = document.querySelector('[data-access-result="' + CSS.escape(id) + '"]');
        if (!output) return;
        output.textContent = "Traitement…";
        try {
          const response = await fetch("/api/admin/pedagogical-access", {
            method: "POST",
            headers: { "content-type": "application/json", "x-admin-key": adminKey },
            body: JSON.stringify({ id, action }),
          });
          const result = await response.json();
          if (!response.ok || !result.ok) throw new Error(result.error || "Opération impossible.");
          await loadReservations();
          const fresh = document.querySelector('[data-access-result="' + CSS.escape(id) + '"]');
          if (!fresh) return;
          if (result.link) {
            const field = document.createElement("input");
            field.type = "text";
            field.readOnly = true;
            field.value = result.link;
            field.setAttribute("aria-label", "Lien privé à transmettre à la structure");
            const copy = document.createElement("button");
            copy.type = "button";
            copy.textContent = "Copier le lien";
            copy.addEventListener("click", async () => {
              try { await navigator.clipboard.writeText(field.value); copy.textContent = "Lien copié"; }
              catch { field.select(); copy.textContent = "Sélectionnez et copiez le lien"; }
            });
            fresh.textContent = "Lien créé. Copiez-le maintenant : il ne sera plus affiché après fermeture ou actualisation de la page.";
            fresh.append(field, copy);
          } else fresh.textContent = "Lien désactivé.";
        } catch (error) {
          output.textContent = error.message || "Opération impossible.";
        }
      };

      const saveReservation = async (id) => {
        const item = reservations.find((reservation) => reservation.id === id);
        if (!item) return;

        const statusSelect = document.querySelector(
          `[data-status-select="${CSS.escape(id)}"]`
        );
        const startField = document.querySelector(
          `[data-start-date="${CSS.escape(id)}"]`
        );
        if (startField?.value) {
          const selectedDate = new Date(startField.value + "T12:00:00Z");
          if (selectedDate.getUTCDay() !== 1) {
            alert("La date de début doit être un lundi.");
            return;
          }
        }
        const notesField = document.querySelector(
          `[data-notes="${CSS.escape(id)}"]`
        );
        const inlineStatus = document.querySelector(
          `[data-inline-status="${CSS.escape(id)}"]`
        );

        inlineStatus.textContent = "Enregistrement…";

        try {
          const response = await fetch("/api/admin/reservations", {
            method: "POST",
            headers: {
              "content-type": "application/json",
              "x-admin-key": adminKey,
            },
            body: JSON.stringify({
              ...item,
              status: statusSelect.value,
              adminNotes: notesField.value,
              weekIso: startField?.value || item.weekIso,
            }),
          });

          const result = await response.json();

          if (!response.ok || !result.ok) {
            throw new Error(result.error || "Modification impossible.");
          }

          reservations = result.reservations || [];
          await loadAvailability();
          updateNewCount();
          updateSummary();
          renderPlanning();
          renderRequests();
        } catch (error) {
          inlineStatus.textContent = error.message || "Modification impossible.";
        }
      };

      const deleteReservation = async (id) => {
        if (!confirm("Supprimer définitivement cette réservation de votre gestion ?")) {
          return;
        }

        try {
          const response = await fetch("/api/admin/reservations", {
            method: "DELETE",
            headers: {
              "content-type": "application/json",
              "x-admin-key": adminKey,
            },
            body: JSON.stringify({ id }),
          });

          const result = await response.json();

          if (!response.ok || !result.ok) {
            throw new Error(result.error || "Suppression impossible.");
          }

          reservations = result.reservations || [];
          updateNewCount();
          updateSummary();
          renderPlanning();
          renderRequests();
        } catch (error) {
          alert(error.message || "Suppression impossible.");
        }
      };

      const renderWeeks = () => {
        weeksContainer.innerHTML = "";

        currentMonthLabel.textContent =
          new Intl.DateTimeFormat("fr-FR", {
            month: "long",
            year: "numeric",
          }).format(displayedMonth);

        previousMonthButton.disabled =
          displayedMonth.getTime() <= firstAllowedMonth.getTime();

        nextMonthButton.disabled =
          displayedMonth.getTime() >= lastAllowedMonth.getTime();

        const firstDay = new Date(
          displayedMonth.getFullYear(),
          displayedMonth.getMonth(),
          1,
          12
        );

        const monday = getMonday(firstDay);

        for (let row = 0; row < 6; row += 1) {
          const weekMonday = new Date(monday);
          weekMonday.setDate(monday.getDate() + row * 7);

          if (weekMonday.getMonth() !== displayedMonth.getMonth()) {
            continue;
          }

          const friday = new Date(weekMonday);
          friday.setDate(weekMonday.getDate() + 4);

          const iso = formatIsoDate(weekMonday);
          const status = availability[iso] || "available";

          const card = document.createElement("article");
          card.className = `week-card ${status}`;

          card.innerHTML = `
            <div class="week-info">
              <strong>${formatWeekLabel(weekMonday, friday)}</strong>
              <span class="current-status">
                ${status === "available"
                  ? "Disponible"
                  : status === "pending"
                    ? "Demande en cours"
                    : "Réservée"}
              </span>
            </div>

            <div class="status-actions" aria-label="Modifier le statut">
              <button type="button" data-status="available">Disponible</button>
              <button type="button" data-status="pending">En attente</button>
              <button type="button" data-status="booked">Réservée</button>
            </div>
          `;

          card.querySelectorAll("[data-status]").forEach((button) => {
            if (button.dataset.status === status) button.classList.add("active");
            button.addEventListener("click", async () => {
              await updateStatus(iso, button.dataset.status);
            });
          });

          weeksContainer.appendChild(card);
        }
      };

      const loadAvailability = async () => {
        const response = await fetch("/api/admin/availability", {
          headers: { "x-admin-key": adminKey },
        });
        const result = await response.json();

        if (!response.ok || !result.ok) {
          throw new Error(result.error || "Accès impossible.");
        }

        availability = result.availability || {};
        renderWeeks();
      };

      const updateStatus = async (week, status) => {
        saveStatus.textContent = "Enregistrement…";

        try {
          const response = await fetch("/api/admin/availability", {
            method: "POST",
            headers: {
              "content-type": "application/json",
              "x-admin-key": adminKey,
            },
            body: JSON.stringify({ week, status }),
          });

          const result = await response.json();

          if (!response.ok || !result.ok) {
            throw new Error(result.error || "La modification n’a pas pu être enregistrée.");
          }

          availability = result.availability || {};
          renderWeeks();
          saveStatus.textContent = "Modification enregistrée.";
        } catch (error) {
          saveStatus.textContent =
            error.message || "La modification n’a pas pu être enregistrée.";
        }
      };


      const renderPedagogicalFields = (savedFields = {}) => {
        const sections = new Map();
        pedagogicalSchema.forEach(([key, section, label, defaultValue]) => {
          if (!sections.has(section)) sections.set(section, []);
          sections.get(section).push([key, label, defaultValue]);
        });

        pedagogicalFields.innerHTML = Array.from(sections.entries()).map(([section, fields]) => `
          <details class="editor-section">
            <summary>${escapeHtml(section)}</summary>
            <div class="editor-section-body">
              ${fields.map(([key, label, defaultValue]) => `
                <div class="editor-field">
                  <div class="editor-field-head">
                    <label for="ped-${escapeHtml(key)}">${escapeHtml(label)}</label>
                    <button type="button" class="restore-field" data-restore-field="${escapeHtml(key)}">Restaurer</button>
                  </div>
                  <textarea id="ped-${escapeHtml(key)}" data-ped-field="${escapeHtml(key)}" rows="${String((savedFields[key] || defaultValue).length > 180 ? 4 : 2)}">${escapeHtml(savedFields[key] || defaultValue)}</textarea>
                </div>
              `).join("")}
            </div>
          </details>
        `).join("");

        pedagogicalFields.querySelectorAll("[data-restore-field]").forEach((button) => {
          button.addEventListener("click", () => {
            const item = pedagogicalSchema.find(([key]) => key === button.dataset.restoreField);
            if (!item) return;
            const input = document.querySelector('[data-ped-field="' + CSS.escape(item[0]) + '"]');
            if (input) input.value = item[3];
          });
        });
      };

      const renderResourceEditor = () => {
        if (!pedagogicalResources.length) {
          resourcesEditorList.innerHTML = '<div class="empty-card">Aucune ressource. Utilisez « Ajouter une ressource ».</div>';
          return;
        }

        resourcesEditorList.innerHTML = pedagogicalResources.map((item, index) => `
          <article class="resource-edit-card" data-resource-index="${index}">
            <div class="resource-edit-grid">
              <label>Catégorie
                <select data-resource-field="category">
                  ${Object.entries(resourceCategories).map(([value,label]) => `<option value="${value}" ${item.category === value ? "selected" : ""}>${escapeHtml(label)}</option>`).join("")}
                </select>
              </label>
              <label>Source
                <input type="text" data-resource-field="source" value="${escapeHtml(item.source || "")}" />
              </label>
              <label class="wide">Titre
                <input type="text" data-resource-field="title" value="${escapeHtml(item.title || "")}" />
              </label>
              <label class="wide">Description
                <textarea rows="3" data-resource-field="description">${escapeHtml(item.description || "")}</textarea>
              </label>
              <label class="wide">Lien
                <input type="url" data-resource-field="url" value="${escapeHtml(item.url || "")}" placeholder="https://…" />
              </label>
            </div>
            <button type="button" class="delete-button resource-delete" data-delete-resource="${index}">Supprimer cette ressource</button>
          </article>
        `).join("");

        resourcesEditorList.querySelectorAll("[data-delete-resource]").forEach((button) => {
          button.addEventListener("click", () => {
            pedagogicalResources.splice(Number(button.dataset.deleteResource), 1);
            renderResourceEditor();
          });
        });
      };

      const collectResourceEditor = () => {
        return Array.from(resourcesEditorList.querySelectorAll(".resource-edit-card")).map((card) => {
          const get = (name) => card.querySelector('[data-resource-field="' + name + '"]')?.value.trim() || "";
          return {
            category: get("category"),
            source: get("source"),
            title: get("title"),
            description: get("description"),
            url: get("url")
          };
        }).filter((item) => item.title && item.url);
      };

      const loadPedagogicalContent = async () => {
        const response = await fetch("/api/admin/pedagogical-content", {
          headers: { "x-admin-key": adminKey },
          cache: "no-store"
        });
        const result = await response.json();
        if (!response.ok || !result.ok) {
          throw new Error(result.error || "Impossible de charger la page pédagogique.");
        }

        const content = result.content || {};
        renderPedagogicalFields(content.fields || {});
        pedagogicalResources = Array.isArray(content.resources) && content.resources.length
          ? content.resources.map((item) => ({ ...item }))
          : defaultResources.map((item) => ({ ...item }));
        renderResourceEditor();
        pedagogicalContentLoaded = true;
      };

      const savePedagogicalContent = async () => {
        pedagogicalStatus.textContent = "Enregistrement…";

        const fields = {};
        pedagogicalSchema.forEach(([key,, ,defaultValue]) => {
          const input = document.querySelector('[data-ped-field="' + CSS.escape(key) + '"]');
          if (!input) return;
          const value = input.value.trim();
          if (value && value !== defaultValue) fields[key] = value;
        });

        pedagogicalResources = collectResourceEditor();

        try {
          const response = await fetch("/api/admin/pedagogical-content", {
            method: "POST",
            headers: {
              "content-type": "application/json",
              "x-admin-key": adminKey
            },
            body: JSON.stringify({ fields, resources: pedagogicalResources })
          });
          const result = await response.json();
          if (!response.ok || !result.ok) {
            throw new Error(result.error || "Enregistrement impossible.");
          }
          pedagogicalStatus.textContent = "Page pédagogique enregistrée.";
        } catch (error) {
          pedagogicalStatus.textContent = error.message || "Enregistrement impossible.";
        }
      };

      addResourceButton.addEventListener("click", () => {
        pedagogicalResources = collectResourceEditor();
        pedagogicalResources.push({ category:"read", source:"", title:"", description:"", url:"" });
        renderResourceEditor();
      });

      resetResourcesButton.addEventListener("click", () => {
        pedagogicalResources = defaultResources.map((item) => ({ ...item }));
        renderResourceEditor();
        pedagogicalStatus.textContent = "Ressources initiales restaurées. Pensez à enregistrer.";
      });

      savePedagogicalButton.addEventListener("click", savePedagogicalContent);

      const sendBlogAdminAuth = () => {
        if (!adminKey || !blogAdminFrame?.contentWindow) return;
        blogAdminFrame.contentWindow.postMessage(
          { type: "labodiwo-admin-auth", key: adminKey },
          window.location.origin,
        );
      };

      blogAdminFrame?.addEventListener("load", sendBlogAdminAuth);

      window.addEventListener("message", (event) => {
        if (
          event.origin !== window.location.origin ||
          event.data?.type !== "labodiwo-blog-resize" ||
          !blogAdminFrame
        ) return;

        const height = Number(event.data.height);
        if (Number.isFinite(height) && height > 300) {
          blogAdminFrame.style.height = Math.min(Math.max(height + 8, 900), 4200) + "px";
        }
      });

      const showTab = (name) => {
        document.querySelectorAll(".tab").forEach((button) => {
          button.classList.toggle("active", button.dataset.tab === name);
        });

        document.querySelectorAll(".tab-panel").forEach((panel) => {
          panel.hidden = panel.id !== `tab-${name}`;
        });

        if (name === "blog") {
          history.replaceState(null, "", "#blog");
          sendBlogAdminAuth();
        } else if (window.location.hash === "#blog") {
          history.replaceState(null, "", window.location.pathname + window.location.search);
        }
      };

      document.querySelectorAll(".tab").forEach((button) => {
        button.addEventListener("click", async () => {
          showTab(button.dataset.tab);
          if (button.dataset.tab === "pedagogical" && !pedagogicalContentLoaded) {
            pedagogicalStatus.textContent = "Chargement…";
            try {
              await loadPedagogicalContent();
              pedagogicalStatus.textContent = "";
            } catch (error) {
              pedagogicalStatus.textContent = error.message || "Chargement impossible.";
            }
          }

          if (button.dataset.tab === "blog") {
            sendBlogAdminAuth();
          }
        });
      });

      document.querySelectorAll(".filter").forEach((button) => {
        button.addEventListener("click", () => {
          currentFilter = button.dataset.filter;
          document.querySelectorAll(".filter").forEach((filter) => {
            filter.classList.toggle("active", filter === button);
          });
          renderRequests();
        });
      });

      const csvSafe = (value) => {
        let text = String(value ?? "")
          .replace(/\r?\n/g, " ")
          .trim();

        // Neutralise les valeurs qui pourraient être interprétées comme formules
        // par Excel ou LibreOffice.
        if (/^[=+\-@]/.test(text)) {
          text = "'" + text;
        }

        return '"' + text.replaceAll('"', '""') + '"';
      };

      const exportReservationsCsv = () => {
        if (!adminKey || adminPanel.hidden) {
          alert("Connectez-vous à l’administration avant d’exporter les réservations.");
          return;
        }

        if (!reservations.length) {
          alert("Aucune réservation à exporter.");
          return;
        }

        const headers = [
          "Statut",
          "Structure",
          "Nom",
          "E-mail",
          "Téléphone",
          "Malle",
          "Période souhaitée",
          "Début de location",
          "Durée (semaines)",
          "Formule",
          "Tarif estimé",
          "Âge des enfants",
          "Nombre d’enfants",
          "Message",
          "Notes administratives",
          "Conditions acceptées",
          "Version des conditions",
          "Demande créée le",
          "Dernière mise à jour",
        ];

        const rows = reservations.map((item) => [
          statusLabels[item.status] || item.status || "",
          item.organisation || "",
          item.name || "",
          item.email || "",
          item.phone || "",
          item.kit || "",
          item.week || "",
          item.weekIso || "",
          item.duration || "",
          item.formula || "",
          item.priceSummary || "",
          item.childrenAge || "",
          item.childrenNumber || "",
          item.message || "",
          item.adminNotes || "",
          item.conditionsAccepted ? "Oui" : "Non",
          item.conditionsVersion || "",
          item.createdAt || "",
          item.updatedAt || "",
        ]);

        const csv = [
          headers.map(csvSafe).join(";"),
          ...rows.map((row) => row.map(csvSafe).join(";")),
        ].join("\r\n");

        const blob = new Blob(["\uFEFF" + csv], {
          type: "text/csv;charset=utf-8",
        });
        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = url;
        link.download =
          "reservations-labodiwo-" + new Date().toISOString().slice(0, 10) + ".csv";
        document.body.appendChild(link);
        link.click();
        link.remove();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
      };

      exportCsvButton.addEventListener("click", exportReservationsCsv);

      const logout = () => {
        adminKey = "";
        availability = {};
        reservations = [];
        currentFilter = "active";
        pedagogicalContentLoaded = false;
        pedagogicalResources = [];
        pedagogicalFields.innerHTML = "";
        resourcesEditorList.innerHTML = "";
        pedagogicalStatus.textContent = "";
        passwordInput.value = "";
        loginStatus.textContent = "";
        saveStatus.textContent = "";
        weeksContainer.innerHTML = "";
        planningList.innerHTML = "";
        requestsList.innerHTML = "";
        summaryNew.textContent = "0";
        summaryConfirmed.textContent = "0";
        summaryUpcoming.textContent = "0";
        newCount.textContent = "";
        newCount.hidden = true;
        adminPanel.hidden = true;
        loginCard.hidden = false;
        loginForm.reset();
        passwordInput.focus();
      };

      logoutButton.addEventListener("click", logout);

      loginForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        loginStatus.textContent = "Vérification…";
        adminKey = passwordInput.value;

        try {
          // On vérifie d'abord le mot de passe avec une seule requête.
          // Si elle échoue, la seconde n'est jamais envoyée : une saisie
          // correspond donc toujours à une seule tentative de connexion.
          await loadAvailability();
          await loadReservations();
          passwordInput.value = "";
          loginCard.hidden = true;
          adminPanel.hidden = false;
          loginStatus.textContent = "";
          const initialTab = window.location.hash === "#blog" ? "blog" : "planning";
          showTab(initialTab);
          if (initialTab === "blog") sendBlogAdminAuth();
        } catch (error) {
          adminKey = "";
          loginStatus.textContent = error.message || "Mot de passe incorrect.";
        }
      });

      previousMonthButton.addEventListener("click", () => {
        displayedMonth = new Date(
          displayedMonth.getFullYear(),
          displayedMonth.getMonth() - 1,
          1,
          12
        );
        renderWeeks();
      });

      nextMonthButton.addEventListener("click", () => {
        displayedMonth = new Date(
          displayedMonth.getFullYear(),
          displayedMonth.getMonth() + 1,
          1,
          12
        );
        renderWeeks();
      });
