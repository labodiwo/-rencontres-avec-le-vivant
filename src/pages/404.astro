---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="description" content="Page introuvable · Rencontres avec le vivant." />
    <title>Page introuvable · Rencontres avec le vivant</title>
  </head>
  <body>
    <SiteHeader />
    <main>
      <section class="not-found">
        <p class="eyebrow">Erreur 404</p>
        <h1>Cette page n’existe pas ou plus.</h1>
        <p>
          Vous pouvez revenir à l’accueil ou découvrir les malles pédagogiques.
        </p>
        <div class="actions">
          <a class="primary" href="/">Retour à l’accueil</a>
          <a class="secondary" href="/les-malles">Découvrir les malles</a>
        </div>
      </section>
    </main>
    <SiteFooter />

    <style>
      :global(*){box-sizing:border-box}
      :global(body){margin:0;background:#f9f7f2;color:#292b23;font-family:Georgia,"Times New Roman",serif}
      .not-found{min-height:60vh;padding:90px 24px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}
      .eyebrow{margin:0 0 10px;color:#74785e;font:700 .74rem Arial,Helvetica,sans-serif;letter-spacing:.1em;text-transform:uppercase}
      h1{max-width:760px;margin:0 0 18px;font-size:clamp(2.5rem,5vw,4.6rem);font-weight:500;line-height:1.05}
      .not-found>p:not(.eyebrow){max-width:620px;margin:0 0 28px;color:#5f6156;line-height:1.65}
      .actions{display:flex;gap:12px;flex-wrap:wrap;justify-content:center}
      .actions a{padding:12px 17px;border-radius:5px;text-decoration:none;font-weight:700}
      .primary{background:#7d8957;color:white}
      .secondary{border:1px solid #7d8957;color:#596243;background:#fffefa}
      @media(max-width:520px){.not-found{padding:65px 20px}.actions{width:100%}.actions a{width:100%}}
    </style>
  </body>
</html>