---
const nav = [
  { label: "Les malles", href: "/les-malles" },
  { label: "Louer une malle", href: "/louer-une-malle" },
  { label: "À propos", href: "/a-propos" },
  { label: "FAQ", href: "/faq" },
  { label: "Le blog", href: "/blog" },
  { label: "Me contacter", href: "/contact" },
];

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href) => pathname === href || (href === "/blog" && pathname === "/article-blog");
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Rencontres avec le vivant — Accueil">
    <svg class="brand-logo" viewBox="0 0 120 120" role="img" aria-hidden="true">
      <path class="brand-circle" d="M34 99C17 84 12 60 20 40C29 18 52 8 77 11" />
      <path class="brand-circle" d="M99 35C107 55 103 79 87 94C73 107 51 108 34 99" />
      <circle class="brand-dot" cx="96" cy="20" r="7" />
      <path class="brand-leaf-large" d="M36 97C25 79 25 57 40 36C57 57 56 79 36 97Z" />
      <path class="brand-stem" d="M36 98C50 84 60 65 65 44" />
      <path class="brand-leaf" d="M65 45C55 37 58 24 69 17C77 29 75 40 65 45Z" />
      <path class="brand-leaf" d="M62 69C70 56 84 55 94 62C86 75 73 79 62 69Z" />
      <path class="brand-vein" d="M36 96C41 77 43 58 40 38" />
    </svg>

    <span class="brand-text">
      <span>Rencontres</span>
      <span>avec le vivant</span>
    </span>
  </a>

  <nav aria-label="Navigation principale">
    {nav.map((item) => (
      <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
        {item.label}
      </a>
    ))}
  </nav>
</header>

<style>
  .site-header {
    min-height: 94px;
    padding: 15px 5.5%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    background: #fff;
  }
  .brand { display:flex; align-items:center; color:#29271f; text-decoration:none; flex:0 0 auto; }
  .brand-logo { width:66px; height:66px; flex:0 0 auto; margin-right:11px; overflow:visible; }
  .brand-circle { fill:none; stroke:#5a4a3f; stroke-width:3.2; stroke-linecap:round; }
  .brand-dot { fill:#d69b3e; }
  .brand-leaf-large { fill:#7a8f6b; }
  .brand-leaf { fill:#657954; }
  .brand-stem { fill:none; stroke:#4f5f42; stroke-width:2.4; stroke-linecap:round; }
  .brand-vein { fill:none; stroke:rgba(249,247,246,.72); stroke-width:1.6; stroke-linecap:round; }
  .brand-text { display:flex; flex-direction:column; color:#5a4a3f; font-family:Georgia,"Times New Roman",serif; font-size:1.55rem; line-height:1.05; }
  .brand-text span:last-child { margin-top:4px; color:#657954; font-family:Arial,Helvetica,sans-serif; font-size:.72rem; letter-spacing:.16em; }
  nav { display:flex; align-items:center; gap:clamp(16px,2.2vw,34px); flex-wrap:wrap; justify-content:flex-end; }
  nav a { color:#161713; text-decoration:none; font:600 .93rem Arial,Helvetica,sans-serif; white-space:nowrap; }
  nav a:hover, nav a[aria-current="page"] { color:#687347; }
  @media (max-width:900px) {
    .site-header { flex-direction:column; align-items:flex-start; }
    nav { justify-content:flex-start; }
  }
  @media (max-width:650px) {
    .site-header { padding:16px 22px; }
    .brand-logo { width:56px; height:56px; margin-right:9px; }
    .brand-text { font-size:1.35rem; }
    nav { gap:12px 18px; }
    nav a { font-size:.86rem; }
  }
</style>
