---
const nav = [
  { label: "Louer une malle", href: "/louer-une-malle", cta: true },
  { label: "Les malles", href: "/les-malles" },
  { label: "À propos", href: "/a-propos" },
  { label: "FAQ", href: "/faq" },
  { label: "Blog", href: "/blog" },
  { label: "Me contacter", href: "/contact" },
];

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href) => pathname === href || (href === "/blog" && pathname === "/article-blog");
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Rencontres avec le vivant — Accueil">
    <img class="brand-logo" src="/images/logo-rencontres.jpg" alt="" aria-hidden="true" />

    <span class="brand-text">
      <span>Rencontres</span>
      <span>avec le vivant</span>
    </span>
  </a>

  <button
    class="menu-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="main-navigation"
  >
    <span class="menu-icon" aria-hidden="true">☰</span>
    <span>Menu</span>
  </button>

  <nav id="main-navigation" aria-label="Navigation principale">
    {nav.map((item) => (
      <a
        href={item.href}
        class={item.cta ? "nav-cta" : undefined}
        aria-current={isActive(item.href) ? "page" : undefined}
      >
        {item.label}
      </a>
    ))}
  </nav>
</header>

<script is:inline>
  const menuToggle = document.querySelector(".menu-toggle");
  const mainNavigation = document.getElementById("main-navigation");

  if (menuToggle && mainNavigation) {
    menuToggle.addEventListener("click", () => {
      const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
      menuToggle.setAttribute("aria-expanded", String(!isOpen));
      mainNavigation.classList.toggle("is-open", !isOpen);
      const icon = menuToggle.querySelector(".menu-icon");
      if (icon) icon.textContent = isOpen ? "☰" : "×";
    });

    mainNavigation.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        menuToggle.setAttribute("aria-expanded", "false");
        mainNavigation.classList.remove("is-open");
        const icon = menuToggle.querySelector(".menu-icon");
        if (icon) icon.textContent = "☰";
      });
    });
  }
</script>

<style>
  .site-header {
    min-height: 94px;
    padding: 15px 5.5%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    background: #fff;
  }
  .brand { display:flex; align-items:center; color:#29271f; text-decoration:none; flex:0 0 auto; }
  .brand-logo { width:72px; height:72px; flex:0 0 auto; margin-right:11px; object-fit:cover; border-radius:50%; }
  .brand-text { display:flex; flex-direction:column; color:#5a4a3f; font-family:Georgia,"Times New Roman",serif; font-size:1.55rem; line-height:1.05; }
  .brand-text span:last-child { margin-top:4px; color:#657954; font-family:Arial,Helvetica,sans-serif; font-size:.72rem; letter-spacing:.16em; }
  .menu-toggle {
    display: none;
    align-items: center;
    gap: 8px;
    padding: 9px 12px;
    border: 1px solid #596243;
    border-radius: 6px;
    background: transparent;
    color: #3e4730;
    font: 700 .9rem Arial, Helvetica, sans-serif;
    cursor: pointer;
  }
  .menu-icon { font-size: 1.15rem; line-height: 1; }
  nav { display:flex; align-items:center; gap:clamp(16px,2.2vw,34px); flex-wrap:wrap; justify-content:flex-end; }
  nav a { color:#161713; text-decoration:none; font:600 .93rem Arial,Helvetica,sans-serif; white-space:nowrap; }
  nav a:hover, nav a[aria-current="page"] { color:#687347; }
  .brand:focus-visible,
  nav a:focus-visible,
  .menu-toggle:focus-visible {
    outline: 3px solid #a8b88f;
    outline-offset: 4px;
    border-radius: 5px;
  }

  nav .nav-cta {
    padding: 10px 15px;
    border: 2px solid #596243;
    border-radius: 6px;
    background: #596243;
    color: #fff;
    font-weight: 700;
  }

  nav .nav-cta:hover,
  nav .nav-cta[aria-current="page"] {
    background: #6b7551;
    border-color: #6b7551;
    color: #fff;
  }
  /* Navigation compacte sur téléphone et tablette. */
  @media (max-width: 900px) {
    .site-header {
      box-sizing: border-box;
      width: 100%;
      min-height: 0;
      padding: 12px clamp(14px, 4vw, 28px);
      display: flex;
      flex-direction: row;
      flex-wrap: wrap !important;
      align-items: center;
      justify-content: space-between;
      gap: 0 12px;
    }
    .brand { min-width: 0; flex: 0 1 auto; }
    .brand-logo { width: 52px; height: 52px; margin-right: 9px; }
    .brand-text { font-size: clamp(1.04rem, 3.4vw, 1.32rem); }
    .brand-text span:last-child { font-size: .62rem; letter-spacing: .1em; }
    .menu-toggle { display: inline-flex; flex: 0 0 auto; margin-left: auto; }
    nav {
      display: none !important;
      flex: 0 0 100% !important;
      width: 100% !important;
      max-width: 100%;
      box-sizing: border-box;
      margin-top: 12px;
      padding: 10px 0 2px;
      border-top: 1px solid #e6e2d9;
      flex-direction: column !important;
      align-items: stretch !important;
      justify-content: flex-start;
      gap: 2px;
    }
    nav.is-open { display: flex !important; }
    nav a {
      width: 100%;
      box-sizing: border-box;
      padding: 12px 10px;
      font-size: .93rem;
      line-height: 1.25;
      white-space: normal;
      text-align: left;
      overflow-wrap: anywhere;
      border-radius: 5px;
    }
    nav .nav-cta {
      width: 100%;
      box-sizing: border-box;
      text-align: center;
      padding: 12px 14px;
      margin-bottom: 4px;
    }
  }
  @media (max-width: 370px) {
    .site-header { padding-inline: 12px; }
    .brand-logo { width: 44px; height: 44px; }
    .brand-text { font-size: 1rem; }
    .brand-text span:last-child { font-size: .55rem; }
    .menu-toggle { padding: 8px 10px; }
  }
</style>

<style is:global>

  /* Règles globales ciblées : empêchent les styles des pages de placer
     le menu à droite du logo sur les petits écrans. */
  @media (max-width: 900px) {
    header.site-header {
      display: grid !important;
      grid-template-columns: minmax(0, 1fr) auto !important;
      align-items: center !important;
      width: 100% !important;
      max-width: 100% !important;
      box-sizing: border-box !important;
      gap: 0 10px !important;
      padding: 12px 16px !important;
    }
    header.site-header > a.brand {
      grid-column: 1 !important;
      grid-row: 1 !important;
      min-width: 0 !important;
    }
    header.site-header > button.menu-toggle {
      display: inline-flex !important;
      grid-column: 2 !important;
      grid-row: 1 !important;
      margin: 0 !important;
    }
    header.site-header > nav#main-navigation {
      display: none !important;
      grid-column: 1 / -1 !important;
      grid-row: 2 !important;
      width: 100% !important;
      min-width: 0 !important;
      max-width: 100% !important;
      box-sizing: border-box !important;
      margin: 12px 0 0 !important;
      padding: 10px 0 0 !important;
      border-top: 1px solid #e6e2d9 !important;
      flex-direction: column !important;
      align-items: stretch !important;
      justify-content: flex-start !important;
      flex-wrap: nowrap !important;
      overflow: visible !important;
      gap: 2px !important;
    }
    header.site-header > nav#main-navigation.is-open {
      display: flex !important;
    }
    header.site-header > nav#main-navigation > a {
      display: block !important;
      box-sizing: border-box !important;
      width: 100% !important;
      min-width: 0 !important;
      padding: 12px !important;
      margin: 0 !important;
      text-align: left !important;
      white-space: normal !important;
      overflow-wrap: anywhere !important;
    }
    header.site-header > nav#main-navigation > a.nav-cta {
      text-align: center !important;
    }
  }
  /* Titres plus aérés sur les grands écrans, sur toutes les pages publiques. */
  @media (min-width: 901px) {
    main h1 { line-height: 1.14 !important; }
    main h2 { line-height: 1.22 !important; }
  }
</style>
