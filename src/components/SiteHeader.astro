---
const nav = [
  { label: "Les malles", href: "/les-malles" },
  { label: "Louer une malle", href: "/louer-une-malle" },
  { label: "À propos", href: "/a-propos" },
  { label: "FAQ", href: "/faq" },
  { label: "Le blog", href: "/blog" },
  { label: "Me contacter", href: "/contact" },
];

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href) => pathname === href || (href === "/blog" && pathname === "/article-blog");
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Rencontres avec le vivant — Accueil">
    <svg class="brand-logo" viewBox="0 0 120 120" role="img" aria-hidden="true">
      <path class="brand-circle" d="M38 101C20 86 15 61 23 39C32 17 54 7 80 10" />
      <path class="brand-circle" d="M100 34C109 56 104 81 87 96C73 108 53 110 38 101" />
      <circle class="brand-dot" cx="99" cy="20" r="7" />

      <path class="brand-leaf-large" d="M38 101C24 84 24 58 35 35C38 53 49 65 63 75C73 82 78 91 79 98C64 104 50 105 38 101Z" />
      <path class="brand-leaf-vein" d="M39 99C47 85 53 73 57 60" />
      <path class="brand-leaf-vein soft" d="M47 86C40 81 36 75 33 68" />
      <path class="brand-leaf-vein soft" d="M53 76C47 70 43 63 40 56" />

      <path class="brand-stem" d="M76 99C76 80 76 61 73 43" />
      <path class="brand-leaf" d="M73 48C62 39 63 25 72 15C83 27 83 40 73 48Z" />
      <path class="brand-leaf" d="M76 70C84 58 96 56 104 60C98 73 87 78 76 70Z" />
      <path class="brand-leaf-vein small" d="M73 45L72 23" />
      <path class="brand-leaf-vein small" d="M78 68L98 61" />
    </svg>

    <span class="brand-text">
      <span>Rencontres</span>
      <span>avec le vivant</span>
    </span>
  </a>

  <nav aria-label="Navigation principale">
    {nav.map((item) => (
      <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
        {item.label}
      </a>
    ))}
  </nav>
</header>

<style>
  .site-header {
    min-height: 94px;
    padding: 15px 5.5%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    background: #fff;
  }
  .brand { display:flex; align-items:center; color:#29271f; text-decoration:none; flex:0 0 auto; }
  .brand-logo { width:66px; height:66px; flex:0 0 auto; margin-right:11px; overflow:visible; }
  .brand-circle { fill:none; stroke:#5a4a3f; stroke-width:3.2; stroke-linecap:round; }
  .brand-dot { fill:#d69b3e; }
  .brand-leaf-large { fill:#7f8d60; }
  .brand-leaf { fill:#768456; }
  .brand-stem { fill:none; stroke:#5f6d42; stroke-width:2.5; stroke-linecap:round; }
  .brand-leaf-vein { fill:none; stroke:#66734c; stroke-width:2; stroke-linecap:round; opacity:.8; }
  .brand-leaf-vein.soft { stroke:#aab38e; stroke-width:1.5; opacity:.75; }
  .brand-leaf-vein.small { stroke:#5f6d42; stroke-width:1.6; opacity:.9; }
  .brand-text { display:flex; flex-direction:column; color:#5a4a3f; font-family:Georgia,"Times New Roman",serif; font-size:1.55rem; line-height:1.05; }
  .brand-text span:last-child { margin-top:4px; color:#657954; font-family:Arial,Helvetica,sans-serif; font-size:.72rem; letter-spacing:.16em; }
  nav { display:flex; align-items:center; gap:clamp(16px,2.2vw,34px); flex-wrap:wrap; justify-content:flex-end; }
  nav a { color:#161713; text-decoration:none; font:600 .93rem Arial,Helvetica,sans-serif; white-space:nowrap; }
  nav a:hover, nav a[aria-current="page"] { color:#687347; }
  @media (max-width:900px) {
    .site-header { flex-direction:column; align-items:flex-start; }
    nav { justify-content:flex-start; }
  }
  @media (max-width:650px) {
    .site-header { padding:16px 22px; }
    .brand-logo { width:56px; height:56px; margin-right:9px; }
    .brand-text { font-size:1.35rem; }
    nav { gap:12px 18px; }
    nav a { font-size:.86rem; }
  }
</style>
