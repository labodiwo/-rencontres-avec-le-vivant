{
  "name": "rencontres-avec-le-vivant",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-01",
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFLbq9U43C7dk5EU"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/blog/*",
      "/acces-pedagogique"
    ]
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AVAILABILITY",
        "class_name": "AvailabilityStore"
      },
      {
        "name": "BLOG",
        "class_name": "BlogStore"
      },
      {
        "name": "RESERVATIONS",
        "class_name": "ReservationsStore"
      },
      {
        "name": "SECURITY",
        "class_name": "SecurityStore"
      }
    ]
  },
  "exports": {
    "AvailabilityStore": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "BlogStore": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "ReservationsStore": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "SecurityStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "previews": {
    "vars": {
      "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
      "TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA",
      "PREVIEW_MODE": "true"
    },
    "send_email": [
      {
        "name": "EMAIL"
      }
    ],
    "durable_objects": {
      "bindings": [
        {
          "name": "AVAILABILITY",
          "class_name": "AvailabilityStore"
        },
        {
          "name": "BLOG",
          "class_name": "BlogStore"
        },
        {
          "name": "RESERVATIONS",
          "class_name": "ReservationsStore"
        },
        {
          "name": "SECURITY",
          "class_name": "SecurityStore"
        }
      ]
    }
  },
  "secrets": {
    "required": [
      "BOOKING_TO",
      "TURNSTILE_SECRET_KEY",
      "ADMIN_KEY"
    ]
  }
}
