{
  "name": "rencontres-avec-le-vivant",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-01",
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFLbq9U43C7dk5EU"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AVAILABILITY",
        "class_name": "AvailabilityStore"
      },
      {
        "name": "BLOG",
        "class_name": "BlogStore"
      },
      {
        "name": "RESERVATIONS",
        "class_name": "ReservationsStore"
      }
    ]
  },
  "exports": {
    "AvailabilityStore": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "BlogStore": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "ReservationsStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "secrets": {
    "required": [
      "BOOKING_TO",
      "TURNSTILE_SECRET_KEY",
      "ADMIN_KEY"
    ]
  }
}
